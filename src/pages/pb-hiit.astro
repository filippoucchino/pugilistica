---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DefinitionGrid from "../components/DefinitionGrid.astro";
import TargetCard from "../components/TargetCard.astro";
import BenefitItem from "../components/BenefitItem.astro";
import LessonStep from "../components/LessonStep.astro";
import WhyUsCard from "../components/WhyUsCard.astro";
import InfoRow from "../components/InfoRow.astro";
import PricingCard from "../components/PricingCard.astro";
import Gallery from "../components/Gallery.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import LocalSection from "../components/LocalSection.astro";
import CtaBlock from "../components/CtaBlock.astro";
import CoachBlock from "../components/CoachBlock.astro";
import CourseScheduleMini from "../components/CourseScheduleMini.astro";
import { trustItems, localDetails, zones, siteInfo, buildWhatsappHref } from "@/data/shared";
import { buildPageSchema, buildGymRef, buildWebPage, buildBreadcrumb, buildFaqPage, buildCourse, buildVideo } from "@/data/schema";

// Foto coach: importata come ES module così Astro la ottimizza in build (WebP, dimensioni esplicite).
import stefanoPhoto from "../assets/images/bio/stefano-rizzo.jpg";

// Foto gallery: importate come ES module per ottimizzazione automatica (WebP, width/height, compressione).
import galCircuito from "../assets/images/pb-hiit/circuito-gruppo-pb-hiit-pugilistica-brianza.jpg";
import galColpitori from "../assets/images/pb-hiit/lavoro-colpitori-boxe-pb-hiit-pugilistica-brianza.jpg";
import galSwing from "../assets/images/pb-hiit/kettlebell-swing-circuito-pb-hiit-pugilistica-brianza.jpg";
import galSacco from "../assets/images/pb-hiit/sacco-pesante-boxe-pb-hiit-pugilistica-brianza.jpg";
import galKettlebell from "../assets/images/pb-hiit/esercizio-kettlebell-pb-hiit-pugilistica-brianza.jpg";

// Unica CTA della pagina: WhatsApp al coach con messaggio precompilato specifico per il corso.
const whatsappHref = buildWhatsappHref(
  "Ciao, vorrei prenotare una prova gratuita per il corso PB Hiit."
);

/* — Dati pagina — */

const definitionItems = [
  { title: "Intervalli ad alta intensità", description: "Fasi di lavoro brevi e intense alternate a recuperi controllati. Il formato a intervalli è tra i più efficaci per il consumo calorico e il miglioramento cardiovascolare." },
  { title: "Circuiti dinamici", description: "Ogni lezione propone circuiti sempre diversi che combinano esercizi a corpo libero, con attrezzi e lavoro metabolico. Nessuna sessione è uguale alla precedente." },
  { title: "Lavoro al sacco", description: "Nei circuiti entra anche il lavoro al sacco pesante: combinazioni di colpi ad alta intensità per sfogarsi, unire cardio e boxe, dare al PB Hiit quel tocco di pugilato che lo rende unico." },
  { title: "Adatto a ogni livello", description: "Il coach adatta intensità, tempi e varianti degli esercizi. Puoi iniziare da zero o usare il PB Hiit come complemento al tuo allenamento abituale." },
];

const targets = [
  { icon: '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>', title: "Chi vuole rimettersi in forma", description: "Hai smesso di allenarti o non hai mai iniziato? Il PB Hiit è un percorso concreto per riprendere il controllo della tua condizione fisica, senza pressione." },
  { icon: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>', title: "Chi vuole dimagrire", description: "L'allenamento a intervalli è tra i più efficaci per bruciare calorie, anche dopo la sessione. Combinato con costanza, porta a risultati visibili." },
  { icon: '<path d="M18 20V10M12 20V4M6 20v-6"/>', title: "Chi cerca allenamenti dinamici", description: "Circuiti sempre diversi, ritmi sostenuti e varietà di esercizi. Se ti annoi con la solita routine, il PB Hiit è la risposta giusta." },
  { icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>', title: "Chi vuole più energia e tono", description: "Più energia nella vita quotidiana, un corpo più tonico e una sensazione di benessere generale. Questo è quello che il PB Hiit costruisce sessione dopo sessione." },
];

const benefits = [
  "<strong>Aumenta</strong> il consumo calorico durante e dopo ogni sessione di allenamento",
  "<strong>Migliora</strong> il tono muscolare su tutto il corpo con esercizi funzionali completi",
  "<strong>Sviluppa</strong> resistenza cardiovascolare e capacità di gestire lo sforzo",
  "<strong>Costruisce</strong> velocità e reattività attraverso fasi di lavoro esplosive",
  "<strong>Favorisce</strong> il benessere generale, riducendo stress e aumentando l'energia quotidiana",
  "<strong>Aiuta</strong> a creare costanza con un formato breve, intenso e mai ripetitivo",
];

const steps = [
  { title: "Attivazione", description: "Riscaldamento progressivo con mobilità articolare e attivazione muscolare. Il corpo si prepara allo sforzo con esercizi dinamici che aumentano gradualmente frequenza cardiaca e prontezza." },
  { title: "Circuiti a intervalli", description: "Il cuore della lezione: rotazione su stazioni di esercizi a corpo libero, con attrezzi e lavoro metabolico. Ogni circuito alterna fasi di lavoro e fasi di recupero attivo." },
  { title: "Fasi ad alta intensità", description: "Blocchi di lavoro esplosivo per spingere al massimo frequenza cardiaca e sforzo muscolare. Il coach adatta tempi e varianti in base al livello di ciascun partecipante." },
  { title: "Recuperi attivi", description: "Tra un blocco e l'altro, fasi di recupero controllato che permettono di riprendere senza fermarsi completamente. Il ritmo resta alto, ma gestibile." },
  { title: "Chiusura e defaticamento", description: "Ritorno alla calma con stretching, respirazione e feedback del coach. La chiusura è pensata per favorire il recupero muscolare e preparare il corpo alla sessione successiva." },
];

const whyUs = [
  { icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>', title: "Ogni minuto conta", description: "Il formato HIIT è pensato per massimizzare ogni singolo minuto di allenamento. Sessioni brevi ma dense, per chi ha poco tempo e vuole risultati reali." },
  { icon: '<path d="M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z"/>', title: "Sfogati al sacco", description: "Nei circuiti entra il lavoro al sacco: colpi, combinazioni e intensità reale. Alleni fisico e mente insieme, e scarichi davvero la tensione della giornata." },
  { icon: '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>', title: "Fuori dalla comfort zone", description: "Ogni sessione ti spinge un po' più in là. Il coach alza l'asticella quando sei pronto, senza pressione ma senza sconti: è così che si cresce davvero." },
  { icon: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>', title: "Community, non solo corso", description: "Qui non sei un numero. Il gruppo PB Hiit è una famiglia: ci si motiva a vicenda, si suda insieme, si cresce insieme. L'ambiente fa la differenza." },
  { icon: '<polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/>', title: "Mai la stessa sessione", description: "Circuiti sempre diversi, esercizi nuovi, varianti continue. Il coach progetta ogni lezione da zero, così non ti annoi mai e il corpo è sempre stimolato." },
  { icon: '<path d="M5 3l14 9-14 9V3z"/>', title: "Prova gratuita senza impegno", description: "Vieni, fai una sessione vera con il gruppo e decidi con calma. Nessun vincolo, nessun pagamento anticipato." },
];

const infoRows = [
  { icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>', text: "<strong>Quando si svolge</strong>Il corso PB Hiit si tiene il lunedì e il mercoledì, dalle 19:00 alle 20:00." },
  { icon: '<path d="M5 3l14 9-14 9V3z"/>', text: "<strong>Prova gratuita</strong>La prima lezione è gratuita e senza impegno. Vieni, allenati e decidi con calma." },
  { icon: '<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>', text: "<strong>Come iscriversi</strong>Contatto diretto: scrivici su WhatsApp o passa in palestra. L'iscrizione è semplice e veloce." },
  { icon: '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>', text: "<strong>Cosa portare</strong>Abbigliamento sportivo comodo e scarpe da ginnastica. Tutta l'attrezzatura necessaria è disponibile in palestra." },
];

const faqItems = [
  { question: "PB Hiit è adatto a chi parte da zero?", answer: "Sì. L'allenamento è strutturato per adattarsi a ogni livello. Il coach modifica intensità, tempi e varianti degli esercizi in base alla tua condizione attuale. La maggior parte dei nostri iscritti ha iniziato senza esperienza specifica." },
  { question: "Il PB Hiit aiuta a dimagrire?", answer: "Sì. L'allenamento a intervalli ad alta intensità è tra i più efficaci per il consumo calorico, anche nelle ore successive alla sessione. Combinato con costanza e alimentazione equilibrata, è un percorso concreto per la perdita di peso." },
  { question: "Quanto dura una lezione di PB Hiit?", answer: "Ogni lezione dura circa 45-50 minuti, incluse attivazione iniziale e defaticamento finale. È un formato intenso ma gestibile, pensato per ottenere il massimo in poco tempo." },
  { question: "Quante volte a settimana dovrei fare PB Hiit?", answer: "Per ottenere risultati visibili consigliamo 2-3 sessioni a settimana. Il coach ti aiuta a trovare la frequenza giusta in base ai tuoi obiettivi e al tuo livello di partenza." },
  { question: "Posso provare il corso PB Hiit gratuitamente?", answer: "Certo. La prima lezione è gratuita e senza impegno. Vieni in palestra a Barlassina, allenati con noi e decidi con calma. Puoi prenotare scrivendoci su WhatsApp o passando direttamente." },
  { question: "Cosa devo portare alla prima lezione?", answer: "Abbigliamento sportivo comodo e scarpe da ginnastica. Tutta l'attrezzatura necessaria per la lezione è disponibile in palestra. Abbiamo spogliatoi e docce." },
  { question: "In cosa si differenzia il PB Hiit dal corso Hyrox?", answer: "Il PB Hiit è un allenamento a intervalli ad alta intensità pensato per fitness, tono e condizione generale. Il corso Hyrox è orientato alla preparazione ibrida per la gara Hyrox, con focus su resistenza, corsa e stazioni funzionali. Entrambi sono intensi, ma con obiettivi e struttura diversi." },
];

const pageSchema = buildPageSchema(
  buildGymRef(),
  buildWebPage(
    "/pb-hiit/",
    "PB Hiit a Barlassina | Pugilistica Brianza",
    "Scopri il corso PB Hiit a Barlassina: per chi è adatto, come si svolge, benefici, prova gratuita e contatti di Pugilistica Brianza.",
  ),
  buildCourse({
    name: "Corso PB Hiit",
    slug: "pb-hiit",
    description: "Allenamento intenso e dinamico a intervalli per fitness, tono e condizione. Circuiti sempre diversi con lavoro al sacco, esercizi funzionali e metabolici.",
    price: "50",
    coaches: [{ name: "Stefano Rizzo", slug: "stefano-rizzo" }],
  }),
  buildVideo(
    {
      name: "Allenamento PB Hiit alla Pugilistica Brianza di Barlassina",
      description: "Video di un allenamento PB Hiit alla Pugilistica Brianza di Barlassina: circuiti a intervalli ad alta intensità con lavoro al sacco e esercizi funzionali.",
      mp4Path: "/videos/corso-pb-hiit-pugilistica-brianza-barlassina.mp4",
      posterPath: "/videos/corso-pb-hiit-pugilistica-brianza-barlassina.jpg",
      uploadDate: "2026-04-14",
    },
    "pb-hiit",
  ),
  buildFaqPage(faqItems, "pb-hiit"),
  buildBreadcrumb([{ name: "PB Hiit", href: "/pb-hiit/" }]),
);
---

<BaseLayout
  title="PB Hiit a Barlassina | Pugilistica Brianza"
  description="Scopri il corso PB Hiit a Barlassina: per chi è adatto, come si svolge, benefici, prova gratuita e contatti di Pugilistica Brianza."
  schema={pageSchema}
>
  <!-- 1. HERO -->
  <Hero
    topline="Corso PB Hiit — Pugilistica Brianza"
    subtitle="Allenati con un percorso intenso e dinamico per fitness, tono e condizione, in una palestra con ambiente familiare, coach qualificati e prova gratuita."
    watermark="HIIT"
    ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
  >
    Corso <span class="text-brand">PB Hiit</span><br />a Barlassina in Brianza
  </Hero>

  <!-- TRUST BAR -->
  <div class="bg-surface border-b border-pb-border-default">
    <div class="pb-container">
      <TrustBar items={trustItems} />
    </div>
  </div>

  <!-- 2. CHE COS'È PB HIIT -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il corso">
        Che cos'è <span class="text-brand">PB Hiit?</span>
      </SectionHeading>
      <DefinitionGrid
        introText="PB Hiit sta per Pugilistica Brianza HIIT: è l'HIIT rivisitato dalla nostra palestra, nato per chi cerca un allenamento intenso che unisce cardio e boxe — per sudare, sfogarsi e lavorare su tutto il corpo. Circuiti dinamici ad alta intensità, fasi di lavoro esplosivo, recuperi attivi e il lavoro al sacco tipico della nostra identità pugilistica."
        items={definitionItems}
        video={{
          mp4: "/videos/corso-pb-hiit-pugilistica-brianza-barlassina.mp4",
          webm: "/videos/corso-pb-hiit-pugilistica-brianza-barlassina.webm",
          poster: "/videos/corso-pb-hiit-pugilistica-brianza-barlassina.jpg",
          title: "Allenamento PB Hiit alla Pugilistica Brianza di Barlassina",
        }}
      />
    </div>
  </section>

  <!-- 3. PER CHI È ADATTO -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Per chi"
        description="Un allenamento pensato per chi vuole risultati concreti, in un formato intenso ma accessibile a tutti i livelli."
      >
        Per chi è adatto <span class="text-brand">PB Hiit?</span>
      </SectionHeading>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {targets.map((t) => (
          <TargetCard icon={t.icon} title={t.title} description={t.description} />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. BENEFICI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Benefici"
        description="Un allenamento completo che lavora su più fronti, dal consumo calorico alla resistenza, dal tono muscolare al benessere mentale."
      >
        I benefici di <span class="text-brand">PB Hiit</span>
      </SectionHeading>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {benefits.map((b) => <BenefitItem text={b} />)}
      </div>
    </div>
  </section>

  <!-- 5. COME SI SVOLGE UNA LEZIONE -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="La lezione"
        description="Ogni lezione dura circa 45-50 minuti ed è strutturata per massimizzare il lavoro in poco tempo, con progressione e adattamento al livello del gruppo."
      >
        Come si svolge una lezione di <span class="text-brand">PB Hiit?</span>
      </SectionHeading>
      <div class="flex flex-col" style="counter-reset: step;">
        {steps.map((s) => <LessonStep title={s.title} description={s.description} />)}
      </div>
    </div>
  </section>

  <!-- IL COACH -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il coach">
        Chi ti guida nelle sessioni di <span class="text-brand">PB Hiit</span>
      </SectionHeading>
      <CoachBlock
        name="Stefano Rizzo"
        role="Co-fondatore e Head Coach"
        bio="Ex pugile agonista e certificato FIPE. Stefano costruisce ogni sessione di PB Hiit unendo l'alta intensità alla componente boxe tipica della palestra: non solo cardio, ma tecnica, ritmo e scarico emotivo guidati da chi ha vissuto il ring da atleta."
        tags={["Ex pugile agonista", "Certificato FIPE", "Alta intensità", "Lavoro al sacco"]}
        photo={stefanoPhoto}
        photoAlt="Stefano Rizzo, co-fondatore e head coach di Pugilistica Brianza"
      />
    </div>
  </section>

  <!-- CTA INTERMEDIA -->
  <div class="pb-section--alt">
    <CtaBlock
      description="La prova è gratuita e senza impegno. Vieni a Barlassina, allenati con noi e decidi con calma."
      ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
    >
      Vuoi provare una <span class="text-brand">lezione?</span>
    </CtaBlock>
  </div>

  <!-- 6. PERCHÉ SCEGLIERE NOI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Perché noi"
        description="Pugilistica Brianza non è una palestra generica. È un'ASD con un'identità chiara, dove l'allenamento è serio e l'ambiente è familiare."
      >
        Perché allenarti <span class="text-brand">con noi</span>
      </SectionHeading>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {whyUs.map((w) => (
          <WhyUsCard icon={w.icon} title={w.title} description={w.description} />
        ))}
      </div>
    </div>
  </section>

  <!-- 7. ORARI, PROVA E ISCRIZIONE -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="Info pratiche">
        Orari, prova e <span class="text-brand">iscrizione</span>
      </SectionHeading>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-10 items-start">
        <div>
          {infoRows.map((r) => <InfoRow icon={r.icon} text={r.text} />)}
        </div>
        <PricingCard
          title="Abbonamento mensile"
          price="€50"
          note="+ Tesseramento annuale €20 (obbligatorio)"
          features={[
            "Accesso illimitato al corso PB Hiit",
            "Ingresso singolo: €15 (necessaria visita medica)",
            "Formula Open (tutti i corsi): €90/mese",
            "Prima lezione gratuita",
          ]}
          ctaLabel="Prenota su WhatsApp"
          ctaHref={whatsappHref}
        />
      </div>
      <CourseScheduleMini
        tags={["pb-hiit"]}
        caption="Orari settimanali del corso PB Hiit alla Pugilistica Brianza"
      />
    </div>
  </section>

  <!-- 8. GALLERY -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Gallery">
        Guarda <span class="text-brand">l'allenamento</span>
      </SectionHeading>
      <Gallery images={[
        { src: galCircuito, alt: "Circuito di gruppo PB Hiit alla Pugilistica Brianza: allieve su stazioni diverse con bilancieri e corpo libero" },
        { src: galColpitori, alt: "Lavoro ai colpitori con guantoni durante una sessione PB Hiit alla Pugilistica Brianza" },
        { src: galSwing, alt: "Kettlebell swing e stacco con bilanciere nel circuito PB Hiit della Pugilistica Brianza" },
        { src: galSacco, alt: "Allenamento al sacco pesante durante il corso PB Hiit alla Pugilistica Brianza di Barlassina" },
        { src: galKettlebell, alt: "Esercizio con kettlebell davanti allo specchio durante il PB Hiit alla Pugilistica Brianza" },
      ]} />
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="FAQ">
        Domande frequenti su <span class="text-brand">PB Hiit</span>
      </SectionHeading>
      <FaqAccordion items={faqItems} defaultOpen={0} />
    </div>
  </section>

  <!-- 10. LOCAL -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Dove siamo">
        Allenati a <span class="text-brand">Barlassina,</span> in Brianza
      </SectionHeading>
      <LocalSection
        address={`${siteInfo.address}<br>${siteInfo.cap} ${siteInfo.city} (${siteInfo.province})`}
        addressLabel={siteInfo.name}
        zones={zones}
        details={localDetails}
        mapEmbedUrl={siteInfo.mapEmbedUrl}
        mapExternalUrl={siteInfo.mapExternalUrl}
        mapPreviewSrc={siteInfo.mapPreviewSrc}
        mapLabel={siteInfo.shortName}
      />
      <div class="mt-8">
        <a href="/contatti/" class="pb-btn-text">Vai alla pagina Contatti →</a>
      </div>
    </div>
  </section>

  <!-- 11. CTA FINALE -->
  <div class="pb-section--alt">
    <CtaBlock
      description="Vieni a Barlassina e prova il corso PB Hiit senza impegno. Coach qualificati, ambiente familiare e accesso semplice."
      ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
    >
      Prenota la tua <span class="text-brand">prova gratuita</span>
    </CtaBlock>
  </div>
</BaseLayout>
