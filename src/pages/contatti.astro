---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ContactCard from "../components/ContactCard.astro";
import FormField from "../components/FormField.astro";
import LocalSection from "../components/LocalSection.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { localDetails, zonesInfo, siteInfo, hours } from "@/data/shared";
import { buildPageSchema, buildGym, buildWebPage, buildBreadcrumb } from "@/data/schema";

const pageSchema = buildPageSchema(
  buildGym(),
  buildWebPage(
    "/contatti/",
    "Contatti | Pugilistica Brianza",
    "Contatta Pugilistica Brianza a Barlassina: indirizzo, telefono, email, orari e mappa.",
    "ContactPage",
  ),
  buildBreadcrumb([{ name: "Contatti", href: "/contatti/" }]),
);
---

<BaseLayout
  title="Contatti | Pugilistica Brianza a Barlassina (MB)"
  description="Contatta Pugilistica Brianza a Barlassina: indirizzo, telefono, email, orari e mappa. Via Giovanni Segantini 29, facilmente raggiungibile da tutta la Brianza."
  schema={pageSchema}
>
  <!-- HERO -->
  <Hero
    topline="Dove trovarci"
    subtitle="La Pugilistica Brianza si trova in Via Giovanni Segantini 29 a Barlassina (MB), nel cuore della Brianza. Palestra di pugilato, Hyrox e PB Hiit facilmente raggiungibile da Cogliate, Seveso, Lissone, Seregno, Desio, Meda, Cesano Maderno e Muggiò. Parcheggio gratuito in zona, spogliatoi e docce interne."
    watermark="CONTATTI"
  >
    Contatti Pugilistica <span class="text-brand">Brianza</span> a Barlassina
  </Hero>

  <!-- CONTATTI PRINCIPALI -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Contatti diretti"
        description="Il modo più rapido per iniziare è chiamarci al telefono o passare direttamente in palestra a Barlassina. Rispondiamo dal lunedì al sabato negli orari di apertura."
      >
        Chiamaci, scrivici <span class="text-brand">o vieni</span> in palestra
      </SectionHeading>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <ContactCard
          icon='<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>'
          label="Telefono"
          value={siteInfo.phone}
          href={siteInfo.phoneHref}
          subtitle="Chiamaci per informazioni sui corsi di pugilato, Hyrox e PB Hiit, per prenotare una prova gratuita o per qualsiasi domanda. Rispondiamo dal lunedì al sabato negli orari di apertura della palestra a Barlassina."
        />
        <ContactCard
          icon='<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>'
          label="Email"
          value={siteInfo.email}
          href={`mailto:${siteInfo.email}`}
          subtitle="Scrivici per qualsiasi informazione. Per richieste urgenti preferisci il telefono o WhatsApp."
        />
        <ContactCard
          icon='<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5" fill="none"/>'
          label="Indirizzo"
          value={siteInfo.address}
          subtitle={`${siteInfo.cap} ${siteInfo.city} (${siteInfo.province}), Brianza. Parcheggio gratuito nelle immediate vicinanze, in una zona residenziale tranquilla.`}
        />
      </div>
    </div>
  </section>

  <!-- FORM CONTATTI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Scrivici"
        description="Compila il form qui sotto con il tuo messaggio: il coach ti risponderà via email entro 24 ore nei giorni feriali. Per richieste urgenti, preferisci il telefono."
      >
        Mandaci un <span class="text-brand">messaggio</span>
      </SectionHeading>
      <div class="max-w-narrow">
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="p-card-pad-lg border border-pb-border-default rounded-md bg-surface-card flex flex-col gap-5"
        >
          {/* Campi hidden: configurazione Web3Forms (access_key pubblica per design) */}
          <input type="hidden" name="access_key" value="d4329a62-147f-46cc-8e2b-2c91d0873de1" />
          <input type="hidden" name="subject" value="Nuovo messaggio dal sito Pugilistica Brianza" />
          <input type="hidden" name="from_name" value="Sito Pugilistica Brianza" />
          {/* Honeypot: se un bot compila questo campo nascosto, Web3Forms scarta il messaggio */}
          <input
            type="checkbox"
            name="botcheck"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <FormField label="Nome" name="name" type="text" placeholder="Come ti chiami?" required />
          <FormField label="Email" name="email" type="email" placeholder="nome@esempio.it" required />
          <FormField
            label="Messaggio"
            name="message"
            type="textarea"
            placeholder="Scrivici la tua richiesta..."
            required
          />

          <button
            type="submit"
            id="contact-submit"
            class="pb-btn-primary inline-block self-start"
          >
            Invia messaggio
          </button>

          {/* Messaggio di errore inline (nascosto di default) */}
          <p id="contact-error" class="hidden text-sm text-brand" role="alert"></p>
        </form>

        {/* Box di successo: sostituisce il form dopo l'invio */}
        <div
          id="contact-success"
          class="hidden p-card-pad-lg border border-brand/40 bg-brand/10 rounded-md text-center"
        >
          <p class="text-display-sm font-display text-white mb-3">Grazie!</p>
          <p class="text-pb-text-secondary">
            Il tuo messaggio è stato inviato alla Pugilistica Brianza. Il coach
            ti risponderà via email entro 24 ore nei giorni feriali.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- MAPPA + INFO -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Dove siamo"
        description="La sede della Pugilistica Brianza è in Via Giovanni Segantini 29 a Barlassina (MB), in una zona residenziale tranquilla e comoda da raggiungere in auto dalle vicine Cogliate, Seveso, Seregno, Lissone e Meda."
      >
        Raggiungi la <span class="text-brand">palestra</span> a Barlassina
      </SectionHeading>
      <LocalSection
        address={`${siteInfo.address}<br>${siteInfo.cap} ${siteInfo.city} (${siteInfo.province})`}
        addressLabel={siteInfo.name}
        zonesInfo={zonesInfo}
        details={localDetails}
        mapEmbedUrl={siteInfo.mapEmbedUrl}
        mapExternalUrl={siteInfo.mapExternalUrl}
        mapDirectionsUrl={siteInfo.mapDirectionsUrl}
        mapPreviewSrc={siteInfo.mapPreviewSrc}
        mapLabel={siteInfo.shortName}
      />
    </div>
  </section>

  <!-- SOCIAL -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Seguici"
        description="Sui nostri canali social trovi foto e video degli allenamenti, storie dalla palestra di Barlassina, highlights dei corsi di pugilato, Hyrox e PB Hiit e momenti del gruppo. Guarda come si lavora dal vivo prima di venire a trovarci."
      >
        Seguici sui <span class="text-brand">social</span>
      </SectionHeading>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Instagram */}
        <a
          href={siteInfo.social.instagram}
          target="_blank"
          rel="noopener"
          class="group p-card-pad-lg border border-pb-border-default rounded-md bg-surface-card flex items-center gap-5 transition-all duration-base ease-default hover:border-brand hover:bg-[rgba(196,30,30,0.05)]"
          aria-label="Apri profilo Instagram di Pugilistica Brianza in una nuova scheda"
        >
          <span class="shrink-0 w-14 h-14 rounded-md border border-pb-border-default flex items-center justify-center bg-surface-base transition-colors duration-base group-hover:border-brand group-hover:bg-brand/10">
            <svg class="w-7 h-7 fill-none stroke-pb-text-primary transition-colors duration-base group-hover:stroke-brand" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" />
              <circle cx="17.5" cy="6.5" r=".5" fill="currentColor" />
            </svg>
          </span>
          <div class="flex-1 min-w-0">
            <div class="text-xxs font-semibold tracking-widest uppercase text-pb-text-faint mb-1">Instagram</div>
            <div class="text-lg font-semibold text-pb-text-primary truncate">@pugilisticabrianza</div>
            <div class="text-sm text-pb-text-tertiary mt-1 flex items-center gap-1">
              Seguici
              <span class="transition-transform duration-base group-hover:translate-x-1">→</span>
            </div>
          </div>
        </a>

        {/* Facebook */}
        <a
          href={siteInfo.social.facebook}
          target="_blank"
          rel="noopener"
          class="group p-card-pad-lg border border-pb-border-default rounded-md bg-surface-card flex items-center gap-5 transition-all duration-base ease-default hover:border-brand hover:bg-[rgba(196,30,30,0.05)]"
          aria-label="Apri pagina Facebook di Pugilistica Brianza in una nuova scheda"
        >
          <span class="shrink-0 w-14 h-14 rounded-md border border-pb-border-default flex items-center justify-center bg-surface-base transition-colors duration-base group-hover:border-brand group-hover:bg-brand/10">
            <svg class="w-7 h-7 fill-pb-text-primary transition-colors duration-base group-hover:fill-brand" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
          </span>
          <div class="flex-1 min-w-0">
            <div class="text-xxs font-semibold tracking-widest uppercase text-pb-text-faint mb-1">Facebook</div>
            <div class="text-lg font-semibold text-pb-text-primary truncate">Pugilistica Brianza</div>
            <div class="text-sm text-pb-text-tertiary mt-1 flex items-center gap-1">
              Seguici
              <span class="transition-transform duration-base group-hover:translate-x-1">→</span>
            </div>
          </div>
        </a>

        {/* YouTube */}
        <a
          href={siteInfo.social.youtube}
          target="_blank"
          rel="noopener"
          class="group p-card-pad-lg border border-pb-border-default rounded-md bg-surface-card flex items-center gap-5 transition-all duration-base ease-default hover:border-brand hover:bg-[rgba(196,30,30,0.05)]"
          aria-label="Apri canale YouTube di Pugilistica Brianza in una nuova scheda"
        >
          <span class="shrink-0 w-14 h-14 rounded-md border border-pb-border-default flex items-center justify-center bg-surface-base transition-colors duration-base group-hover:border-brand group-hover:bg-brand/10">
            <svg class="w-7 h-7 fill-none stroke-pb-text-primary transition-colors duration-base group-hover:stroke-brand" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="4"/>
              <polygon points="10 8 16 12 10 16" class="fill-pb-text-primary group-hover:fill-brand transition-colors duration-base" stroke="none"/>
            </svg>
          </span>
          <div class="flex-1 min-w-0">
            <div class="text-xxs font-semibold tracking-widest uppercase text-pb-text-faint mb-1">YouTube</div>
            <div class="text-lg font-semibold text-pb-text-primary truncate">@pugilisticabrianza</div>
            <div class="text-sm text-pb-text-tertiary mt-1 flex items-center gap-1">
              Seguici
              <span class="transition-transform duration-base group-hover:translate-x-1">→</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ORARI -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Orari"
        description="La Pugilistica Brianza è aperta dal lunedì al venerdì dalle 08:00 alle 11:00, dalle 12:30 alle 13:30 e dalle 17:00 alle 21:00. Il sabato dalle 10:00 alle 12:00. Domenica la palestra resta chiusa. I corsi si svolgono in fasce al mattino, in pausa pranzo e la sera durante la settimana."
      >
        Orari di <span class="text-brand">apertura</span>
      </SectionHeading>
      <div class="max-w-[560px]">
        <div class="flex flex-col">
          {hours.map((h) => (
            <div class:list={[
              "flex justify-between py-3 border-b border-pb-border-default",
              "closed" in h && h.closed ? "text-pb-text-muted" : "",
            ]}>
              <span class="text-base font-medium text-pb-text-secondary">{h.day}</span>
              <span class:list={["text-base", "closed" in h && h.closed ? "text-pb-text-muted" : "text-pb-text-primary font-semibold"]}>
                {h.time}
              </span>
            </div>
          ))}
        </div>
        <p class="mt-5 text-sm text-pb-text-muted leading-normal">
          Gli orari possono subire variazioni durante i periodi
          festivi (Natale, Pasqua, ponti estivi) e nelle chiusure stagionali. Per conferme,
          chiamaci direttamente o scrivici via email.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA FINALE -->
  <div>
    <CtaBlock
      description="La prima lezione è gratuita e senza impegno. Chiamaci, scrivici o passa direttamente in palestra."
      ctaPrimary={{ label: "Prenota la prova gratuita", href: "/prova-gratuita/" }}
      ctaSecondary={{ label: "Chiamaci", href: siteInfo.phoneHref }}
    >
      Vieni a <span class="text-brand">trovarci</span>
    </CtaBlock>
  </div>

  {/* Script invio form Web3Forms: intercetta il submit, invia via fetch, mostra messaggio inline */}
  <script src="/js/contact-form.js" defer></script>
</BaseLayout>