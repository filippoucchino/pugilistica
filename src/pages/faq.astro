---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { buildWhatsappHref } from "@/data/shared";
import { buildPageSchema, buildGymRef, buildWebPage, buildBreadcrumb, buildFaqPage } from "@/data/schema";

const whatsappHref = buildWhatsappHref(
  "Ciao, ho una domanda sulle attività di Pugilistica Brianza."
);

const faqGeneral = [
  {
    question: "Posso iniziare anche se sono principiante?",
    answer: "Sì, puoi iniziare il corso di pugilato alla Pugilistica Brianza anche se sei principiante assoluto. La maggior parte degli iscritti ha iniziato da zero, senza alcuna esperienza pregressa. Il corso è strutturato per accogliere tutti i livelli, dai principianti assoluti a chi ha già esperienza sul ring, con una progressione tecnica adattata a ciascuno.",
  },
  {
    question: "Il corso è adatto anche alle donne?",
    answer: "Sì, il corso di pugilato può essere frequentato anche dalle donne. Il corso di pugilato di Pugilistica Brianza è misto e pensato per essere inclusivo. Alleniamo donne di ogni età e livello, in un ambiente rispettoso e motivante. La boxe è uno degli allenamenti più completi anche per obiettivi di fitness e benessere.",
  },
  {
    question: "Da che età si può fare pugilato?",
    answer: "Alla Pugilistica Brianza si può fare pugilato a partire dagli 8 anni. Il corso di pugilato per bambini e ragazzi è aperto dagli 8 anni in su, con allenamento adattato all'età e al livello di ciascuno, attenzione alla sicurezza e un approccio didattico orientato alla crescita graduale dell'atleta.",
  },
  {
    question: "Posso prenotare una prova gratuita?",
    answer: "Sì, puoi prenotare una prova gratuita alla Pugilistica Brianza di Barlassina. La prima lezione di pugilato, Hyrox o PB Hiit è gratuita e senza impegno: vieni, allenati con noi e decidi con calma se iscriverti. Puoi prenotare la prova chiamandoci al telefono, scrivendoci su WhatsApp o passando direttamente in palestra in Via Giovanni Segantini 29 a Barlassina.",
  },
  {
    question: "Fate anche pugilato agonistico?",
    answer: "Sì, alla Pugilistica Brianza facciamo anche pugilato agonistico. Siamo affiliati alla FPI (Federazione Pugilistica Italiana) e gareggiamo regolarmente nella light-boxe e nella boxe dilettantistica. Se vuoi crescere in ambito agonistico, costruiamo un percorso di allenamento su misura con preparazione tecnica, preparazione atletica e sparring specifici per l'incontro.",
  },
  {
    question: "Avete lezioni private?",
    answer: "Sì, la Pugilistica Brianza offre lezioni private di pugilato 1:1 con il coach Stefano Rizzo. Nelle lezioni private puoi lavorare su tecnica, preparazione atletica, obiettivi specifici o preparazione di un incontro, con orari flessibili concordati direttamente con il coach. Sono indicate per principianti che vogliono imparare velocemente, pugili che preparano una gara e adulti con orari particolari.",
  },
];

const faqPractical = [
  {
    question: "Cosa devo portare alla prima lezione?",
    answer: "Alla prima lezione di pugilato alla Pugilistica Brianza serve solo abbigliamento sportivo comodo e scarpe da ginnastica pulite per l'interno. Per la prova gratuita, la palestra fornisce guantoni e fasce da boxe: non devi comprare attrezzatura prima di decidere se iscriverti. Una bottiglia d'acqua e un asciugamano sono comunque consigliati.",
  },
  {
    question: "Quante volte a settimana è consigliato allenarsi?",
    answer: "Alla Pugilistica Brianza consigliamo 2-3 allenamenti a settimana per risultati costanti, sia nel corso di pugilato sia in Hyrox e PB Hiit. Il coach ti aiuterà a trovare la frequenza giusta in base ai tuoi obiettivi, al tuo livello di partenza e ai tempi di recupero tra una sessione e l'altra.",
  },
  {
    question: "Quanto costa l'iscrizione?",
    answer: "Alla Pugilistica Brianza gli abbonamenti mensili sono €50/mese per pugilato e PB Hiit, €65/mese per Hyrox. La formula Open all-inclusive, che dà accesso a tutti i corsi (pugilato, Hyrox, PB Hiit e Open Gym) dal lunedì al sabato, costa €90/mese. In alternativa puoi fare un ingresso singolo a €15 per una singola lezione. A tutti gli abbonamenti si aggiunge un tesseramento annuale obbligatorio di €20 che copre l'assicurazione sportiva e il tesseramento alla Federazione Pugilistica Italiana (FPI).",
  },
  {
    question: "Avete parcheggio?",
    answer: "Sì, alla Pugilistica Brianza c'è un parcheggio gratuito nelle immediate vicinanze della palestra, in Via Giovanni Segantini 29 a Barlassina (MB). Non serve prenotare il posto: la zona residenziale intorno alla palestra offre ampia disponibilità di parcheggio libero.",
  },
  {
    question: "Ci sono spogliatoi e docce?",
    answer: "Sì, la Pugilistica Brianza di Barlassina è dotata di spogliatoi e docce a disposizione di tutti gli iscritti dopo ogni allenamento di pugilato, Hyrox o PB Hiit.",
  },
  {
    question: "Quali sono gli orari di apertura?",
    answer: "La Pugilistica Brianza è aperta dal lunedì al venerdì dalle 08:00 alle 21:00 e il sabato dalle 10:00 alle 12:00. Domenica la palestra resta chiusa. I corsi si svolgono in fasce al mattino, in pausa pranzo e la sera durante la settimana, mentre il sabato sono previste due sole fasce mattutine.",
  },
];

const faqCourses = [
  {
    question: "Qual è la differenza tra Pugilato, Hyrox e PB Hiit?",
    answer: "Alla Pugilistica Brianza i tre corsi hanno obiettivi e struttura differenti. Il corso di pugilato è un percorso tecnico completo che include guardia, colpi (jab, cross, gancio, montante), footwork e sparring leggero. Hyrox è un allenamento ibrido di forza e resistenza con stazioni come sled push, burpees, rowing e wall balls, pensato per chi prepara gli eventi Hyrox o cerca un lavoro atletico completo. PB Hiit sono circuiti a intervalli ad alta intensità (HIIT) per fitness, tono muscolare e condizione cardiovascolare. Puoi provare gratuitamente tutti e tre i corsi prima di scegliere.",
  },
  {
    question: "Posso frequentare più corsi?",
    answer: "Sì, alla Pugilistica Brianza puoi frequentare più corsi contemporaneamente. Con la formula Open all-inclusive a €90/mese hai accesso illimitato a pugilato, Hyrox, PB Hiit e Open Gym dal lunedì al sabato, così puoi combinare più discipline nella stessa settimana. Se invece vuoi seguire un solo corso, l'abbonamento mensile dedicato costa €50 (pugilato o PB Hiit) oppure €65 (Hyrox).",
  },
  {
    question: "Come funzionano le lezioni private?",
    answer: "Le lezioni private di pugilato della Pugilistica Brianza sono sessioni 1:1 con il coach Stefano Rizzo, con orari flessibili concordati direttamente e programma personalizzato sugli obiettivi dell'atleta. Sono indicate per principianti che vogliono imparare velocemente i fondamentali della boxe, pugili che preparano un incontro e adulti con orari particolari. Contattaci per disponibilità e costi.",
  },
];

const pageSchema = buildPageSchema(
  buildGymRef(),
  buildWebPage(
    "/faq/",
    "FAQ — Domande Frequenti | Pugilistica Brianza",
    "Risposte alle domande più frequenti su Pugilistica Brianza: corsi, prova gratuita, orari, costi e tutto quello che serve per iniziare.",
  ),
  buildFaqPage([...faqGeneral, ...faqPractical, ...faqCourses], "faq"),
  buildBreadcrumb([{ name: "FAQ", href: "/faq/" }]),
);
---

<BaseLayout
  title="FAQ — Domande Frequenti | Pugilistica Brianza"
  description="Risposte alle domande più frequenti su Pugilistica Brianza: corsi, prova gratuita, orari, costi e tutto quello che serve per iniziare."
  schema={pageSchema}
>
  <!-- HERO -->
  <Hero
    topline="FAQ — Pugilistica Brianza"
    subtitle="Le domande più frequenti sulla Pugilistica Brianza di Barlassina: corsi di pugilato, Hyrox e PB Hiit, orari, prezzi degli abbonamenti, prova gratuita e tutto quello che serve sapere prima di iniziare. Se non trovi la risposta che cerchi, scrivici su WhatsApp."
    watermark="FAQ"
  >
    Domande <span class="text-brand">frequenti</span>
  </Hero>

  <!-- FAQ GENERALI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Domande generali"
        description="Le domande più comuni: chi può iniziare, l'età minima per il corso di pugilato, la prova gratuita, il pugilato agonistico tesserato FPI e le lezioni private 1:1 con il coach."
      >
        Sulla <span class="text-brand">palestra</span> e i corsi
      </SectionHeading>
      <FaqAccordion items={faqGeneral} defaultOpen={0} />
    </div>
  </section>

  <!-- FAQ PRATICHE -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Info pratiche"
        description="Risposte alle domande pratiche: cosa portare alla prima lezione, quante volte a settimana allenarsi, prezzi degli abbonamenti mensili, parcheggio, spogliatoi e docce, orari di apertura della palestra."
      >
        Orari, costi e <span class="text-brand">logistica</span>
      </SectionHeading>
      <FaqAccordion items={faqPractical} />
    </div>
  </section>

  <!-- FAQ CORSI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="I corsi"
        description="Le differenze tra i tre corsi (pugilato, Hyrox e PB Hiit), come combinarli con la formula Open all-inclusive e come funzionano le lezioni private di pugilato 1:1 con il coach Stefano Rizzo."
      >
        Pugilato, Hyrox e <span class="text-brand">PB Hiit</span>
      </SectionHeading>
      <FaqAccordion items={faqCourses} />
    </div>
  </section>

  <!-- CTA -->
  <div class="pb-section--alt">
    <CtaBlock
      description="Non hai trovato la risposta che cercavi? Scrivici su WhatsApp e ti rispondiamo subito."
      ctaPrimary={{ label: "Scrivici su WhatsApp", href: whatsappHref }}
    >
      Hai altre <span class="text-brand">domande?</span>
    </CtaBlock>
  </div>
</BaseLayout>
