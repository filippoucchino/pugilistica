---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DefinitionGrid from "../components/DefinitionGrid.astro";
import TargetCard from "../components/TargetCard.astro";
import BenefitItem from "../components/BenefitItem.astro";
import LessonStep from "../components/LessonStep.astro";
import WhyUsCard from "../components/WhyUsCard.astro";
import InfoRow from "../components/InfoRow.astro";
import PricingCard from "../components/PricingCard.astro";
import Gallery from "../components/Gallery.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import LocalSection from "../components/LocalSection.astro";
import CtaBlock from "../components/CtaBlock.astro";
import CoachBlock from "../components/CoachBlock.astro";
import { trustItems, localDetails, zones, siteInfo, buildWhatsappHref } from "@/data/shared";

// Foto coach: importata come ES module così Astro la ottimizza in build (WebP, dimensioni esplicite).
import stefanoPhoto from "../assets/images/bio/stefano-rizzo.jpg";

// Unica CTA della pagina: WhatsApp al coach con messaggio precompilato specifico per il corso.
const whatsappHref = buildWhatsappHref(
  "Ciao, vorrei prenotare una prova gratuita per il corso Hyrox."
);

/* — Dati pagina — */

const definitionItems = [
  { title: "Resistenza e corsa", description: "La corsa è il filo conduttore del format Hyrox. Ogni lezione include lavoro sulla capacità aerobica e sulla gestione del ritmo." },
  { title: "Stazioni funzionali", description: "Sled push, sled pull, burpees, farmer carry, wall balls, rowing: alleni le stazioni che trovi in gara, con tecnica e progressione." },
  { title: "Preparazione ibrida", description: "Non solo corsa, non solo forza: Hyrox è la combinazione delle due. Il corso sviluppa entrambe le capacità in modo equilibrato." },
  { title: "Adatto a ogni livello", description: "Il coach adatta carichi, volumi e intensità. Puoi partire da zero o preparare la tua prossima gara Hyrox." },
];

const targets = [
  { icon: '<path d="M18 20V10M12 20V4M6 20v-6"/>', title: "Chi vuole migliorare la resistenza", description: "Cerchi un allenamento che ti porti a un livello superiore di condizione fisica? Il corso Hyrox lavora sulla resistenza in modo progressivo e strutturato." },
  { icon: '<path d="M6 9H4.5a2.5 2.5 0 010-5H6"/><path d="M18 9h1.5a2.5 2.5 0 000-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0012 0V2z"/>', title: "Chi vuole preparare le gare ufficiali", description: "Il corso Hyrox ti prepara ad affrontare le gare ufficiali del circuito, individuali o in coppia, con una progressione mirata e il coach che ti segue verso l'obiettivo." },
  { icon: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>', title: "Chi pratica già fitness", description: "Vieni da crossfit, corsa o palestra e cerchi uno stimolo nuovo? Hyrox aggiunge struttura, competizione e varietà al tuo allenamento." },
  { icon: '<path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>', title: "Chi cerca un percorso strutturato", description: "Non un allenamento improvvisato, ma un programma con progressione, obiettivi e un coach che ti segue settimana dopo settimana." },
];

const benefits = [
  "<strong>Migliora</strong> resistenza aerobica e capacità di gestire sforzi prolungati",
  "<strong>Sviluppa</strong> forza funzionale applicata a movimenti reali e completi",
  "<strong>Aumenta</strong> capacità cardiovascolare, VO2max e soglia anaerobica",
  "<strong>Costruisce</strong> mentalità forte, determinazione e capacità di gestire la fatica",
  "<strong>Allena</strong> la preparazione ibrida: corsa e forza in un unico percorso integrato",
  "<strong>Prepara</strong> il corpo alla competizione, con o senza gara come obiettivo finale",
];

const steps = [
  { title: "Warm-up", description: "Attivazione generale con mobilità articolare, lavoro cardiovascolare leggero e preparazione muscolare specifica per la sessione. Serve a portare il corpo alla temperatura e alla prontezza giusta." },
  { title: "Lavoro a stazioni", description: "Rotazione sulle stazioni tipiche del format Hyrox: sled push, sled pull, burpees, farmer carry, wall balls, rowing e altre varianti. Il coach corregge la tecnica e gestisce i tempi." },
  { title: "Esercizi funzionali e corsa", description: "Blocchi di lavoro che combinano esercizi funzionali e tratti di corsa, simulando la struttura della gara. Focus sulla transizione tra sforzo di forza e sforzo aerobico." },
  { title: "Ritmo e intensità", description: "Fasi ad alta intensità per sviluppare la capacità di mantenere il ritmo sotto fatica. Il coach adatta il livello in base alla preparazione di ciascuno." },
  { title: "Recupero e chiusura", description: "Defaticamento, stretching e ritorno alla calma. Il coach dà feedback sulla sessione e indicazioni per il prossimo allenamento." },
];

const whyUs = [
  { icon: '<circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>', title: "Hyrox Training Club certificata", description: "Pugilistica Brianza è riconosciuta come Hyrox Training Club ufficiale: una delle poche palestre certificate per preparare il format di gara in modo strutturato e conforme agli standard del circuito." },
  { icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>', title: "Simulazioni gara in palestra", description: "Periodicamente organizziamo simulazioni complete del format Hyrox — corsa, stazioni e tempi reali — per farti arrivare alla gara già pronto e consapevole." },
  { icon: '<path d="M2 9a3 3 0 010 6v2a2 2 0 002 2h16a2 2 0 002-2v-2a3 3 0 010-6V7a2 2 0 00-2-2H4a2 2 0 00-2 2z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/>', title: "Prelazione sui biglietti gara", description: "Gli iscritti hanno accesso prioritario all'acquisto dei biglietti per le gare ufficiali Hyrox prima dell'apertura al pubblico generale. Un vantaggio concreto per chi vuole competere." },
  { icon: '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 019.9-1"/>', title: "Aperto anche agli esterni", description: "Non devi essere iscritto in palestra per allenarti con noi: puoi accedere con ingresso singolo a €15, assicurazione inclusa (visita medica obbligatoria). Perfetto per sessioni occasionali o per testare il corso." },
  { icon: '<circle cx="12" cy="8" r="4"/><path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/>', title: "Coach dedicato Hyrox", description: "Stefano Rizzo segue ogni sessione con un approccio strutturato, costruendo progressioni specifiche per la preparazione ibrida richiesta dal format." },
  { icon: '<path d="M18 20V10M12 20V4M6 20v-6"/>', title: "Attrezzatura completa stazioni", description: "Sled, farmer carry, wall balls, rowing, area functional dedicata: tutta l'attrezzatura ufficiale delle stazioni Hyrox, per allenarti esattamente come in gara." },
];

const infoRows = [
  { icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>', text: "<strong>Quando si svolge</strong>Il corso Hyrox si tiene dal lunedì al sabato. Gli orari dettagliati saranno inseriti a breve." },
  { icon: '<path d="M5 3l14 9-14 9V3z"/>', text: "<strong>Prova gratuita</strong>La prima lezione è gratuita e senza impegno. Vieni, allenati e decidi con calma." },
  { icon: '<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>', text: "<strong>Come iscriversi</strong>Contatto diretto: scrivici su WhatsApp o passa in palestra. L'iscrizione è semplice e veloce." },
  { icon: '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>', text: "<strong>Cosa portare</strong>Abbigliamento sportivo comodo e scarpe da ginnastica adatte al movimento funzionale. Attrezzatura disponibile in palestra." },
];

const faqItems = [
  { question: "Devo essere già allenato per iniziare Hyrox?", answer: "No. Il corso è strutturato per adattarsi a diversi livelli di preparazione. Il coach modifica carichi, intensità e volumi in base alla tua condizione attuale. Molti dei nostri iscritti hanno iniziato senza esperienza specifica in Hyrox." },
  { question: "Hyrox è adatto ai principianti?", answer: "Sì. L'allenamento è progressivo: si parte dalle basi degli esercizi funzionali e della corsa, per poi aumentare gradualmente intensità e complessità. Non serve un livello minimo per iniziare." },
  { question: "Quante volte a settimana dovrei allenarmi per Hyrox?", answer: "Per una buona progressione consigliamo 2-3 sessioni a settimana. Il coach ti aiuta a trovare la frequenza giusta in base ai tuoi obiettivi e al tuo livello di partenza." },
  { question: "Posso fare una prova gratuita del corso Hyrox?", answer: "Certo. La prima lezione è gratuita e senza impegno. Vieni in palestra a Barlassina, allenati con noi e decidi con calma. Puoi prenotare scrivendoci su WhatsApp o passando direttamente." },
  { question: "Cosa devo portare alla prima lezione di Hyrox?", answer: "Abbigliamento sportivo comodo e scarpe da ginnastica adatte al movimento funzionale. Tutta l'attrezzatura necessaria per la lezione è disponibile in palestra. Abbiamo spogliatoi e docce." },
  { question: "In cosa si differenzia il corso Hyrox dal PB Hiit?", answer: "Il corso Hyrox è orientato alla preparazione ibrida per la gara Hyrox, con focus su resistenza, corsa e stazioni funzionali. Il PB Hiit è un allenamento a intervalli ad alta intensità pensato per fitness, tono e condizione generale. Entrambi sono intensi, ma con obiettivi e struttura diversi." },
  { question: "Posso partecipare a gare Hyrox dopo il corso?", answer: "Sì. Il corso ti prepara per affrontare le gare Hyrox ufficiali, sia in formato individuale che in coppia. Il coach costruisce percorsi di preparazione specifici per chi vuole gareggiare." },
];
---

<BaseLayout
  title="Corso Hyrox a Barlassina | Pugilistica Brianza"
  description="Scopri il corso Hyrox a Barlassina: per chi è adatto, come si svolge, benefici, prova gratuita e contatti di Pugilistica Brianza."
>
  <!-- 1. HERO -->
  <Hero
    topline="Corso Hyrox — Pugilistica Brianza"
    subtitle="Allenati con un percorso orientato alla performance, per migliorare resistenza, forza e preparazione ibrida, in una palestra con ambiente familiare, coach qualificati e prova gratuita."
    watermark="HYROX"
    ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
  >
    Corso <span class="text-brand">Hyrox</span><br />a Barlassina in Brianza
  </Hero>

  <!-- TRUST BAR -->
  <div class="bg-surface border-b border-pb-border-default">
    <div class="pb-container">
      <TrustBar items={trustItems} />
    </div>
  </div>

  <!-- 2. CHE COS'È HYROX -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il corso">
        Che cos'è <span class="text-brand">Hyrox?</span>
      </SectionHeading>
      <DefinitionGrid
        introText="Hyrox è un format di gara e allenamento che combina corsa e stazioni di esercizi funzionali in un percorso ibrido ad alta intensità. A Pugilistica Brianza lo prepariamo con lezioni strutturate che allenano resistenza, forza e capacità cardiovascolare, adattando il lavoro al livello di ciascuno."
        items={definitionItems}
        video={{
          mp4: "/videos/corso-hyrox-pugilistica-brianza-barlassina.mp4",
          webm: "/videos/corso-hyrox-pugilistica-brianza-barlassina.webm",
          poster: "/videos/corso-hyrox-pugilistica-brianza-barlassina.jpg",
          title: "Allenamento Hyrox alla Pugilistica Brianza di Barlassina",
        }}
      />
    </div>
  </section>

  <!-- 3. PER CHI È ADATTO -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Per chi"
        description="Il corso è pensato per profili diversi, accomunati dalla voglia di allenarsi con intensità e obiettivi chiari."
      >
        Per chi è adatto il corso <span class="text-brand">Hyrox?</span>
      </SectionHeading>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {targets.map((t) => (
          <TargetCard icon={t.icon} title={t.title} description={t.description} />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. BENEFICI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Benefici"
        description="Hyrox è uno degli allenamenti più completi per chi vuole costruire una forma fisica solida e funzionale."
      >
        I benefici di <span class="text-brand">Hyrox</span>
      </SectionHeading>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {benefits.map((b) => <BenefitItem text={b} />)}
      </div>
    </div>
  </section>

  <!-- 5. COME SI SVOLGE UNA LEZIONE -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="La lezione"
        description="Ogni lezione dura circa 60 minuti ed è strutturata per replicare il formato gara con progressione e adattamento al livello del gruppo."
      >
        Come si svolge una lezione di <span class="text-brand">Hyrox?</span>
      </SectionHeading>
      <div class="flex flex-col" style="counter-reset: step;">
        {steps.map((s) => <LessonStep title={s.title} description={s.description} />)}
      </div>
    </div>
  </section>

  <!-- IL COACH -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il coach">
        Chi ti prepara alle gare <span class="text-brand">Hyrox</span>
      </SectionHeading>
      <CoachBlock
        name="Stefano Rizzo"
        role="Co-fondatore e Head Coach"
        bio="Ex pugile agonista e certificato FIPE, Stefano negli ultimi anni si è specializzato nelle discipline ibride diventando Coach Hyrox certificato (Accademia 365). È ancora atleta attivo: compete nelle gare Hyrox e nelle corse su 10 km e mezza maratona, e porta in ogni sessione del corso un approccio diretto e pratico, costruito sull'esperienza in gara."
        tags={["Coach Hyrox certificato", "Atleta Hyrox attivo", "10 km · mezza maratona", "Ex pugile agonista"]}
        photo={stefanoPhoto}
        photoAlt="Stefano Rizzo, co-fondatore e head coach di Pugilistica Brianza"
      />
    </div>
  </section>

  <!-- CTA INTERMEDIA -->
  <div class="pb-section--alt">
    <CtaBlock
      description="La prova è gratuita e senza impegno. Vieni a Barlassina, allenati con noi e decidi con calma."
      ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
    >
      Vuoi provare una <span class="text-brand">lezione?</span>
    </CtaBlock>
  </div>

  <!-- 6. PERCHÉ SCEGLIERE NOI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Perché noi"
        description="Pugilistica Brianza non è una palestra generica. È un'ASD con un'identità chiara, dove l'allenamento è serio e l'ambiente è familiare."
      >
        Perché allenarti <span class="text-brand">con noi</span>
      </SectionHeading>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {whyUs.map((w) => (
          <WhyUsCard icon={w.icon} title={w.title} description={w.description} />
        ))}
      </div>
    </div>
  </section>

  <!-- 7. ORARI, PROVA E ISCRIZIONE -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="Info pratiche">
        Orari, prova e <span class="text-brand">iscrizione</span>
      </SectionHeading>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-10 items-start">
        <div>
          {infoRows.map((r) => <InfoRow icon={r.icon} text={r.text} />)}
        </div>
        <PricingCard
          title="Abbonamento mensile"
          price="€65"
          note="+ Tesseramento annuale €20 (obbligatorio)"
          features={[
            "Accesso illimitato al corso Hyrox",
            "Ingresso singolo: €15 (necessaria visita medica)",
            "Formula Open (tutti i corsi): €90/mese",
            "Prima lezione gratuita",
          ]}
          ctaLabel="Prenota su WhatsApp"
          ctaHref={whatsappHref}
        />
      </div>
    </div>
  </section>

  <!-- 8. GALLERY -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Gallery">
        Guarda <span class="text-brand">l'allenamento</span>
      </SectionHeading>
      <Gallery />
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="FAQ">
        Domande frequenti su <span class="text-brand">Hyrox</span>
      </SectionHeading>
      <FaqAccordion items={faqItems} defaultOpen={0} withSchema />
    </div>
  </section>

  <!-- 10. LOCAL -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Dove siamo">
        Allenati a <span class="text-brand">Barlassina,</span> in Brianza
      </SectionHeading>
      <LocalSection
        address={`${siteInfo.address}<br>${siteInfo.cap} ${siteInfo.city} (${siteInfo.province})`}
        addressLabel={siteInfo.name}
        zones={zones}
        details={localDetails}
      />
      <div class="mt-8">
        <a href="/contatti/" class="pb-btn-text">Vai alla pagina Contatti →</a>
      </div>
    </div>
  </section>

  <!-- 11. CTA FINALE -->
  <div class="pb-section--alt">
    <CtaBlock
      description="Vieni a Barlassina e prova il corso Hyrox senza impegno. Coach qualificati, ambiente familiare e accesso semplice."
      ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
    >
      Prenota la tua <span class="text-brand">prova gratuita</span>
    </CtaBlock>
  </div>
</BaseLayout>
