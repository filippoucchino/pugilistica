---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import SegmentCard from "../components/SegmentCard.astro";
import BenefitItem from "../components/BenefitItem.astro";
import CoachBlock from "../components/CoachBlock.astro";
import Gallery from "../components/Gallery.astro";
import ReviewCard from "../components/ReviewCard.astro";
import LocalSection from "../components/LocalSection.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { trustItems, localDetails, zonesInfo, siteInfo, buildWhatsappHref, reviews } from "@/data/shared";
import { buildPageSchema, buildGym, buildWebSite, buildWebPage, buildFaqPage, buildFreeTrialOffer } from "@/data/schema";

// Foto coach: importata come ES module così Astro la ottimizza in build (WebP, dimensioni esplicite).
import stefanoPhoto from "../assets/images/bio/stefano-rizzo.jpg";

// Foto gallery home: mix da tutte le aree della palestra per dare una panoramica completa.
import galPanoramica from "../assets/images/pugilato/palestra-panoramica-ring-pugilistica-brianza.jpg";
import galCircuito from "../assets/images/pb-hiit/circuito-gruppo-pb-hiit-pugilistica-brianza.jpg";
import galRing from "../assets/images/pugilato/ring-boxe-pugilistica-brianza-barlassina.jpg";
import galHyrox from "../assets/images/hyrox/area-functional-panoramica-hyrox-pugilistica-brianza.jpg";
import galSacchi from "../assets/images/pugilato/allenamento-sacchi-pugili-pugilistica-brianza.jpg";
import galColpitori from "../assets/images/pb-hiit/lavoro-colpitori-boxe-pb-hiit-pugilistica-brianza.jpg";
import galSimulazione from "../assets/images/hyrox/simulazione-gara-hyrox-pugilistica-brianza.jpg";
import galIngresso from "../assets/images/pugilato/ingresso-reception-pugilistica-brianza.jpg";

const services = [
  {
    icon: '<path d="M3 14V11Q3 9 5 9H8Q9 5 12 5Q15 5 15 8L18 8Q22 8 22 13Q22 18 18 18H8V18H3z"/><path d="M8 9L15 8M8 9V18"/>',
    title: "Pugilato",
    description:
      "Corso di pugilato per chi vuole imparare tecnica, mettersi in forma o crescere anche in ottica agonistica. Dai principianti assoluti ai pugili dilettanti, passando per donne e ragazzi dagli 8 anni.",
    ctaLabel: "Scopri il corso",
    ctaHref: "/pugilato/",
  },
  {
    icon: '<svg width="100%" height="100%" viewBox="15 95 178 75" preserveAspectRatio="none"><path style="fill:#c41e1e;stroke:none" d="m78.808518 177.52289v-0.0821l0.570662-0.97711 0.570661-0.97711v-0.15344-0.15344h0.109979 0.109979l0.353684-0.67688 0.353683-0.67687 0.230149-0.35745 0.230148-0.35745 0.697177-1.24786 0.697176-1.24785 42.193294-4.7e-4 42.19329-4.6e-4v0.0692 0.0692l-0.428 0.69558-0.42799 0.69558 0 0.0768v0.0768l-1.03433 1.77216-1.03432 1.77216-0.2404 0.41795-0.2404 0.41794-0.23952 0.46366-0.23952 0.46366h-42.2127-42.212702zm8.741443-15.21875 0.632855-1.17699 0.270473-0.49933 0.270474-0.49933 0.106999-0.0476 0.106999-0.0476v-0.14012-0.14012l0.727908-1.23237 0.727907-1.23238 0.124554-0.3276 0.124554-0.3276h42.232486 42.23249v0.0802 0.0802l-0.92733 1.56223-0.92732 1.56224 0 0.0647v0.0647l-1.01327 1.7168-1.01326 1.71681H129.07179 86.917106Zm7.522412-13.16859v-0.079l0.446173-0.81261 0.446173-0.81262 0.69515-1.16113 0.69515-1.16114v-0.15852-0.15852h0.133052 0.133051l0.09458-0.29799 0.09458-0.29799 0.502371-0.84333 0.502372-0.84333h42.205258 42.20526l-0.9203 1.55986-0.9203 1.55986v0.069 0.069l-0.61067 1.04612-0.61067 1.04611-0.35208 0.67766-0.35208 0.67766H137.26591 95.072373ZM18.461056 135.02703v-0.0637l0.499329-0.85198 0.499329-0.85197v-0.15433-0.15432h0.111388 0.111388l0.167474-0.39233 0.167475-0.39233 0.505429-0.856 0.505429-0.85599 0.09444-0.214 0.09444-0.21399 0.512261-0.88893 0.512261-0.88893 84.562761-0.003 84.56276-0.003-0.36078 0.60633-0.36078 0.60632-0.0817 0.24967-0.0817 0.24966h-0.12602-0.12603l0 0.15153 0 0.15153-0.93143 1.59612-0.93144 1.59613-0.13773 0.21399-0.13774 0.214-0.30186 0.60633-0.30186 0.60633-84.51354 0H18.461056Zm8.19891-14.30985 0.09791-0.39233 0.202882-0.22523 0.202883-0.22523v-0.0914-0.0914l0.713327-1.20769 0.713327-1.20769v-0.14012-0.14012l0.119645-0.0476 0.119645-0.0476 0.617304-1.14132 0.617303-1.14133 0.153362-0.24966 0.153361-0.24966h42.191813 42.191818l-0.37293 0.67766-0.37293 0.67766-0.1036 0.14266-0.10359 0.14267-0.59553 1.1026-0.59552 1.10261-0.24478 0.4666-0.24478 0.46661-0.079 0.0714-0.079 0.0714-0.29585 0.57066-0.29585 0.57066-0.2671 0.46277-0.2671 0.46276-42.137425 9e-4-42.137423 9e-4zm7.883047-13.97775 0.09448-0.2462 1.009001-1.71545 1.009-1.71544 0.177299-0.35666 0.177298-0.35667 0.377816-0.64199 0.377816-0.642 0.336035-0.53499 0.336036-0.534997h42.155834 42.155835v0.07905 0.079l-0.42207 0.75859-0.42207 0.75858-0.93325 1.59591-0.93325 1.59591v0.0506l0 0.0506-0.583 1.01119-0.58299 1.01119H76.660682 34.448535Zm8.17116-14.180001V92.39976l0.499329-0.821984 0.499329-0.821984v-0.07493-0.07493l0.688642-1.1904 0.688642-1.1904 0.620789-1.105657 0.62079-1.105656h42.211268 42.211268l-0.52658 0.962991-0.52659 0.962991-1.16401 1.997316-1.16401 1.997315-0.19592 0.39233-0.19591 0.39233H84.84769 42.714173Z"/></svg>',
    title: "Hyrox",
    description:
      "Allenamento Hyrox performance-oriented per resistenza aerobica, forza funzionale e preparazione ibrida. Sulle stazioni reali di gara (sled push, wall balls, rowing, farmer carry) con coach certificato Hyrox.",
    ctaLabel: "Scopri Hyrox",
    ctaHref: "/hyrox/",
  },
  {
    icon: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>',
    title: "PB Hiit",
    description:
      "Allenamento PB Hiit intenso e dinamico per fitness, tono muscolare e condizione cardiovascolare. Circuiti HIIT a intervalli con lavoro al sacco pesante, pensati per chi vuole risultati visibili in poco tempo.",
    ctaLabel: "Scopri PB Hiit",
    ctaHref: "/pb-hiit/",
  },
  {
    icon: '<circle cx="12" cy="8" r="4"/><path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/>',
    title: "Lezioni private",
    description:
      "Lezioni private di pugilato 1:1 con il coach Stefano Rizzo per lavorare su tecnica, preparazione atletica o obiettivi specifici. Orari flessibili concordati via WhatsApp e programma costruito su misura.",
    ctaLabel: "Richiedi informazioni",
    ctaHref: "/lezioni-private-pugilato/",
  },
];

const segments = [
  {
    title: "Principianti",
    description:
      "Parti da zero con un percorso di pugilato guidato, in un ambiente accogliente e senza pressione. La maggior parte dei nostri iscritti ha iniziato proprio qui, senza alcuna esperienza pregressa.",
    linkLabel: "Scopri il corso →",
    linkHref: "/pugilato/",
  },
  {
    title: "Donne",
    description:
      "Il corso di pugilato è misto, inclusivo, tecnico e motivante. La boxe allena corpo e mente senza distinzioni, con donne di ogni età tra gli iscritti.",
    linkLabel: "Scopri il corso →",
    linkHref: "/pugilato/",
  },
  {
    title: "Ragazzi dagli 8 anni",
    description:
      "Corso di pugilato per ragazzi dagli 8 anni: disciplina, coordinazione e fiducia in un ambiente sano e formativo. L'allenamento è adattato all'età e al livello di ciascun atleta.",
    linkLabel: "Scopri il corso →",
    linkHref: "/pugilato/",
  },
  {
    title: "Amatori e agonisti",
    description:
      "Preparazione tecnica e atletica per light-boxe e boxe dilettantistica tesserata FPI. Percorsi strutturati per chi vuole competere sul ring, con sparring e programmazione mirata all'incontro.",
    linkLabel: "Scopri il corso →",
    linkHref: "/pugilato/",
  },
];

const benefits = [
  "<strong>Ambiente familiare e divertente,</strong> ma tecnicamente serio e competitivo allo stesso tempo",
  "<strong>Coach con esperienza agonistica reale</strong> (Stefano Rizzo, ex pugile agonista, Maestro 2° livello FPI e Coach Hyrox certificato)",
  "<strong>Attenzione sia a chi inizia da zero</strong> sia a chi vuole crescere in light-boxe e boxe dilettantistica",
  "<strong>Struttura attrezzata</strong> con ring regolamentare, sacchi pesanti, area Hyrox e zona functional training",
  "<strong>Affiliazioni FPI, FIPE e Hyrox Training Club,</strong> garanzia di serietà e standard tecnici",
  "<strong>Posizione comoda</strong> per Barlassina, Cogliate, Seveso, Lissone, Seregno, Desio, Meda e tutta la Brianza",
];

const faqItems = [
  {
    question: "Posso iniziare anche se sono principiante?",
    answer:
      "Sì, puoi iniziare il corso di pugilato alla Pugilistica Brianza anche senza alcuna esperienza. La maggior parte degli iscritti è partita da zero: il coach adatta gli esercizi al livello di ciascuno, dai principianti assoluti a chi ha già fatto qualche sessione al sacco.",
  },
  {
    question: "Il corso è adatto anche alle donne?",
    answer:
      "Sì, il corso di pugilato può essere frequentato anche dalle donne. Il corso di pugilato di Pugilistica Brianza è misto e pensato per essere inclusivo. Alleniamo donne di ogni età e livello, in un ambiente rispettoso e motivante. La boxe è uno degli allenamenti più completi anche per obiettivi di fitness e benessere.",
  },
  {
    question: "Da che età si può fare pugilato?",
    answer:
      "Alla Pugilistica Brianza il corso di pugilato è aperto dagli 8 anni in su. L'allenamento per bambini e ragazzi è adattato all'età e al livello di ciascuno, con attenzione alla sicurezza e approccio didattico graduale.",
  },
  {
    question: "Fate anche pugilato agonistico?",
    answer:
      "Sì, alla Pugilistica Brianza si fa anche pugilato agonistico. Siamo affiliati FPI (Federazione Pugilistica Italiana) e gareggiamo regolarmente nella light-boxe e nella boxe dilettantistica. Se vuoi crescere in ottica agonistica, costruiamo un percorso di allenamento su misura per l'incontro.",
  },
  {
    question: "Posso prenotare una prova gratuita?",
    answer:
      "Sì, puoi prenotare una prova gratuita alla Pugilistica Brianza di Barlassina. La prima lezione è gratuita e senza impegno: vieni, allenati con noi e decidi con calma se iscriverti. Puoi prenotare scrivendoci su WhatsApp o passando direttamente in palestra.",
  },
  {
    question: "Avete lezioni private?",
    answer:
      "Sì, alla Pugilistica Brianza offriamo lezioni private di pugilato 1:1 con il coach Stefano Rizzo. Puoi lavorare su tecnica, preparazione atletica, obiettivi specifici o preparazione gara, con orari flessibili concordati via WhatsApp.",
  },
];

const whatsappHref = buildWhatsappHref(
  "Ciao, vorrei prenotare una prova gratuita."
);

const pageSchema = buildPageSchema(
  buildWebSite(),
  buildGym(),
  buildWebPage(
    "/",
    "Palestra di Pugilato e Hyrox a Barlassina | Pugilistica Brianza",
    "Palestra di pugilato a Barlassina in Brianza. Corsi di pugilato, Hyrox e PB Hiit per principianti, amatori e agonisti.",
  ),
  buildFaqPage(faqItems, ""),
  buildFreeTrialOffer(),
);
---

<BaseLayout
  title="Palestra di Pugilato e Hyrox a Barlassina | Pugilistica Brianza"
  description="Palestra di pugilato a Barlassina in Brianza. Corsi di pugilato, Hyrox e PB Hiit per principianti, amatori e agonisti. Prova gratuita, ambiente familiare e coach qualificati."
  schema={pageSchema}
>
  <!-- 1. HERO -->
  <Hero
    topline="ASD Pugilistica Brianza, Barlassina"
    subtitle="ASD Pugilistica Brianza è una palestra di pugilato e allenamento funzionale a Barlassina (MB), nel cuore della Brianza. Corsi di pugilato, Hyrox e PB Hiit per principianti, donne, ragazzi dagli 8 anni, amatori e pugili agonisti. Prova gratuita senza impegno, ring regolamentare e coach qualificati FPI e Hyrox."
    ctaPrimary={{ label: "Prenota una prova gratuita", href: whatsappHref }}
  >
    Palestra di <span class="text-brand">pugilato</span> <br />e <span class="text-brand">Hyrox</span> a Barlassina <br />in Brianza
  </Hero>

  <!-- 2. TRUST BAR -->
  <div class="bg-surface border-b border-pb-border-default">
    <div class="pb-container">
      <TrustBar items={trustItems} />
    </div>
  </div>

  <!-- 3. SERVIZI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="I nostri percorsi"
        description="Alla Pugilistica Brianza trovi quattro percorsi per obiettivi diversi (pugilato, Hyrox, PB Hiit e lezioni private 1:1) con lo stesso approccio: tecnica seria, ambiente familiare e risultati concreti. Tutti i corsi includono una prima lezione di prova gratuita."
      >
        Corsi di pugilato, <span class="text-brand">Hyrox</span> e PB Hiit
      </SectionHeading>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 list-none pl-0 m-0">
        {services.map((s) => (
          <ServiceCard
            icon={s.icon}
            title={s.title}
            description={s.description}
            ctaLabel={s.ctaLabel}
            ctaHref={s.ctaHref}
          />
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. PER CHI È -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Per chi è"
        description="Non importa da dove parti, importa dove vuoi arrivare. Accogliamo principianti, donne, ragazzi dagli 8 anni, amatori e pugili agonisti, con percorsi adattati al livello tecnico e agli obiettivi di ciascuno."
      >
        Un percorso adatto a <span class="text-brand">ogni livello</span>
      </SectionHeading>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 list-none pl-0 m-0">
        {segments.map((s) => (
          <SegmentCard
            title={s.title}
            description={s.description}
            linkLabel={s.linkLabel}
            linkHref={s.linkHref}
          />
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. PERCHÉ SCEGLIERCI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Perché noi"
        description="Tecnica, ambiente e mentalità guidano ogni allenamento. Non una palestra generica con qualche sacco in un angolo, ma una realtà di pugilato vera a Barlassina dal 2016, con credibilità sportiva (affiliazioni FPI, FIPE e Hyrox Training Club) e accessibilità locale per tutta la Brianza."
      >
        Perché scegliere <span class="text-brand">Pugilistica Brianza</span>
      </SectionHeading>

      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none pl-0 m-0">
        {benefits.map((b) => (
          <BenefitItem text={b} />
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. COACH -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il coach">
        Una guida tecnica con <span class="text-brand">esperienza reale</span>
      </SectionHeading>

      <CoachBlock
        name="Stefano Rizzo"
        role="Co-fondatore e Head Coach"
        bio="Ex pugile agonista, oggi co-fondatore della palestra e guida tecnica di tutti i percorsi. Certificato FIPE, con esperienza nella light-boxe e nella boxe dilettantistica. Segue personalmente ogni iscritto, dai principianti a chi prepara le gare."
        tags={[
          "Ex pugile agonista",
          "Certificato FIPE",
          "Light-boxe",
          "Boxe dilettantistica",
        ]}
        photo={stefanoPhoto}
        photoAlt="Stefano Rizzo, co-fondatore e head coach di Pugilistica Brianza"
      />
    </div>
  </section>

  <!-- 7. GALLERY -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="La palestra"
        description="Gli spazi della Pugilistica Brianza a Barlassina: ring regolamentare da boxe, sala sacchi pesanti, area Hyrox con rower, sled, kettlebell e bilancieri, zona functional training per i circuiti PB Hiit. Tutto in un unico ambiente."
      >
        Dove ti <span class="text-brand">alleni</span>
      </SectionHeading>

      <Gallery images={[
        { src: galPanoramica, alt: "Vista panoramica della Pugilistica Brianza: sala sacchi pesanti e ring da boxe con bandiere internazionali" },
        { src: galCircuito, alt: "Circuito di gruppo PB Hiit: allieve su stazioni diverse con bilancieri e corpo libero" },
        { src: galRing, alt: "Ring da boxe della Pugilistica Brianza di Barlassina con bandiera laterale e bandiere internazionali" },
        { src: galHyrox, alt: "Area Hyrox e functional training: rower, sled, bilancieri e attrezzatura completa" },
        { src: galSacchi, alt: "Pugili che si allenano ai sacchi pesanti durante una lezione di boxe alla Pugilistica Brianza" },
        { src: galColpitori, alt: "Lavoro ai colpitori con guantoni durante una sessione di allenamento" },
        { src: galSimulazione, alt: "Simulazione gara Hyrox alla Pugilistica Brianza: sled push e rope pull con il gruppo che osserva" },
        { src: galIngresso, alt: "Ingresso e reception della Pugilistica Brianza: bancone con logo, locandine eventi e scaffali attrezzatura" },
      ]} />
    </div>
  </section>

  <!-- 8. PROVA GRATUITA CTA -->
  <div class="pb-section--alt">
    <CtaBlock
      description="Allenati a Barlassina in una palestra di pugilato vera, con percorsi chiari e ambiente accogliente."
      subdesc="Nessun impegno. Vieni, prova e decidi."
      ctaPrimary={{ label: "Scrivici su WhatsApp", href: whatsappHref }}
    >
      Prova <span class="text-brand">gratuita</span>
    </CtaBlock>
  </div>

  <!-- 9. RECENSIONI (slider orizzontale CSS scroll-snap) -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <div class="flex items-end justify-between mb-12 gap-6 [&>.pb-section-heading]:mb-0">
        <SectionHeading
          topline="Recensioni"
          description="Chi ci sceglie, resta. 74 recensioni Google con media 5.0: leggi cosa dicono i nostri iscritti sul coach, sull'ambiente e sui percorsi di pugilato, Hyrox e PB Hiit."
        >
          Cosa dicono di <span class="text-brand">noi</span>
        </SectionHeading>

        <!-- Frecce di navigazione (visibili solo da sm in su) -->
        <div class="hidden sm:flex gap-2 shrink-0 mb-1">
          <button
            type="button"
            id="reviews-prev"
            aria-label="Recensioni precedenti"
            class="w-10 h-10 rounded-full border border-pb-border-medium
                   flex items-center justify-center text-pb-text-muted
                   hover:border-brand hover:text-brand transition-colors duration-200
                   disabled:opacity-30 disabled:cursor-not-allowed"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button
            type="button"
            id="reviews-next"
            aria-label="Recensioni successive"
            class="w-10 h-10 rounded-full border border-pb-border-medium
                   flex items-center justify-center text-pb-text-muted
                   hover:border-brand hover:text-brand transition-colors duration-200
                   disabled:opacity-30 disabled:cursor-not-allowed"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Slider container -->
      <div
        id="reviews-slider"
        class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide"
      >
        {reviews.map((r) => (
          <div class="w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] flex-none snap-start">
            <ReviewCard
              text={r.text}
              author={r.author}
              source={r.source}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Script navigazione slider recensioni -->
  <script is:inline>
  (function () {
    const slider = document.getElementById("reviews-slider");
    const prev = document.getElementById("reviews-prev");
    const next = document.getElementById("reviews-next");
    if (!slider || !prev || !next) return;

    /** Larghezza di una card + gap per calcolare lo scroll */
    function getScrollStep() {
      const card = slider.querySelector(":scope > div");
      if (!card) return 300;
      const style = getComputedStyle(slider);
      const gap = parseFloat(style.gap) || 24;
      return card.offsetWidth + gap;
    }

    function updateButtons() {
      prev.disabled = slider.scrollLeft <= 1;
      next.disabled = slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 1;
    }

    prev.addEventListener("click", function () {
      slider.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
    });
    next.addEventListener("click", function () {
      slider.scrollBy({ left: getScrollStep(), behavior: "smooth" });
    });

    slider.addEventListener("scroll", updateButtons, { passive: true });
    updateButtons();
  })();
  </script>

  <!-- 10. LOCAL -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Dove siamo"
        description="La Pugilistica Brianza si trova in Via Giovanni Segantini 29 a Barlassina (MB), nel cuore della Brianza. Facilmente raggiungibile dai comuni limitrofi: Cogliate, Seveso, Lissone, Seregno, Desio, Meda, Cesano Maderno e Muggiò."
