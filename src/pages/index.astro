  <!-- 12. CTA FINALE -->
  <div class="pb-section--alt">
    <CtaBlock
      description="Allenati a Barlassina in una palestra di pugilato vera, con percorsi chiari, ambiente accogliente e accesso semplice tramite prova gratuita."
