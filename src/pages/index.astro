---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import SegmentCard from "../components/SegmentCard.astro";
import BenefitItem from "../components/BenefitItem.astro";
import CoachBlock from "../components/CoachBlock.astro";
import Gallery from "../components/Gallery.astro";
import ReviewCard from "../components/ReviewCard.astro";
import LocalSection from "../components/LocalSection.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { trustItems, localDetails, zones, siteInfo, buildWhatsappHref, reviews, reviewAggregation } from "@/data/shared";

// Foto coach: importata come ES module così Astro la ottimizza in build (WebP, dimensioni esplicite).
import stefanoPhoto from "../assets/images/bio/stefano-rizzo.jpg";

const services = [
  {
    icon: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>',
    title: "Pugilato",
    description:
      "Per chi vuole imparare tecnica, mettersi in forma o crescere anche in ottica agonistica. Dai principianti ai dilettanti, passando per donne e ragazzi dagli 8 anni.",
    ctaLabel: "Scopri il corso",
    ctaHref: "/pugilato/",
  },
  {
    icon: '<path d="M18 20V10M12 20V4M6 20v-6"/>',
    title: "Hyrox",
    description:
      "Allenamento performance-oriented per resistenza, forza e preparazione ibrida. Per chi cerca una sfida strutturata e vuole superare i propri limiti.",
    ctaLabel: "Scopri Hyrox",
    ctaHref: "/hyrox/",
  },
  {
    icon: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>',
    title: "PB Hiit",
    description:
      "Allenamento intenso e dinamico per fitness, tono e condizione. Circuiti a intervalli pensati per chi vuole risultati visibili in poco tempo.",
    ctaLabel: "Scopri PB Hiit",
    ctaHref: "/pb-hiit/",
  },
  {
    icon: '<circle cx="12" cy="8" r="4"/><path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/>',
    title: "Lezioni private",
    description:
      "Percorso personalizzato 1:1 per tecnica, preparazione e obiettivi specifici. Orari flessibili e programma costruito su misura.",
    ctaLabel: "Richiedi informazioni",
    ctaHref: "/lezioni-private-pugilato/",
  },
];

const segments = [
  {
    title: "Principianti",
    description:
      "Parti da zero con un percorso guidato, in un ambiente accogliente e senza pressione. La maggior parte dei nostri iscritti ha iniziato qui.",
    linkLabel: "Scopri il corso →",
    linkHref: "/pugilato/",
  },
  {
    title: "Donne",
    description:
      "Corso misto in un contesto inclusivo, tecnico e motivante. Il pugilato allena corpo e mente senza distinzioni.",
    linkLabel: "Scopri il corso →",
    linkHref: "/pugilato/",
  },
  {
    title: "Ragazzi dagli 8 anni",
    description:
      "Disciplina, coordinazione e fiducia in un ambiente sano e formativo. L'allenamento è adattato all'età e al livello.",
    linkLabel: "Scopri il corso →",
    linkHref: "/pugilato/",
  },
  {
    title: "Amatori e agonisti",
    description:
      "Preparazione tecnica e atletica per light-boxe e boxe dilettantistica. Percorsi strutturati per chi vuole competere.",
    linkLabel: "Scopri il corso →",
    linkHref: "/pugilato/",
  },
];

const benefits = [
  "<strong>Ambiente familiare e divertente,</strong> ma competitivo allo stesso tempo",
  "<strong>Coach con esperienza agonistica reale</strong> e certificazione FIPE",
  "<strong>Attenzione sia a chi inizia</strong> sia a chi vuole crescere in ottica dilettantistica",
  "<strong>Struttura attrezzata</strong> con ring, sacchi e area functional training",
  "<strong>Affiliazioni FPI, FIPE e Hyrox,</strong> garanzia di serietà e standard tecnici",
  "<strong>Posizione comoda</strong> per Barlassina, Seveso, Lissone, Seregno e tutta la Brianza",
];

const faqItems = [
  {
    question: "Posso iniziare anche se sono principiante?",
    answer:
      "Assolutamente sì. La maggior parte dei nostri iscritti ha iniziato da zero. Il corso è strutturato per accogliere tutti i livelli, dai principianti assoluti a chi ha già esperienza.",
  },
  {
    question: "Il corso è adatto anche alle donne?",
    answer:
      "Sì, il corso è misto e pensato per essere inclusivo. Alleniamo donne di ogni età e livello, in un ambiente rispettoso e motivante.",
  },
  {
    question: "Da che età si può fare pugilato?",
    answer:
      "Il corso di pugilato è aperto dagli 8 anni in su. L'allenamento è adattato all'età e al livello del ragazzo, con attenzione alla sicurezza e alla crescita graduale.",
  },
  {
    question: "Fate anche pugilato agonistico?",
    answer:
      "Sì, siamo affiliati FPI e gareggiamo nella light-boxe e nella boxe dilettantistica. Se vuoi crescere in ambito agonistico, possiamo costruire un percorso su misura.",
  },
  {
    question: "Posso prenotare una prova gratuita?",
    answer:
      "Certo. La prova gratuita è senza impegno: vieni, allenati con noi e decidi con calma. Puoi prenotarla scrivendoci su WhatsApp o passando direttamente in palestra.",
  },
  {
    question: "Avete lezioni private?",
    answer:
      "Sì, offriamo lezioni private di pugilato 1:1 con il coach. Puoi lavorare su tecnica, preparazione atletica o obiettivi specifici con orari flessibili.",
  },
];

const whatsappHref = buildWhatsappHref(
  "Ciao, vorrei prenotare una prova gratuita."
);

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: siteInfo.name,
  description:
    "Palestra di pugilato a Barlassina in Brianza. Corsi di pugilato, Hyrox e PB Hiit per principianti, amatori e agonisti.",
  address: {
    "@type": "PostalAddress",
    streetAddress: siteInfo.address,
    addressLocality: siteInfo.city,
    postalCode: siteInfo.cap,
    addressRegion: siteInfo.province,
    addressCountry: "IT",
  },
  url: siteInfo.url,
  logo: `${siteInfo.url}/brand/logo.png`,
  image: `${siteInfo.url}/brand/og-image.jpg`,
  telephone: siteInfo.phone,
  sameAs: [siteInfo.social.facebook, siteInfo.social.instagram],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: reviewAggregation.ratingValue,
    bestRating: 5,
    worstRating: 1,
    reviewCount: reviewAggregation.reviewCount,
  },
  review: reviews.map((r) => ({
    "@type": "Review",
    author: { "@type": "Person", name: r.author },
    reviewRating: {
      "@type": "Rating",
      ratingValue: 5,
      bestRating: 5,
      worstRating: 1,
    },
    reviewBody: r.text,
  })),
};
---

<BaseLayout
  title="Palestra di Pugilato a Barlassina | Pugilistica Brianza"
  description="Palestra di pugilato a Barlassina in Brianza. Corsi di pugilato, Hyrox e PB Hiit per principianti, amatori e agonisti. Prova gratuita, ambiente familiare e coach qualificati."
  schema={pageSchema}
>
  <!-- 1. HERO -->
  <Hero
    topline="ASD Pugilistica Brianza — Barlassina"
    subtitle="Corsi di pugilato, Hyrox e PB Hiit per principianti, amatori e agonisti. Prova gratuita, ambiente familiare e coach qualificati."
    ctaPrimary={{ label: "Prenota una prova gratuita", href: whatsappHref }}
  >
    Palestra di <span class="text-brand">pugilato</span><br />a Barlassina in Brianza
  </Hero>

  <!-- 2. TRUST BAR -->
  <div class="bg-surface border-b border-pb-border-default">
    <div class="pb-container">
      <TrustBar items={trustItems} />
    </div>
  </div>

  <!-- 3. SERVIZI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="I nostri percorsi"
        description="Quattro percorsi per obiettivi diversi, con lo stesso approccio: tecnica, ambiente e risultati concreti."
      >
        Corsi di pugilato, <span class="text-brand">Hyrox</span> e PB Hiit
      </SectionHeading>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((s) => (
          <ServiceCard
            icon={s.icon}
            title={s.title}
            description={s.description}
            ctaLabel={s.ctaLabel}
            ctaHref={s.ctaHref}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. PER CHI È -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Per chi è"
        description="Non importa da dove parti. Importa dove vuoi arrivare."
      >
        Un percorso adatto a <span class="text-brand">ogni livello</span>
      </SectionHeading>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {segments.map((s) => (
          <SegmentCard
            title={s.title}
            description={s.description}
            linkLabel={s.linkLabel}
            linkHref={s.linkHref}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. PERCHÉ SCEGLIERCI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Perché noi"
        description="Tecnica, ambiente e mentalità. Non una palestra qualunque, ma una realtà di pugilato con credibilità sportiva e accessibilità locale."
      >
        Perché scegliere <span class="text-brand">Pugilistica Brianza</span>
      </SectionHeading>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {benefits.map((b) => (
          <BenefitItem text={b} />
        ))}
      </div>
    </div>
  </section>

  <!-- 6. COACH -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il coach">
        Una guida tecnica con <span class="text-brand">esperienza reale</span>
      </SectionHeading>

      <CoachBlock
        name="Stefano Rizzo"
        role="Co-fondatore e Head Coach"
        bio="Ex pugile agonista, oggi co-fondatore della palestra e guida tecnica di tutti i percorsi. Certificato FIPE, con esperienza nella light-boxe e nella boxe dilettantistica. Segue personalmente ogni iscritto, dai principianti a chi prepara le gare."
        tags={[
          "Ex pugile agonista",
          "Certificato FIPE",
          "Light-boxe",
          "Boxe dilettantistica",
        ]}
        photo={stefanoPhoto}
        photoAlt="Stefano Rizzo, co-fondatore e head coach di Pugilistica Brianza"
      />
    </div>
  </section>

  <!-- 7. GALLERY -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="La palestra">
        Dove ti <span class="text-brand">alleni</span>
      </SectionHeading>

      <Gallery />
    </div>
  </section>

  <!-- 8. PROVA GRATUITA CTA -->
  <div class="pb-section--alt">
    <CtaBlock
      description="Allenati a Barlassina in una palestra di pugilato vera, con percorsi chiari e ambiente accogliente."
      subdesc="Nessun impegno. Vieni, prova e decidi."
      ctaPrimary={{ label: "Scrivici su WhatsApp", href: whatsappHref }}
    >
      Prova <span class="text-brand">gratuita</span>
    </CtaBlock>
  </div>

  <!-- 9. RECENSIONI (slider orizzontale CSS scroll-snap) -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <div class="flex items-end justify-between mb-12 gap-6 [&>.pb-section-heading]:mb-0">
        <SectionHeading
          topline="Recensioni"
          description="Chi ci sceglie, resta."
        >
          Cosa dicono di <span class="text-brand">noi</span>
        </SectionHeading>

        <!-- Frecce di navigazione (visibili solo da sm in su) -->
        <div class="hidden sm:flex gap-2 shrink-0 mb-1">
          <button
            type="button"
            id="reviews-prev"
            aria-label="Recensioni precedenti"
            class="w-10 h-10 rounded-full border border-pb-border-medium
                   flex items-center justify-center text-pb-text-muted
                   hover:border-brand hover:text-brand transition-colors duration-200
                   disabled:opacity-30 disabled:cursor-not-allowed"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button
            type="button"
            id="reviews-next"
            aria-label="Recensioni successive"
            class="w-10 h-10 rounded-full border border-pb-border-medium
                   flex items-center justify-center text-pb-text-muted
                   hover:border-brand hover:text-brand transition-colors duration-200
                   disabled:opacity-30 disabled:cursor-not-allowed"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Slider container -->
      <div
        id="reviews-slider"
        class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide"
      >
        {reviews.map((r) => (
          <div class="w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] flex-none snap-start">
            <ReviewCard
              text={r.text}
              author={r.author}
              source={r.source}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Script navigazione slider recensioni -->
  <script is:inline>
  (function () {
    const slider = document.getElementById("reviews-slider");
    const prev = document.getElementById("reviews-prev");
    const next = document.getElementById("reviews-next");
    if (!slider || !prev || !next) return;

    /** Larghezza di una card + gap per calcolare lo scroll */
    function getScrollStep() {
      const card = slider.querySelector(":scope > div");
      if (!card) return 300;
      const style = getComputedStyle(slider);
      const gap = parseFloat(style.gap) || 24;
      return card.offsetWidth + gap;
    }

    function updateButtons() {
      prev.disabled = slider.scrollLeft <= 1;
      next.disabled = slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 1;
    }

    prev.addEventListener("click", function () {
      slider.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
    });
    next.addEventListener("click", function () {
      slider.scrollBy({ left: getScrollStep(), behavior: "smooth" });
    });

    slider.addEventListener("scroll", updateButtons, { passive: true });
    updateButtons();
  })();
  </script>

  <!-- 10. LOCAL -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="Dove siamo">
        Ci trovi a <span class="text-brand">Barlassina</span>
      </SectionHeading>

      <LocalSection
        address={`${siteInfo.address}<br>${siteInfo.cap} ${siteInfo.city} (${siteInfo.province})`}
        addressLabel={siteInfo.name}
        zones={zones}
        details={localDetails}
        mapEmbedUrl={siteInfo.mapEmbedUrl}
        mapExternalUrl={siteInfo.mapExternalUrl}
        mapPreviewSrc={siteInfo.mapPreviewSrc}
        mapLabel={siteInfo.shortName}
      />

      <div class="mt-8">
        <a href="/contatti/" class="pb-btn-text">
          Vai alla pagina Contatti →
        </a>
      </div>
    </div>
  </section>

  <!-- 11. FAQ -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="FAQ">
        Domande <span class="text-brand">frequenti</span>
      </SectionHeading>

      <FaqAccordion items={faqItems} defaultOpen={0} withSchema />

      <div class="mt-8">
        <a href="/faq/" class="pb-btn-text">Tutte le domande frequenti →</a>
      </div>
    </div>
  </section>

  <!-- 12. CTA FINALE -->
  <div class="pb-section--alt">
    <CtaBlock
      description="Allenati a Barlassina in una palestra di pugilato vera, con percorsi chiari, ambiente accogliente e accesso semplice tramite prova gratuita."
      ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
    >
      Inizia ad allenarti<br />con <span class="text-brand">noi</span>
    </CtaBlock>
  </div>
</BaseLayout>
