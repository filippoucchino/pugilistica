---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DefinitionGrid from "../components/DefinitionGrid.astro";
import TargetCard from "../components/TargetCard.astro";
import BenefitItem from "../components/BenefitItem.astro";
import LessonStep from "../components/LessonStep.astro";
import WhyUsCard from "../components/WhyUsCard.astro";
import InfoRow from "../components/InfoRow.astro";
import PricingCard from "../components/PricingCard.astro";
import Gallery from "../components/Gallery.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import LocalSection from "../components/LocalSection.astro";
import CtaBlock from "../components/CtaBlock.astro";
import CoachBlock from "../components/CoachBlock.astro";
import CourseScheduleMini from "../components/CourseScheduleMini.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { trustItems, localDetails, zonesInfo, siteInfo, buildWhatsappHref } from "@/data/shared";
import { buildPageSchema, buildGymRef, buildWebPage, buildBreadcrumb, buildFaqPage, buildCourse, buildVideo } from "@/data/schema";

// Foto coach: importate come ES module così Astro le ottimizza in build (WebP, dimensioni esplicite).
import stefanoPhoto from "../assets/images/bio/stefano-rizzo.jpg";
import morenoPhoto from "../assets/images/bio/moreno-bragato.jpg";

// Foto gallery: importate come ES module per ottimizzazione automatica (WebP, width/height, compressione).
import galPugileAngolo from "../assets/images/pugilato/New/pugile-angolo-ring-pugilistica-brianza.jpg";
import galAreaSacchi from "../assets/images/pugilato/New/area-sacchi-allenamento-pugilistica-brianza.jpg";
import galRingPalestra from "../assets/images/pugilato/New/ring-palestra-pugilistica-brianza.jpg";
import galCordeRing from "../assets/images/pugilato/New/corde-ring-brandizzate-pugilistica-brianza.jpg";
import galCoachMemorial from "../assets/images/pugilato/New/coach-memorial-antiga-pisapia.jpg";
import galAbbraccioTrofeo from "../assets/images/pugilato/New/abbraccio-coach-pugile-trofeo-barlassina.jpg";
import galMartinaColpitori from "../assets/images/pugilato/New/martina-caruso-allenamento-colpitori-pugilistica-brianza.jpg";
import galSacchiArea from "../assets/images/pugilato/New/sacchi-pesanti-area-pugilato-pugilistica-brianza.jpg";

// Unica CTA della pagina: WhatsApp al coach con messaggio precompilato specifico per il corso.
const whatsappHref = buildWhatsappHref(
  "Ciao, vorrei prenotare una prova gratuita per il corso di pugilato."
);

/* — Dati pagina — */

const definitionItems = [
  {
    title: "Tecnica e coordinazione",
    description:
      "Impari i fondamentali della boxe (guardia, jab, cross, gancio, montante, spostamenti, schivate e parate) con progressioni chiare e graduali guidate dal coach.",
  },
  {
    title: "Preparazione atletica",
    description:
      "Ogni lezione di pugilato alla Pugilistica Brianza include lavoro specifico su resistenza cardiovascolare, velocità esplosiva e forza funzionale: elementi centrali per reggere i round sul ring.",
  },
  {
    title: "Disciplina e mentalità",
    description:
      "La boxe sviluppa concentrazione, gestione dello stress, autocontrollo e fiducia in sé. Benefici che l'atleta porta con sé dentro e fuori dalla palestra, nella vita quotidiana e sul ring.",
  },
  {
    title: "Allenamento completo",
    description:
      "Cardio, tono muscolare, agilità, riflessi e coordinazione motoria in un unico percorso, con il supporto dei coach Stefano Rizzo e Moreno Bragato, entrambi ex pugili agonisti.",
  },
];

const targets = [
  {
    icon: '<circle cx="12" cy="8" r="4"/><path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/>',
    title: "Principianti",
    description:
      "Non hai mai fatto boxe? La maggior parte degli iscritti della Pugilistica Brianza è partita da zero. Il coach ti guida passo dopo passo nei fondamentali: guardia, colpi e spostamenti.",
  },
  {
    icon: '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>',
    title: "Donne",
