];

const infoRows = [
  {
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
    text: "<strong>Quando si svolge</strong>Il corso di pugilato alla Pugilistica Brianza si tiene dal lunedì al sabato, con fasce al mattino, in pausa pranzo e la sera. Lezioni dedicate per adulti, Kids Boxe (8–12 anni) e Boxe Agonisti. Gli orari completi sono nella tabella qui sotto.",
  },
  {
    icon: '<path d="M5 3l14 9-14 9V3z"/>',
    text: "<strong>Prova gratuita</strong>La prima lezione di pugilato è gratuita e senza impegno. Vieni, allenati con il gruppo e decidi con calma se iscriverti.",
  },
  {
    icon: '<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>',
    text: "<strong>Come iscriversi</strong>Per iscriverti al corso di pugilato scrivici su WhatsApp o passa direttamente in palestra a Barlassina. L'iscrizione è semplice e veloce: serve solo il certificato medico sportivo non agonistico, richiesto dalla seconda lezione in poi.",
  },
  {
    icon: '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
    text: "<strong>Cosa portare</strong>Alla prima lezione di pugilato servono abbigliamento sportivo comodo, scarpe da ginnastica pulite e una bottiglia d'acqua. Guantoni e fasce da boxe sono forniti dalla palestra per la prova gratuita.",
  },
];

const faqItems = [
  {
    question: "Posso iniziare il corso di pugilato anche se sono principiante?",
    answer:
      "Sì, puoi iniziare il corso di pugilato alla Pugilistica Brianza anche se sei principiante assoluto. La maggior parte degli iscritti ha iniziato da zero, senza alcuna esperienza pregressa nella boxe. Il corso è strutturato per accogliere tutti i livelli, dai principianti assoluti a chi ha già esperienza sul ring. Il coach adatta gli esercizi in base al livello di ciascun atleta.",
  },
  {
    question: "Il corso di pugilato è adatto anche alle donne?",
    answer:
      "Sì, il corso di pugilato può essere frequentato anche dalle donne. Il corso di pugilato di Pugilistica Brianza è misto e pensato per essere inclusivo. Alleniamo donne di ogni età e livello, in un ambiente rispettoso e motivante. La boxe è uno degli allenamenti più completi anche per obiettivi di fitness e benessere.",
  },
  {
    question: "Da che età si può iniziare a fare pugilato?",
    answer:
      "Alla Pugilistica Brianza si può iniziare a fare pugilato a partire dagli 8 anni. Il corso di pugilato per bambini e ragazzi è aperto dagli 8 anni in su, con allenamento adattato all'età e al livello di ciascuno, attenzione alla sicurezza e un approccio didattico orientato alla crescita graduale dell'atleta.",
  },
  {
    question: "Fate anche pugilato agonistico?",
    answer:
      "Sì, alla Pugilistica Brianza facciamo anche pugilato agonistico. Siamo affiliati alla Federazione Pugilistica Italiana (FPI) e gareggiamo regolarmente nella light-boxe e nella boxe dilettantistica. Se vuoi crescere in ambito agonistico, costruiamo un percorso di allenamento su misura con tecnica, preparazione atletica e sparring specifici per l'incontro.",
  },
  {
    question: "Posso prenotare una prova gratuita di pugilato?",
    answer:
      "Sì, puoi prenotare una prova gratuita del corso di pugilato alla Pugilistica Brianza di Barlassina. La prima lezione è gratuita e senza impegno: vieni, allenati con il gruppo e decidi con calma se iscriverti. Puoi prenotare la prova scrivendoci su WhatsApp o passando direttamente in palestra in Via Giovanni Segantini 29.",
  },
  {
    question: "Cosa devo portare alla prima lezione di pugilato?",
    answer:
      "Alla prima lezione di pugilato alla Pugilistica Brianza bastano abbigliamento sportivo comodo e scarpe da ginnastica pulite per l'interno. Guantoni e fasce da boxe sono forniti dalla palestra per la prova gratuita, così non devi comprare attrezzatura prima di decidere se iscriverti. Abbiamo spogliatoi e docce a disposizione dopo l'allenamento.",
  },
  {
    question: "Quante volte a settimana è consigliato allenarsi?",
    answer:
      "Alla Pugilistica Brianza consigliamo 2-3 allenamenti di pugilato a settimana per risultati costanti nella tecnica e nella preparazione atletica. Il coach ti aiuterà a trovare la frequenza giusta in base ai tuoi obiettivi, al tuo livello di partenza e alla disponibilità di tempo.",
  },
];

const pageSchema = buildPageSchema(
  buildGymRef(),
  buildWebPage(
    "/pugilato/",
    "Corso di Pugilato a Barlassina | Pugilistica Brianza",
    "Scopri il corso di pugilato a Barlassina: per chi è adatto, come si svolge, benefici, prova gratuita e contatti di Pugilistica Brianza.",
  ),
  buildCourse({
    name: "Corso di Pugilato",
    slug: "pugilato",
    description: "Corso di pugilato a Barlassina per principianti, donne, ragazzi dagli 8 anni, amatori e agonisti. Tecnica, preparazione atletica e sparring con coach ex agonista.",
    price: "50",
    coaches: [
      { name: "Stefano Rizzo", slug: "stefano-rizzo" },
      { name: "Moreno Bragato", slug: "moreno-bragato" },
    ],
    scheduleTags: ["boxe", "boxe-agonisti", "kids-boxe"],
  }),
  buildVideo(
    {
      name: "Allenamento di pugilato alla Pugilistica Brianza di Barlassina",
      description: "Video di un allenamento di pugilato alla Pugilistica Brianza di Barlassina: tecnica, sacco, sparring e preparazione atletica.",
      mp4Path: "/videos/corso-pugilato-pugilistica-brianza-barlassina.mp4",
      posterPath: "/videos/corso-pugilato-pugilistica-brianza-barlassina.webp",
      uploadDate: "2026-04-14T12:00:00+02:00",
    },
    "pugilato",
  ),
  buildFaqPage(faqItems, "pugilato"),
  buildBreadcrumb([{ name: "Pugilato", href: "/pugilato/" }]),
);
---

<BaseLayout
  title="Corso di Pugilato a Barlassina | Pugilistica Brianza"
  description="Scopri il corso di pugilato a Barlassina: per chi è adatto, come si svolge, benefici, prova gratuita e contatti di Pugilistica Brianza."
  schema={pageSchema}
>
  <!-- TOC — barra pillole sticky (sopra la hero) -->
  <TableOfContents items={[
    { id: "il-corso",      label: "Il corso di boxe" },
    { id: "per-chi",       label: "Per chi è" },
    { id: "benefici",      label: "Benefici" },
    { id: "la-lezione",    label: "La lezione" },
    { id: "i-coach",       label: "I coach" },
    { id: "perche-noi",    label: "Perché sceglierci" },
    { id: "info-pratiche", label: "Info pratiche" },
    { id: "gallery",       label: "Gli spazi" },
    { id: "faq",           label: "Domande frequenti" },
    { id: "dove-siamo",    label: "Dove siamo" },
  ]} />

  <!-- 1. HERO -->
  <Hero
    topline="Corso di pugilato alla Pugilistica Brianza"
    subtitle="Il corso di pugilato alla Pugilistica Brianza di Barlassina (MB) è aperto a principianti, donne, ragazzi dagli 8 anni, amatori e pugili agonisti. Tecnica, preparazione atletica e sparring leggero in una palestra con ring regolamentare, coach FPI (Maestro 2° livello) e prima lezione di prova gratuita."
    watermark="BOXE"
    ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
  >
    Corso di <span class="text-brand">Pugilato</span><br />a Barlassina in Brianza
  </Hero>

  <!-- TRUST BAR -->
  <div class="bg-surface border-b border-pb-border-default">
    <div class="pb-container">
      <TrustBar items={trustItems} />
    </div>
  </div>

  <!-- 2. CHE COS'È IL PUGILATO -->
  <section id="il-corso" class="pb-section pb-toc-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il corso">
        Che cos'è il <span class="text-brand">Pugilato?</span>
      </SectionHeading>
      <DefinitionGrid
        introText="Il pugilato (o boxe) è uno sport di combattimento che allena corpo e mente attraverso tecnica, coordinazione, timing e preparazione atletica specifica. Alla Pugilistica Brianza di Barlassina lo insegniamo in modo strutturato, con progressioni graduali adatte a ogni livello: da chi vuole scoprirlo per la prima volta a chi punta a salire sul ring in gara, passando per chi lo pratica come fitness e disciplina."
        items={definitionItems}
        video={{
          mp4: "/videos/corso-pugilato-pugilistica-brianza-barlassina.mp4",
          webm: "/videos/corso-pugilato-pugilistica-brianza-barlassina.webm",
          poster: "/videos/corso-pugilato-pugilistica-brianza-barlassina.webp",
          title: "Allenamento di pugilato alla Pugilistica Brianza di Barlassina",
        }}
      />
    </div>
  </section>

  <!-- 3. PER CHI È ADATTO -->
  <section id="per-chi" class="pb-section pb-section--alt pb-toc-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Per chi"
        description="Il corso di pugilato è pensato per accogliere profili diversi, dai principianti assoluti ai pugili agonisti, con un approccio che si adatta al livello tecnico, all'età e agli obiettivi di ciascun atleta."
      >
        Per chi è adatto il corso di <span class="text-brand">Pugilato?</span>
      </SectionHeading>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 list-none pl-0 m-0">
        {targets.map((t) => (
          <TargetCard icon={t.icon} title={t.title} description={t.description} />
        ))}
      </ul>

      <!-- Griglia 4 thumbnail video: slider su mobile, griglia su tablet/desktop -->
      <div class="video-thumb-slider-wrapper mt-8">
        <button type="button" class="video-thumb-slider-nav video-thumb-slider-nav--prev" aria-label="Video precedente">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="video-thumb-slider-nav video-thumb-slider-nav--next" aria-label="Video successivo">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
        </button>
        <div class="video-thumb-grid grid grid-cols-2 sm:grid-cols-4 gap-4">
        <button type="button" class="video-thumb-btn" data-dialog="dlg-v1" aria-label="Guarda il video: la boxe è uno sport per tutti">
          <img src="/videos/boxe-sport-per-tutti-pugilistica-brianza-barlassina.webp" alt="La boxe è uno sport per tutti alla Pugilistica Brianza" class="video-thumb-img" loading="lazy" />
          <div class="video-thumb-play" aria-hidden="true"><svg viewBox="0 0 80 80" width="56" height="56"><circle cx="40" cy="40" r="36" fill="rgba(0,0,0,0.5)"/><polygon points="32,24 60,40 32,56" fill="white"/></svg></div>
        </button>
        <button type="button" class="video-thumb-btn" data-dialog="dlg-v2" aria-label="Guarda il video: boxe disciplina e mentalità">
          <img src="/videos/boxe-disciplina-mentalita-pugilistica-brianza-barlassina.webp" alt="Boxe: disciplina e mentalità alla Pugilistica Brianza" class="video-thumb-img" loading="lazy" />
