      <style>
        .video-thumb-btn {
          position: relative; width: 100%; aspect-ratio: 1 / 1;
          overflow: hidden; border-radius: 8px; cursor: pointer;
          border: none; padding: 0; background: none;
        }
        .video-thumb-btn:focus-visible { outline: 2px solid #c41e1e; outline-offset: 2px; }
        .video-thumb-img {
          width: 100%; height: 100%; object-fit: cover; display: block;
          transition: transform 300ms ease;
        }
        .video-thumb-btn:hover .video-thumb-img { transform: scale(1.05); }
        .video-thumb-play {
          position: absolute; inset: 0; display: flex;
          align-items: center; justify-content: center;
          background: rgba(0,0,0,0.2); transition: background 200ms;
        }
        .video-thumb-btn:hover .video-thumb-play { background: rgba(0,0,0,0.35); }

        .video-lightbox {
          position: fixed; inset: 0; width: 100vw; height: 100vh;
          max-width: none; max-height: none; margin: 0; padding: 0;
          border: none; background: rgba(10,10,10,0.95); z-index: 100;
        }
        .video-lightbox::backdrop { background: transparent; }
        .video-lightbox[open] {
          display: flex; justify-content: center; align-items: center;
          animation: vl-fade-in 200ms ease-out;
        }
        @keyframes vl-fade-in { from { opacity: 0; } to { opacity: 1; } }
        .video-lightbox-overlay {
          display: flex; justify-content: center; align-items: center;
          width: 100%; height: 100%; pointer-events: none;
        }
        .video-lightbox-overlay > * { pointer-events: auto; }
        .video-lightbox-video { max-width: 90vw; max-height: 85vh; border-radius: 4px; }
        .video-lightbox-close {
          position: fixed; top: 16px; right: 16px; z-index: 10;
          background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
          border-radius: 50%; width: 44px; height: 44px; display: flex;
          align-items: center; justify-content: center; color: white;
          cursor: pointer; transition: background 200ms;
        }
        .video-lightbox-close:hover,
        .video-lightbox-close:focus-visible { background: rgba(255,255,255,0.25); }

        /* Slider thumbnail video — mobile */
        .video-thumb-slider-wrapper { position: relative; }
        .video-thumb-slider-nav {
          display: none; position: absolute; top: 50%; transform: translateY(-50%);
          z-index: 2; width: 36px; height: 36px; border-radius: 50%;
          align-items: center; justify-content: center;
          background: rgba(10,10,10,0.65); border: 1px solid rgba(255,255,255,0.18);
          color: white; cursor: pointer; padding: 0;
        }
        .video-thumb-slider-nav--prev { left: 10px; }
        .video-thumb-slider-nav--next { right: 10px; }
        .video-thumb-slider-counter {
          display: none; text-align: center; margin-top: 10px;
          font-size: 13px; color: rgba(255,255,255,0.5);
        }
        @media (max-width: 639px) {
          .video-thumb-grid {
            display: flex; flex-wrap: nowrap; overflow-x: scroll;
            scroll-snap-type: x mandatory; scroll-behavior: smooth;
            scrollbar-width: none; -ms-overflow-style: none; gap: 0;
          }
          .video-thumb-grid::-webkit-scrollbar { display: none; }
          .video-thumb-grid > * { flex: 0 0 100%; scroll-snap-align: start; }
          .video-thumb-slider-nav { display: flex; }
          .video-thumb-slider-counter { display: block; }
        }
      </style>

      <script is:inline>
        (function() {
          document.querySelectorAll('.video-thumb-btn').forEach(function(btn) {
            var dialogId = btn.getAttribute('data-dialog');
            var dialog = document.getElementById(dialogId);
            if (!dialog) return;
            var video = dialog.querySelector('video');
            var closeBtn = dialog.querySelector('.video-lightbox-close');

            btn.addEventListener('click', function() {
              dialog.showModal();
              document.body.style.overflow = 'hidden';
            });

            function closeDialog() {
              video.load();
              dialog.close();
              document.body.style.overflow = '';
            }

            closeBtn.addEventListener('click', closeDialog);
            var mousedownTarget = null;
            dialog.addEventListener('mousedown', function(e) { mousedownTarget = e.target; });
            dialog.addEventListener('click', function(e) {
              if (e.target === dialog && mousedownTarget === dialog) closeDialog();
            });
            dialog.addEventListener('close', function() {
              video.load();
              document.body.style.overflow = '';
            });
          });
        })();

        (function() {
          var wrapper = document.querySelector('.video-thumb-slider-wrapper');
          if (!wrapper) return;
          var grid = wrapper.querySelector('.video-thumb-grid');
          var prevBtn = wrapper.querySelector('.video-thumb-slider-nav--prev');
          var nextBtn = wrapper.querySelector('.video-thumb-slider-nav--next');
          var counter = document.querySelector('.video-thumb-slider-counter');
          var thumbs = grid ? grid.querySelectorAll('.video-thumb-btn') : [];
          var slideIndex = 0;
          var scrollTimer;
          function slideTo(index) {
            var total = thumbs.length;
            slideIndex = ((index % total) + total) % total;
            grid.scrollTo({ left: slideIndex * grid.offsetWidth, behavior: 'smooth' });
            if (counter) counter.textContent = (slideIndex + 1) + ' / ' + total;
          }
          if (prevBtn) prevBtn.addEventListener('click', function() { slideTo(slideIndex - 1); });
          if (nextBtn) nextBtn.addEventListener('click', function() { slideTo(slideIndex + 1); });
          if (grid) {
            grid.addEventListener('scroll', function() {
              clearTimeout(scrollTimer);
              scrollTimer = setTimeout(function() {
                slideIndex = Math.round(grid.scrollLeft / grid.offsetWidth);
                if (counter) counter.textContent = (slideIndex + 1) + ' / ' + thumbs.length;
              }, 80);
            }, { passive: true });
          }
        })();
      </script>
    </div>
  </section>

