  },
  {
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>',
    title: "Ring regolamentare per sparring",
    description:
      "Qui non c'è un angolo con un sacco: c'è un ring regolamentare da boxe, sacchi pesanti, colpitori e attrezzatura completa. L'ambiente giusto per imparare il pugilato sul serio.",
