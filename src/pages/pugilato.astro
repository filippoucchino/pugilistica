---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DefinitionGrid from "../components/DefinitionGrid.astro";
import TargetCard from "../components/TargetCard.astro";
import BenefitItem from "../components/BenefitItem.astro";
import LessonStep from "../components/LessonStep.astro";
import WhyUsCard from "../components/WhyUsCard.astro";
import InfoRow from "../components/InfoRow.astro";
import PricingCard from "../components/PricingCard.astro";
import Gallery from "../components/Gallery.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import LocalSection from "../components/LocalSection.astro";
import CtaBlock from "../components/CtaBlock.astro";
import CoachBlock from "../components/CoachBlock.astro";
import CourseScheduleMini from "../components/CourseScheduleMini.astro";
import { trustItems, localDetails, zones, siteInfo, buildWhatsappHref } from "@/data/shared";
import { buildPageSchema, buildGymRef, buildWebPage, buildBreadcrumb, buildFaqPage, buildCourse, buildVideo } from "@/data/schema";

// Foto coach: importate come ES module così Astro le ottimizza in build (WebP, dimensioni esplicite).
import stefanoPhoto from "../assets/images/bio/stefano-rizzo.jpg";
import morenoPhoto from "../assets/images/bio/moreno-bragato.jpg";

// Foto gallery: importate come ES module per ottimizzazione automatica (WebP, width/height, compressione).
import galPanoramica from "../assets/images/pugilato/palestra-panoramica-ring-pugilistica-brianza.jpg";
import galRing from "../assets/images/pugilato/ring-boxe-pugilistica-brianza-barlassina.jpg";
import galAllenamento from "../assets/images/pugilato/allenamento-sacchi-pugili-pugilistica-brianza.jpg";
import galSacchi from "../assets/images/pugilato/sacchi-pesanti-boxe-pugilistica-brianza.jpg";
import galSalaSacchi from "../assets/images/pugilato/sala-sacchi-panoramica-pugilistica-brianza.jpg";
import galRingSacco from "../assets/images/pugilato/ring-sacco-rosso-pugilistica-brianza.jpg";
import galAngolo from "../assets/images/pugilato/angolo-ring-corde-pugilistica-brianza.jpg";
import galIngresso from "../assets/images/pugilato/ingresso-reception-pugilistica-brianza.jpg";

// Unica CTA della pagina: WhatsApp al coach con messaggio precompilato specifico per il corso.
const whatsappHref = buildWhatsappHref(
  "Ciao, vorrei prenotare una prova gratuita per il corso di pugilato."
);

/* — Dati pagina — */

const definitionItems = [
  { title: "Tecnica e coordinazione", description: "Impari i fondamentali della boxe — guardia, colpi, spostamenti, difese — con progressioni chiare e graduali." },
  { title: "Preparazione atletica", description: "Ogni lezione include lavoro su resistenza, velocità e forza esplosiva, elementi centrali del pugilato." },
  { title: "Disciplina e mentalità", description: "La boxe sviluppa concentrazione, gestione dello stress e fiducia in sé, dentro e fuori dalla palestra." },
  { title: "Allenamento completo", description: "Cardio, tono muscolare, agilità e coordinazione in un unico percorso, con il supporto di un coach ex agonista." },
];

const targets = [
  { icon: '<circle cx="12" cy="8" r="4"/><path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/>', title: "Principianti", description: "Non hai mai fatto boxe? La maggior parte dei nostri iscritti è partita da zero. Il coach ti guida passo dopo passo." },
  { icon: '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>', title: "Donne", description: "Corso misto e inclusivo. Alleniamo donne di ogni età in un ambiente rispettoso, motivante e sicuro." },
  { icon: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>', title: "Ragazzi 8+", description: "L'età minima per il corso di pugilato è 8 anni. L'allenamento è adattato per garantire sicurezza e crescita graduale." },
  { icon: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>', title: "Amatori", description: "Vuoi allenarti con costanza, migliorare la tecnica e stare in forma? Il percorso amatoriale è fatto per te." },
  { icon: '<path d="M6 9l6 6 6-6"/><path d="M6 4h12M6 20h12"/>', title: "Agonisti", description: "Affiliati FPI, gareggiamo nella light-boxe e boxe dilettantistica. Costruiamo percorsi agonistici su misura." },
];

const benefits = [
  "<strong>Migliora</strong> resistenza cardiovascolare e condizione fisica generale",
  "<strong>Sviluppa</strong> forza esplosiva, velocità e coordinazione motoria",
  "<strong>Aumenta</strong> concentrazione, disciplina e gestione dello stress",
  "<strong>Aiuta</strong> dimagrimento, tono muscolare e benessere complessivo",
  "<strong>Costruisce</strong> fiducia in sé, costanza e mentalità forte",
  "<strong>Rafforza</strong> agilità, riflessi e consapevolezza del corpo",
];

const steps = [
  { title: "Riscaldamento", description: "Attivazione generale con corda, mobilità articolare e lavoro cardiovascolare leggero. Prepara il corpo all'intensità della lezione." },
  { title: "Tecnica e fondamentali", description: "Guardia, spostamenti, combinazioni di colpi, schivate e parate. Per i principianti si lavora sui fondamentali; per gli avanzati su combinazioni e strategie." },
  { title: "Lavoro al sacco e a coppie", description: "Applicazione della tecnica su sacchi, colpitori e guanti. Lavoro a coppie per sviluppare timing, distanza e reattività." },
  { title: "Preparazione atletica", description: "Circuiti di forza, velocità e resistenza specifici per il pugilato. Esercizi mirati per migliorare la performance e la tenuta fisica." },
  { title: "Defaticamento e chiusura", description: "Stretching, respirazione e ritorno alla calma. Il coach dà feedback individuali sulla lezione e sugli aspetti su cui lavorare." },
];

const whyUs = [
  { icon: '<circle cx="12" cy="8" r="4"/><path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/>', title: "Coach ex pugile agonista", description: "Stefano Rizzo è Maestro di 2° livello FPI ed ex pugile agonista. In palestra non trovi teoria: trovi esperienza reale sul ring, applicata in ogni lezione." },
  { icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>', title: "Ring regolamentare per sparring", description: "Non un angolo con un sacco: abbiamo un ring vero, sacchi pesanti e attrezzatura completa. L'ambiente giusto per imparare la boxe sul serio." },
  { icon: '<path d="M6 9H4.5a2.5 2.5 0 010-5H6"/><path d="M18 9h1.5a2.5 2.5 0 000-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0012 0V2z"/>', title: "Percorsi agonistici FPI", description: "Se vuoi gareggiare, siamo affiliati FPI e prepariamo atleti per light-boxe e boxe dilettantistica. Costruiamo percorsi agonistici su misura con target concreti." },
  { icon: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>', title: "Aperti a tutti, dagli 8 anni in su", description: "Principianti assoluti, donne, ragazzi dagli 8 anni, amatori e agonisti: il corso accoglie tutti i livelli con progressioni graduate e un approccio inclusivo." },
  { icon: '<path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>', title: "Tecnica prima di tutto", description: "Non si tratta di menare: si tratta di imparare a muoversi, leggere l'avversario e reagire. L'approccio è didattico e progressivo, dalla guardia allo sparring." },
  { icon: '<path d="M5 3l14 9-14 9V3z"/>', title: "Prova gratuita senza impegno", description: "Vieni, allenati con il gruppo e decidi con calma. Nessun vincolo, nessun pagamento anticipato." },
];

const infoRows = [
  { icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>', text: "<strong>Quando si svolge</strong>Il corso di pugilato si tiene dal lunedì al sabato, con lezioni per adulti, bambini (6–12 anni) e agonisti. Trovi gli orari nella tabella qui sotto." },
  { icon: '<path d="M5 3l14 9-14 9V3z"/>', text: "<strong>Prova gratuita</strong>La prima lezione è gratuita e senza impegno. Vieni, allenati e decidi con calma." },
  { icon: '<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>', text: "<strong>Come iscriversi</strong>Contatto diretto: scrivici su WhatsApp o passa in palestra. L'iscrizione è semplice e veloce." },
  { icon: '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>', text: "<strong>Cosa portare</strong>Abbigliamento sportivo, scarpe da ginnastica. Guantoni e fasce disponibili in palestra per la prova." },
];

const faqItems = [
  { question: "Posso iniziare il corso di pugilato anche se sono principiante?", answer: "Assolutamente sì. La maggior parte dei nostri iscritti ha iniziato da zero. Il corso è strutturato per accogliere tutti i livelli, dai principianti assoluti a chi ha già esperienza. Il coach adatta gli esercizi in base al livello di ciascuno." },
  { question: "Il corso di pugilato è adatto anche alle donne?", answer: "Sì, il corso è misto e pensato per essere inclusivo. Alleniamo donne di ogni età e livello, in un ambiente rispettoso e motivante. La boxe è uno degli allenamenti più completi anche per obiettivi di fitness e benessere." },
  { question: "Da che età si può iniziare a fare pugilato?", answer: "Il corso di pugilato è aperto dagli 8 anni in su. L'allenamento è adattato all'età e al livello del ragazzo, con attenzione alla sicurezza e alla crescita graduale." },
  { question: "Fate anche pugilato agonistico?", answer: "Sì, siamo affiliati alla Federazione Pugilistica Italiana (FPI) e gareggiamo nella light-boxe e nella boxe dilettantistica. Se vuoi crescere in ambito agonistico, possiamo costruire un percorso su misura per te." },
  { question: "Posso prenotare una prova gratuita di pugilato?", answer: "Certo. La prova gratuita è senza impegno: vieni, allenati con noi e decidi con calma. Puoi prenotarla scrivendoci su WhatsApp o passando direttamente in palestra a Barlassina." },
  { question: "Cosa devo portare alla prima lezione di pugilato?", answer: "Per la prima lezione bastano abbigliamento sportivo comodo e scarpe da ginnastica. Guantoni e fasce possono essere forniti dalla palestra per la prova. Abbiamo spogliatoi e docce a disposizione." },
  { question: "Quante volte a settimana è consigliato allenarsi?", answer: "Per risultati costanti consigliamo 2-3 allenamenti a settimana. Il coach ti aiuterà a trovare la frequenza giusta in base ai tuoi obiettivi e alla tua disponibilità." },
];

const pageSchema = buildPageSchema(
  buildGymRef(),
  buildWebPage(
    "/pugilato/",
    "Corso di Pugilato a Barlassina | Pugilistica Brianza",
    "Scopri il corso di pugilato a Barlassina: per chi è adatto, come si svolge, benefici, prova gratuita e contatti di Pugilistica Brianza.",
  ),
  buildCourse({
    name: "Corso di Pugilato",
    slug: "pugilato",
    description: "Corso di pugilato a Barlassina per principianti, donne, ragazzi dagli 8 anni, amatori e agonisti. Tecnica, preparazione atletica e sparring con coach ex agonista.",
    price: "50",
    coaches: [
      { name: "Stefano Rizzo", slug: "stefano-rizzo" },
      { name: "Moreno Bragato", slug: "moreno-bragato" },
    ],
    scheduleTags: ["boxe", "boxe-agonisti", "kids-boxe"],
  }),
  buildVideo(
    {
      name: "Allenamento di pugilato alla Pugilistica Brianza di Barlassina",
      description: "Video di un allenamento di pugilato alla Pugilistica Brianza di Barlassina: tecnica, sacco, sparring e preparazione atletica.",
      mp4Path: "/videos/corso-pugilato-pugilistica-brianza-barlassina.mp4",
      posterPath: "/videos/corso-pugilato-pugilistica-brianza-barlassina.webp",
      uploadDate: "2026-04-14T12:00:00+02:00",
    },
    "pugilato",
  ),
  buildFaqPage(faqItems, "pugilato"),
  buildBreadcrumb([{ name: "Pugilato", href: "/pugilato/" }]),
);
---

<BaseLayout
  title="Corso di Pugilato a Barlassina | Pugilistica Brianza"
  description="Scopri il corso di pugilato a Barlassina: per chi è adatto, come si svolge, benefici, prova gratuita e contatti di Pugilistica Brianza."
  schema={pageSchema}
>
  <!-- 1. HERO -->
  <Hero
    topline="Corso di pugilato — Pugilistica Brianza"
    subtitle="Allenati con un percorso adatto a ogni livello, dai principianti agli agonisti, in una palestra con ambiente familiare, coach qualificati e prova gratuita."
    watermark="BOXE"
    ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
  >
    Corso di <span class="text-brand">Pugilato</span><br />a Barlassina in Brianza
  </Hero>

  <!-- TRUST BAR -->
  <div class="bg-surface border-b border-pb-border-default">
    <div class="pb-container">
      <TrustBar items={trustItems} />
    </div>
  </div>

  <!-- 2. CHE COS'È IL PUGILATO -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il corso">
        Che cos'è il <span class="text-brand">Pugilato?</span>
      </SectionHeading>
      <DefinitionGrid
        introText="Il pugilato è uno sport di combattimento che allena corpo e mente attraverso tecnica, coordinazione e preparazione atletica. A Pugilistica Brianza lo insegniamo in modo strutturato, adatto a ogni livello: da chi vuole scoprirlo per la prima volta a chi punta al ring."
        items={definitionItems}
        video={{
          mp4: "/videos/corso-pugilato-pugilistica-brianza-barlassina.mp4",
          webm: "/videos/corso-pugilato-pugilistica-brianza-barlassina.webm",
          poster: "/videos/corso-pugilato-pugilistica-brianza-barlassina.webp",
          title: "Allenamento di pugilato alla Pugilistica Brianza di Barlassina",
        }}
      />
    </div>
  </section>

  <!-- 3. PER CHI È ADATTO -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Per chi"
        description="Il corso è pensato per accogliere profili diversi, con un approccio che si adatta al livello e all'obiettivo di ciascuno."
      >
        Per chi è adatto il corso di <span class="text-brand">Pugilato?</span>
      </SectionHeading>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 list-none pl-0 m-0">
        {targets.map((t) => (
          <TargetCard icon={t.icon} title={t.title} description={t.description} />
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. BENEFICI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Benefici"
        description="Il pugilato è uno degli allenamenti più completi. Ecco cosa sviluppi con la pratica costante."
      >
        I benefici del <span class="text-brand">Pugilato</span>
      </SectionHeading>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none pl-0 m-0">
        {benefits.map((b) => <BenefitItem text={b} />)}
      </ul>
    </div>
  </section>

  <!-- 5. COME SI SVOLGE UNA LEZIONE -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="La lezione"
        description="Ogni lezione dura circa 60–90 minuti ed è strutturata in fasi progressive, adattate al livello del gruppo."
      >
        Come si svolge una lezione di <span class="text-brand">Pugilato?</span>
      </SectionHeading>
      <ol class="flex flex-col list-none pl-0 m-0" style="counter-reset: step;">
        {steps.map((s) => <LessonStep title={s.title} description={s.description} />)}
      </ol>
    </div>
  </section>

  <!-- IL COACH -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="I coach">
        Chi ti guida sul <span class="text-brand">ring</span>
      </SectionHeading>
      <div class="space-y-6">
        <CoachBlock
          name="Stefano Rizzo"
          role="Co-fondatore e Head Coach"
          bio="Ex pugile agonista e Maestro di 2° livello FPI. Nel corso di pugilato Stefano trasferisce la sua esperienza diretta sul ring: tecnica, preparazione e mentalità costruite in anni di boxe agonistica, applicate in ogni lezione ai principianti come ai più avanzati."
          tags={["Ex pugile agonista", "Maestro 2° livello FPI", "Light-boxe", "Boxe dilettantistica"]}
          photo={stefanoPhoto}
          photoAlt="Stefano Rizzo, co-fondatore e head coach di Pugilistica Brianza"
        />
        <CoachBlock
          name="Moreno Bragato"
          role="Tecnico di Pugilato"
          bio="Ex pugile, classe 1956, Moreno affianca Stefano nella preparazione tecnica del corso di pugilato. Porta in palestra decenni di esperienza nel ring, con un approccio attento alla didattica e alla crescita individuale di ogni atleta."
          tags={["Ex pugile", "Tecnico 1° livello FPI"]}
          photo={morenoPhoto}
          photoAlt="Moreno Bragato, tecnico di pugilato di Pugilistica Brianza"
        />
      </div>
    </div>
  </section>

  <!-- CTA INTERMEDIA -->
  <div class="pb-section--alt">
    <CtaBlock
      description="La prova è gratuita e senza impegno. Vieni a Barlassina, allenati con noi e decidi con calma."
      ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
    >
      Vuoi provare una <span class="text-brand">lezione?</span>
    </CtaBlock>
  </div>

  <!-- 6. PERCHÉ SCEGLIERE NOI -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Perché noi"
        description="Pugilistica Brianza non è una palestra generica. È un'ASD nata per il pugilato, con un'identità chiara e un approccio diretto."
      >
        Perché allenarti <span class="text-brand">con noi</span>
      </SectionHeading>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none pl-0 m-0">
        {whyUs.map((w) => (
          <WhyUsCard icon={w.icon} title={w.title} description={w.description} />
        ))}
      </ul>
    </div>
  </section>

  <!-- 7. ORARI, PROVA E ISCRIZIONE -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="Info pratiche">
        Orari, prova e <span class="text-brand">iscrizione</span>
      </SectionHeading>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-10 items-start">
        <ul class="list-none pl-0 m-0">
          {infoRows.map((r) => <InfoRow icon={r.icon} text={r.text} />)}
        </ul>
        <PricingCard
          title="Abbonamento mensile"
          price="€50"
          note="+ Tesseramento annuale €20 (obbligatorio)"
          features={[
            "Accesso illimitato al corso di pugilato",
            "Ingresso singolo: €15 (necessaria visita medica)",
            "Formula Open (tutti i corsi): €90/mese",
            "Prima lezione gratuita",
          ]}
          ctaLabel="Prenota su WhatsApp"
          ctaHref={whatsappHref}
        />
      </div>
      <CourseScheduleMini
        tags={["boxe", "boxe-agonisti", "kids-boxe"]}
        caption="Orari settimanali del corso di pugilato alla Pugilistica Brianza"
      />
    </div>
  </section>

  <!-- 8. GALLERY -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Gallery">
        Guarda <span class="text-brand">l'allenamento</span>
      </SectionHeading>
      <Gallery images={[
        { src: galPanoramica, alt: "Vista panoramica della palestra Pugilistica Brianza: sala sacchi e ring da boxe con bandiere internazionali" },
        { src: galRing, alt: "Ring da boxe della Pugilistica Brianza di Barlassina con bandiera laterale e bandiere internazionali" },
        { src: galAllenamento, alt: "Pugili che si allenano ai sacchi pesanti durante una lezione alla Pugilistica Brianza" },
        { src: galSacchi, alt: "Sacchi pesanti Leone e Combat Sports in fila nella sala boxe della Pugilistica Brianza" },
        { src: galSalaSacchi, alt: "Sala sacchi della Pugilistica Brianza: fila di sacchi pesanti appesi con pavimento rosso" },
        { src: galRingSacco, alt: "Ring da boxe e sacco rosso Leone alla Pugilistica Brianza con logo sul bordo ring" },
        { src: galAngolo, alt: "Dettaglio angolo del ring con corde rosse Pugilistica Brianza e bandiere internazionali" },
        { src: galIngresso, alt: "Ingresso e reception della Pugilistica Brianza: bancone con logo, locandine eventi e scaffali attrezzatura" },
      ]} />
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="FAQ">
        Domande frequenti sul <span class="text-brand">Pugilato</span>
      </SectionHeading>
      <FaqAccordion items={faqItems} defaultOpen={0} />
    </div>
  </section>

  <!-- 10. LOCAL -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Dove siamo">
        Allenati a <span class="text-brand">Barlassina,</span> in Brianza
      </SectionHeading>
      <LocalSection
        address={`${siteInfo.address}<br>${siteInfo.cap} ${siteInfo.city} (${siteInfo.province})`}
        addressLabel={siteInfo.name}
        zones={zones}
        details={localDetails}
        mapEmbedUrl={siteInfo.mapEmbedUrl}
        mapExternalUrl={siteInfo.mapExternalUrl}
        mapPreviewSrc={siteInfo.mapPreviewSrc}
        mapLabel={siteInfo.shortName}
      />
      <div class="mt-8">
        <a href="/contatti/" class="pb-btn-text">Vai alla pagina Contatti →</a>
      </div>
    </div>
  </section>

  <!-- 11. CTA FINALE -->
  <div class="pb-section--alt">
    <CtaBlock
      description="Vieni a Barlassina e prova il corso di pugilato senza impegno. Coach qualificati, ambiente familiare e accesso semplice."
      ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
    >
      Prenota la tua <span class="text-brand">prova gratuita</span>
    </CtaBlock>
  </div>
</BaseLayout>
