---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DefinitionGrid from "../components/DefinitionGrid.astro";
import BenefitItem from "../components/BenefitItem.astro";
import CoachBlock from "../components/CoachBlock.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import LocalSection from "../components/LocalSection.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { trustItems, localDetails, zonesInfo, siteInfo, buildWhatsappHref } from "@/data/shared";
import { buildPageSchema, buildGymRef, buildWebPage, buildBreadcrumb, buildFaqPage, buildService } from "@/data/schema";
import TableOfContents from "../components/TableOfContents.astro";

// Foto coach: importata come ES module così Astro la ottimizza in build (WebP, dimensioni esplicite).
import stefanoPhoto from "../assets/images/bio/stefano-rizzo.jpg";

// Unica CTA della pagina: WhatsApp al coach, con messaggio orientato alla richiesta di info (non prenotazione diretta).
const whatsappHref = buildWhatsappHref(
  "Ciao, vorrei informazioni sulle lezioni private di pugilato."
);

const faqItems = [
  {
    question: "Come funzionano le lezioni private di pugilato?",
    answer:
      "Le lezioni private di pugilato della Pugilistica Brianza sono sessioni individuali 1:1 con il coach Stefano Rizzo (Maestro 2° livello FPI, ex pugile agonista). In ogni sessione privata lavori su tecnica, preparazione atletica o obiettivi specifici con un programma costruito su misura per te, dal principiante assoluto al pugile che prepara un incontro.",
  },
  {
    question: "Qual è la durata di una lezione privata?",
    answer:
      "Ogni lezione privata di pugilato alla Pugilistica Brianza dura circa 60 minuti, interamente dedicati al tuo percorso individuale. Riscaldamento, lavoro tecnico, lavoro al sacco o ai colpitori, preparazione atletica e defaticamento: tutto calibrato sul tuo livello e sui tuoi obiettivi.",
  },
  {
    question: "Posso scegliere gli orari?",
    answer:
      "Sì, gli orari delle lezioni private di pugilato della Pugilistica Brianza sono flessibili e concordati direttamente con il coach Stefano Rizzo via WhatsApp. Puoi fissare sessioni al mattino, in pausa pranzo, nel pomeriggio o alla sera in base alla tua disponibilità e a quella del coach.",
  },
  {
    question: "Le lezioni private sono adatte ai principianti?",
    answer:
      "Sì, le lezioni private di pugilato della Pugilistica Brianza sono ideali anche per i principianti assoluti. Sono il modo più veloce per imparare i fondamentali della boxe con calma (guardia, colpi, spostamenti) prima o in parallelo al corso di gruppo, con il coach che ti segue personalmente lezione dopo lezione.",
  },
  {
    question: "Quanto costano le lezioni private?",
    answer:
      "Il costo delle lezioni private di pugilato della Pugilistica Brianza varia in base alla frequenza e al pacchetto scelto. Contattaci via WhatsApp per un preventivo personalizzato: dicci quante sessioni ti servono e quali sono i tuoi obiettivi, ti rispondiamo con la proposta migliore.",
  },
];

const pageSchema = buildPageSchema(
  buildGymRef(),
  buildWebPage(
    "/lezioni-private-pugilato/",
    "Lezioni Private di Pugilato a Barlassina | Pugilistica Brianza",
    "Lezioni private di pugilato 1:1 a Barlassina con coach ex agonista. Percorso personalizzato, orari flessibili.",
  ),
  buildService({
    name: "Lezioni Private di Pugilato",
    slug: "lezioni-private-pugilato",
    description: "Lezioni private di pugilato 1:1 a Barlassina con coach ex agonista. Percorso personalizzato, orari flessibili.",
    coaches: [{ name: "Stefano Rizzo", slug: "stefano-rizzo" }],
  }),
  buildFaqPage(faqItems, "lezioni-private-pugilato"),
  buildBreadcrumb([{ name: "Lezioni private", href: "/lezioni-private-pugilato/" }]),
);
---

<BaseLayout
  title="Lezioni Private di Pugilato a Barlassina | Pugilistica Brianza"
  description="Lezioni private di pugilato 1:1 a Barlassina con coach ex agonista. Percorso personalizzato, orari flessibili."
  schema={pageSchema}
>
  <TableOfContents items={[
    { id: "il-percorso", label: "Il percorso" },
    { id: "benefici",    label: "Benefici" },
    { id: "il-coach",    label: "Il coach" },
    { id: "faq",         label: "Domande frequenti" },
    { id: "dove-siamo",  label: "Dove siamo" },
  ]} />

  <Hero
    topline="Lezioni private alla Pugilistica Brianza"
    subtitle="Lezioni private di pugilato 1:1 con il coach Stefano Rizzo alla Pugilistica Brianza di Barlassina (MB). Percorso personalizzato su tecnica, preparazione atletica, obiettivi specifici o preparazione gara, con orari flessibili concordati direttamente e programma costruito su misura."
    watermark="1:1"
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: whatsappHref }}
  >
    Lezioni <span class="text-brand">private</span><br />di pugilato
  </Hero>

  <div class="bg-surface border-b border-pb-border-default">
    <div class="pb-container"><TrustBar items={trustItems} /></div>
  </div>

  <section id="il-percorso" class="pb-section pb-toc-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il percorso">
        Cosa sono le lezioni <span class="text-brand">private?</span>
      </SectionHeading>
      <DefinitionGrid
        introText="Le lezioni private di pugilato alla Pugilistica Brianza sono sessioni individuali 1:1 con il coach Stefano Rizzo (Maestro 2° livello FPI, ex pugile agonista). Un percorso su misura per chi vuole lavorare su aspetti specifici della tecnica della boxe, della preparazione atletica o della crescita agonistica, con la massima attenzione del coach e flessibilità di orari."
        items={[
          {
            title: "Allenamento 1:1",
            description:
              "Tutta l'attenzione del coach Stefano Rizzo è dedicata a te, senza distrazioni del gruppo. Ogni sessione di lezione privata è costruita sui tuoi punti di forza tecnici e sulle aree da migliorare, con feedback continuo e immediato sul gesto.",
          },
          {
            title: "Percorso personalizzato",
            description:
              "Obiettivi chiari (tecnica, sparring, fitness pugilistico, preparazione gara), progressione misurabile sessione per sessione. Il programma della lezione privata si adatta ai tuoi tempi e al tuo livello attuale.",
          },
          {
            title: "Orari flessibili",
            description:
              "Gli orari delle lezioni private di pugilato vengono concordati direttamente con il coach via WhatsApp, in base alla tua disponibilità: mattino, pausa pranzo, pomeriggio o sera.",
          },
          {
            title: "Preparazione mirata",
            description:
              "Tecnica avanzata (guardia, jab, cross, gancio, montante, footwork, difese), preparazione a incontri di light-boxe o boxe dilettantistica, miglioramento specifico: nelle lezioni private lavoriamo solo su quello che serve davvero al tuo obiettivo.",
          },
        ]}
      />
    </div>
  </section>

  <section id="benefici" class="pb-section pb-section--alt pb-toc-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Benefici"
        description="I vantaggi delle lezioni private di pugilato rispetto al corso di gruppo: attenzione totale del coach, progressione tecnica più veloce, flessibilità di orari e obiettivi, privacy dell'allenamento."
      >
        I vantaggi di un percorso <span class="text-brand">individuale</span>
      </SectionHeading>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none pl-0 m-0">
        {[
          "<strong>Attenzione totale:</strong> il coach Stefano Rizzo si dedica esclusivamente a te per tutta la sessione di lezione privata",
          "<strong>Progressione accelerata:</strong> impari la tecnica della boxe più velocemente grazie al feedback tecnico continuo sul gesto",
          "<strong>Flessibilità oraria:</strong> orari e frequenza delle lezioni su misura, concordati direttamente con il coach via WhatsApp",
          "<strong>Obiettivi specifici:</strong> tecnica, preparazione agonistica a light-boxe e boxe dilettantistica, o fitness pugilistico puro",
          "<strong>Adatto a tutti i livelli:</strong> principianti assoluti, pugili avanzati, donne, ragazzi dagli 8 anni e agonisti FPI",
          "<strong>Privacy e comfort:</strong> ti alleni senza la pressione del gruppo, al tuo ritmo, con ring e attrezzatura a disposizione",
        ].map((b) => <BenefitItem text={b} />)}
      </ul>
    </div>
  </section>

  <section id="il-coach" class="pb-section pb-toc-section fade-up">
    <div class="pb-container">
      <SectionHeading topline="Il coach">
        Chi ti segue nel percorso <span class="text-brand">privato</span>
      </SectionHeading>
      <CoachBlock
        name="Stefano Rizzo"
        role="Co-fondatore e Head Coach"
        bio="Ex pugile agonista con certificazione FIPE. Nelle lezioni private Stefano applica la sua esperienza diretta per costruire un percorso tecnico e atletico cucito sui tuoi obiettivi."
        tags={["Ex pugile agonista", "Certificato FIPE", "Light-boxe", "Boxe dilettantistica"]}
        photo={stefanoPhoto}
        photoAlt="Stefano Rizzo, co-fondatore e head coach di Pugilistica Brianza"
      />
    </div>
  </section>

  <section id="faq" class="pb-section pb-section--alt pb-toc-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="FAQ"
        description="Le domande più frequenti sulle lezioni private di pugilato: come funzionano, durata di ogni sessione, flessibilità degli orari, adattamento ai principianti e costi personalizzati."
      >
        Domande sulle lezioni <span class="text-brand">private</span>
      </SectionHeading>
      <FaqAccordion items={faqItems} defaultOpen={0} />
    </div>
  </section>

  <section id="dove-siamo" class="pb-section pb-toc-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Dove siamo"
        description="Il tuo allenamento privato di pugilato a Pugilistica Brianza si svolge in Via Giovanni Segantini 29 a Barlassina (MB). Chi sceglie il percorso 1:1 con il coach arriva da tutta la zona: Cogliate, Seveso, Meda, Lissone, Seregno, Desio, Cesano Maderno e Muggiò."
      >
        Allenati a <span class="text-brand">Barlassina</span>
      </SectionHeading>
      <LocalSection
        address={`${siteInfo.address}<br>${siteInfo.cap} ${siteInfo.city} (${siteInfo.province})`}
        addressLabel={siteInfo.name}
        zonesInfo={zonesInfo}
        details={localDetails}
        mapEmbedUrl={siteInfo.mapEmbedUrl}
        mapExternalUrl={siteInfo.mapExternalUrl}
        mapDirectionsUrl={siteInfo.mapDirectionsUrl}
        mapPreviewSrc={siteInfo.mapPreviewSrc}
        mapLabel={siteInfo.shortName}
      />
    </div>
  </section>

  <div class="pb-section--alt">
    <CtaBlock
      description="Scrivici su WhatsApp per concordare orari, frequenza e costi delle lezioni private."
      ctaPrimary={{ label: "Scrivici su WhatsApp", href: whatsappHref }}
    >
      Prenota una lezione <span class="text-brand">privata</span>
    </CtaBlock>
  </div>
</BaseLayout>
