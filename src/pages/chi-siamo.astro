---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TeamMemberCard from "../components/TeamMemberCard.astro";
import TargetCard from "../components/TargetCard.astro";
import Gallery from "../components/Gallery.astro";
import LocalSection from "../components/LocalSection.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { localDetails, zones, siteInfo, buildWhatsappHref } from "@/data/shared";

// Unica CTA della pagina: WhatsApp con messaggio generico (chi-siamo non è legata a un corso specifico).
const whatsappHref = buildWhatsappHref(
  "Ciao, vorrei prenotare una prova gratuita a Pugilistica Brianza."
);

// Foto team: importate come ES module così Astro le ottimizza in build
// (genera WebP, dimensioni esplicite, hashing del nome file per caching).
import stefanoPhoto from "../assets/images/bio/stefano-rizzo.jpg";
import brunoPhoto from "../assets/images/bio/bruno-elli.jpg";
import riccardoPhoto from "../assets/images/bio/riccardo-sparano.jpg";
import vittorioPhoto from "../assets/images/bio/vittorio-uboldi.jpg";

const teamMembers = [
  {
    name: "Stefano Rizzo",
    role: "Co-Fondatore e Head Coach",
    bio: "Stefano Rizzo, milanese classe 1984, è co-fondatore di Pugilistica Brianza e la guida tecnica di ogni corso. Il suo percorso sportivo attraversa nuoto, ginnastica artistica e l'hockey su ghiaccio, dove viene convocato nelle nazionali giovanili Under 17 e Under 21, prima di approdare al pugilato con circa 40 incontri da dilettante. Oggi allena, organizza eventi e segue ogni atleta: dal principiante a chi si prepara a salire sul ring.",
    credentials: [
      "Maestro di pugilato di 2° livello FPI",
      "Tecnico di 1° livello FIPE – Federazione Italiana Pesistica",
      "Coach certificato Hyrox – Accademia 365",
      "Consigliere Comitato Regionale Lombardo FPI (rappresentante atleti, quadriennio olimpico)",
      "Atleta attivo: Hyrox, corsa 10 km e mezza maratona",
    ],
    photo: stefanoPhoto,
    photoAlt:
      "Stefano Rizzo, co-fondatore e head coach di Pugilistica Brianza a Barlassina",
  },
  {
    name: "Bruno Elli",
    role: "Co-Fondatore e Presidente",
    bio: "Bruno Elli è co-fondatore e presidente di Pugilistica Brianza. Ex nuotatore agonista, scopre la boxe a 21 anni e la porta avanti fino a disputare 22 incontri da dilettante. La stessa passione che lo ha avvicinato al ring lo ha spinto a costruire, insieme ai soci, una palestra vera in Brianza.",
    credentials: [
      "Co-fondatore di Pugilistica Brianza",
      "22 match da pugile dilettante",
      "Presidente ASD Pugilistica Brianza dal 2025",
    ],
    photo: brunoPhoto,
    photoAlt: "Bruno Elli, presidente e co-fondatore di Pugilistica Brianza",
  },
  {
    name: "Riccardo Sparano",
    role: "Co-Fondatore e Vicepresidente",
    bio: "Riccardo Sparano, di Seregno, è co-fondatore e vicepresidente di Pugilistica Brianza. Dopo anni passati a cercare il suo sport, tra calcio, nuoto e basket, ha trovato nella boxe e nel gruppo che ha dato vita alla palestra il posto in cui sentirsi davvero a casa. Oggi contribuisce a costruire ogni giorno la realtà dell'associazione.",
    credentials: [
      "Co-fondatore di Pugilistica Brianza",
      "Vicepresidente ASD Pugilistica Brianza",
    ],
    photo: riccardoPhoto,
    photoAlt:
      "Riccardo Sparano, vicepresidente e co-fondatore di Pugilistica Brianza",
  },
  {
    name: "Vittorio Uboldi",
    role: "Co-Fondatore, Cutman e Presentatore",
    bio: "Vittorio Uboldi, co-fondatore di Pugilistica Brianza, porta nella palestra un profilo unico: laureato in Ingegneria Meccanica al Politecnico di Milano e docente, è anche cantante, autore, speaker radiofonico e attore di prosa e musical. Sul ring è cutman e presentatore di eventi sportivi, dove è noto con il nome di Vick \"The Judgment Day\".",
    credentials: [
      "Laurea in Ingegneria Meccanica – Politecnico di Milano",
      "Cutman e presentatore di eventi sportivi (alias: Vick \"The Judgment Day\")",
      "Speaker radiofonico e voice over",
      "Insegnante di canto e chitarra; attore di prosa e musical",
    ],
    photo: vittorioPhoto,
    photoAlt:
      "Vittorio Uboldi, cutman e presentatore di Pugilistica Brianza",
  },
];

// JSON-LD: un grafo di 4 Person legati all'organizzazione, per aiutare i motori
// di ricerca a capire chi gestisce la palestra (SEO tecnica / entità).
const teamSchema = {
  "@context": "https://schema.org",
  "@graph": teamMembers.map((m) => ({
    "@type": "Person",
    name: m.name,
    jobTitle: m.role,
    description: m.bio,
    worksFor: {
      "@type": "SportsActivityLocation",
      name: siteInfo.name,
      url: siteInfo.url,
    },
  })),
};
---

<BaseLayout
  title="Chi Siamo — ASD Pugilistica Brianza | Barlassina"
  description="Scopri la storia, i valori e il team di Pugilistica Brianza, palestra di pugilato a Barlassina dal 9 gennaio 2016. Affiliati FPI, FIPE e Hyrox."
  schema={teamSchema}
>
  <!-- HERO -->
  <Hero
    topline="Chi siamo — Pugilistica Brianza"
    subtitle="Dal 9 gennaio 2016 a Barlassina, una palestra di pugilato fondata su tecnica, ambiente e rispetto. Affiliata FPI, FIPE e Hyrox, guidata da un coach ex agonista."
    watermark="PB"
    ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
  >
    Pugilistica <span class="text-brand">Brianza</span>
  </Hero>

  <!-- STATS -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-center">
        <div>
          <div class="font-display text-display-lg text-pb-text-primary mb-2">ASD</div>
          <p class="text-sm text-pb-text-tertiary">Associazione Sportiva Dilettantistica<br>affiliata FPI, FIPE e Hyrox</p>
        </div>
        <div>
          <div class="font-display text-display-lg text-pb-text-primary mb-2">20<span class="text-brand">16</span></div>
          <p class="text-sm text-pb-text-tertiary">Fondata il 9 gennaio<br>a Barlassina</p>
        </div>
        <div>
          <div class="font-display text-display-lg text-pb-text-primary mb-2">Barlassina</div>
          <p class="text-sm text-pb-text-tertiary">Via G. Segantini 29<br>nel cuore della Brianza</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FILOSOFIA -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="La nostra filosofia">
        La nostra idea di <span class="text-brand">allenamento</span>
      </SectionHeading>
      <div class="max-w-narrow">
        <p class="text-lg text-pb-text-secondary leading-relaxed mb-6 italic">
          Crediamo nella boxe, nella sua arte, e nel suo spirito di unione. Non è solo sport: è disciplina, crescita personale e rispetto.
        </p>
        <p class="text-base text-pb-text-tertiary leading-normal mb-4">
          Pugilistica Brianza nasce da una visione precisa: creare un luogo dove il pugilato viene insegnato con serietà tecnica, in un ambiente che accoglie tutti. Non una palestra generica con un sacco in un angolo, ma un posto dove la boxe è al centro di tutto — dall'allenamento alla mentalità.
        </p>
        <p class="text-base text-pb-text-tertiary leading-normal mb-10">
          Qui l'atmosfera è familiare, ma l'impegno è reale. Ti alleni con persone che vogliono migliorare, seguite da un coach che ha combattuto davvero. Che tu voglia competere, rimetterti in forma o semplicemente staccare dalla giornata, trovi un percorso costruito per te.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { icon: '<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v6l4 2"/>', title: "Disciplina", desc: "Il pugilato insegna costanza, rispetto e autocontrollo. Ogni allenamento è un passo avanti, dentro e fuori dal ring." },
            { icon: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>', title: "Unione", desc: "L'allenamento è individuale, ma la crescita è collettiva. In palestra si costruisce un gruppo vero, motivante e inclusivo." },
            { icon: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>', title: "Arte", desc: "La boxe è tecnica, ritmo, intelligenza. Non si tratta di menare: si tratta di imparare a muoversi, leggere l'avversario e reagire." },
          ].map((v) => (
            <div class="text-center">
              <div class="w-12 h-12 border border-pb-border-accent rounded-md flex items-center justify-center mx-auto mb-4">
                <svg class="w-5 h-5 stroke-brand fill-none" style="stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;" viewBox="0 0 24 24" set:html={v.icon} />
              </div>
              <h3 class="font-display text-display-sm text-pb-text-primary mb-2">{v.title}</h3>
              <p class="text-sm text-pb-text-tertiary leading-normal">{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Il team"
        description="Quattro persone, una visione: costruire una palestra di pugilato vera in Brianza. Ecco chi guida Pugilistica Brianza."
      >
        Chi guida la <span class="text-brand">palestra</span>
      </SectionHeading>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        {teamMembers.map((m) => (
          <TeamMemberCard
            name={m.name}
            role={m.role}
            bio={m.bio}
            credentials={[...m.credentials]}
            photo={m.photo}
            photoAlt={m.photoAlt}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- PER CHI SIAMO -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="A chi ci rivolgiamo"
        description="Accogliamo tutti, con un percorso adatto a ciascuno. Non serve esperienza: serve voglia di iniziare."
      >
        Per chi <span class="text-brand">siamo</span>
      </SectionHeading>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { icon: '<path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>', title: "Principianti", description: "La maggior parte dei nostri iscritti ha iniziato da zero." },
          { icon: '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>', title: "Donne", description: "Corso misto e inclusivo, in un ambiente rispettoso e motivante." },
          { icon: '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>', title: "Ragazzi 8+", description: "Corso di pugilato dagli 8 anni in su. Allenamento adattato all'età e al livello, approccio educativo." },
          { icon: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>', title: "Amatori e agonisti", description: "Percorsi su misura per fitness o competizione in light-boxe e boxe dilettantistica." },
        ].map((t) => (
          <TargetCard icon={t.icon} title={t.title} description={t.description} />
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="pb-section fade-up">
    <div class="pb-container">
      <SectionHeading
        topline="Gli spazi"
        description="Tutto quello che serve per allenarsi bene, in uno spazio pensato per il pugilato e la preparazione atletica."
      >
        La <span class="text-brand">palestra</span>
      </SectionHeading>
      <Gallery />
    </div>
  </section>

  <!-- LOCAL -->
  <section class="pb-section pb-section--alt fade-up">
    <div class="pb-container">
      <SectionHeading topline="Dove siamo">
        Ci trovi a <span class="text-brand">Barlassina</span>
      </SectionHeading>
      <LocalSection
        address={`${siteInfo.address}<br>${siteInfo.cap} ${siteInfo.city} (${siteInfo.province})`}
        addressLabel={siteInfo.name}
        zones={zones}
        details={localDetails}
        mapEmbedUrl={siteInfo.mapEmbedUrl}
        mapExternalUrl={siteInfo.mapExternalUrl}
        mapPreviewSrc={siteInfo.mapPreviewSrc}
        mapLabel={siteInfo.shortName}
      />
    </div>
  </section>

  <!-- CTA FINALE -->
  <CtaBlock
    description="Vieni a conoscerci. La prima lezione è gratuita e senza impegno."
    ctaPrimary={{ label: "Prenota su WhatsApp", href: whatsappHref }}
  >
    Inizia ad allenarti<br />con <span class="text-brand">noi</span>
  </CtaBlock>
</BaseLayout>
