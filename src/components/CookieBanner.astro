---
/**
 * CookieBanner — banner di consenso cookie, mostrato in fondo a ogni pagina.
 * Usa localStorage per ricordare la scelta dell'utente.
 * Incluso in BaseLayout.astro.
 */
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-toast border-t border-pb-border-default bg-surface-raised px-8 py-5 max-md:px-5"
  role="region"
  aria-label="Consenso cookie"
>
  <div class="mx-auto flex max-w-container items-center justify-between gap-6 max-md:flex-col max-md:items-start max-md:gap-4">
    <p class="max-w-[640px] text-sm leading-normal text-pb-text-secondary">
      Questo sito utilizza cookie tecnici necessari al funzionamento.
      Con il tuo consenso utilizziamo anche cookie di analisi (Google Analytics, Microsoft Clarity)
      per capire come migliorare la tua esperienza.
      <a
        href="/privacy-policy/"
        class="text-brand underline transition-colors duration-base hover:text-brand-light"
      >
        Leggi l'informativa completa
      </a>
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        id="cookie-reject"
        class="cursor-pointer border border-pb-border-medium bg-transparent px-5 py-2.5 font-body text-xs font-semibold uppercase tracking-wider text-pb-text-secondary transition-all duration-base ease-default hover:border-pb-border-strong hover:text-pb-text-primary"
        type="button"
      >
        Rifiuta
      </button>
      <button
        id="cookie-accept"
        class="cursor-pointer border-none bg-brand px-5 py-2.5 font-body text-xs font-bold uppercase tracking-wider text-white transition-all duration-base ease-default hover:bg-brand-dark"
        type="button"
      >
        Accetta
      </button>
    </div>
  </div>
</div>

<script is:inline>
  // ID del container Google Tag Manager. Modifica qui se cambia.
  // Dentro GTM sono configurati i tag Google Analytics 4 e Microsoft Clarity.
  var GTM_ID = "GTM-T955C9C7";

  // Inietta GTM solo dopo il consenso esplicito dell'utente.
  // Lo snippet sotto è quello ufficiale di Google, racchiuso in una funzione
  // così possiamo invocarlo sia al pageload (se consenso già dato in passato)
  // sia al click su "Accetta".
  function loadGTM() {
    if (window.__gtmLoaded) return; // evita doppio caricamento
    window.__gtmLoaded = true;
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s),
        dl = l != "dataLayer" ? "&l=" + l : "";
      j.async = true;
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, "script", "dataLayer", GTM_ID);
  }

  // All'apertura della pagina:
  // - se l'utente aveva già accettato, carica GTM e nascondi il banner
  // - se aveva rifiutato, nascondi il banner senza caricare nulla
  // - se non ha ancora scelto, lascia il banner visibile
  (function () {
    var consent = localStorage.getItem("cookie_consent");
    if (consent === "accepted") loadGTM();
    if (consent) {
      var banner = document.getElementById("cookie-banner");
      if (banner) banner.remove();
    }
  })();

  document.getElementById("cookie-accept")?.addEventListener("click", function () {
    localStorage.setItem("cookie_consent", "accepted");
    var banner = document.getElementById("cookie-banner");
    if (banner) banner.remove();
    loadGTM();
  });

  document.getElementById("cookie-reject")?.addEventListener("click", function () {
    localStorage.setItem("cookie_consent", "rejected");
    var banner = document.getElementById("cookie-banner");
    if (banner) banner.remove();
  });
</script>
