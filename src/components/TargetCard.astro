---
/**
 * Target Card — card con icona, titolo e descrizione.
 * Variante della SegmentCard, ma con icona SVG.
 * Usata nelle sezioni "Per chi è adatto" delle pagine servizio.
 */

interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<li
  class="p-card-pad border border-pb-border-default rounded-md
         transition-all duration-base ease-default flex flex-col gap-4
         hover:border-pb-border-accent hover:bg-[rgba(196,30,30,0.03)]"
>
  <div
    class="w-11 h-11 border border-pb-border-accent rounded-md
           flex items-center justify-center"
  >
    <svg
      class="w-5 h-5 stroke-brand fill-none"
      style="stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;"
      viewBox="0 0 24 24"
      set:html={icon}
    />
  </div>
  <p class="font-display text-display-sm text-pb-text-primary">{title}</p>
  <p class="text-sm text-pb-text-tertiary leading-normal">{description}</p>
</li>
