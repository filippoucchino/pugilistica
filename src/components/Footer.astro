---
/**
 * Footer — 4 colonne: brand, percorsi, info, contatti + bottom bar con social.
 */
import { Image } from "astro:assets";
import logoSrc from "@/assets/brand/logo-pugilistica-brianza.svg";
import { siteInfo, courseLinks, infoLinks } from "@/data/shared";
import SocialLinks from "./SocialLinks.astro";

const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-950 border-t border-pb-border-subtle pt-16 px-8 pb-8 max-sm:pt-10 max-sm:px-5">
  <div class="max-w-container mx-auto">
    <!-- Grid -->
    <div class="grid grid-cols-footer gap-12 mb-12 max-md:grid-cols-footer-md max-md:gap-8 max-sm:grid-cols-2 max-sm:gap-x-6 max-sm:gap-y-6 max-sm:mb-8">
      <!-- Brand -->
      <div class="max-sm:col-span-2">
        <a href="/" class="inline-block mb-3 no-underline" aria-label="Pugilistica Brianza - Home">
          <Image
            src={logoSrc}
            alt="Pugilistica Brianza"
            width={252}
            height={160}
            class="h-32 w-auto max-sm:h-20"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-sm text-pb-text-muted leading-normal max-w-[280px] mb-4">
          ASD di pugilato a {siteInfo.city}. Ambiente familiare, coach qualificati, prova gratuita.
        </p>
        <SocialLinks size="md" />
      </div>

      <!-- Percorsi -->
      <div>
        <div class="text-xxs font-semibold tracking-widest uppercase text-pb-text-muted mb-4">
          Percorsi
        </div>
        {courseLinks.map((link) => (
          <a
            href={link.href}
            class="block text-sm text-pb-text-tertiary py-[5px] no-underline transition-colors duration-base hover:text-pb-text-primary"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Info -->
      <div>
        <div class="text-xxs font-semibold tracking-widest uppercase text-pb-text-muted mb-4">
          Info
        </div>
        {infoLinks.map((link) => (
          <a
            href={link.href}
            class="block text-sm text-pb-text-tertiary py-[5px] no-underline transition-colors duration-base hover:text-pb-text-primary"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Contatti -->
      <div class="max-sm:col-span-2">
        <div class="text-xxs font-semibold tracking-widest uppercase text-pb-text-muted mb-4">
          Contatti
        </div>
        <a
          href={siteInfo.phoneHref}
          class="block text-sm text-pb-text-tertiary py-[5px] no-underline transition-colors duration-base hover:text-pb-text-primary"
        >
          {siteInfo.phone}
        </a>
        <a
          href={`mailto:${siteInfo.email}`}
          class="block text-sm text-pb-text-tertiary py-[5px] no-underline transition-colors duration-base hover:text-pb-text-primary break-all"
        >
          {siteInfo.email}
        </a>
        <span class="block text-sm text-pb-text-tertiary py-[5px]">{siteInfo.address}</span>
        <span class="block text-sm text-pb-text-tertiary py-[5px]">{siteInfo.city} ({siteInfo.province})</span>
        <span class="block text-sm text-pb-text-tertiary py-[5px]">Aperti da lunedì a sabato</span>
      </div>
    </div>

    <!-- Bottom -->
    <div class="border-t border-pb-border-default pt-6 flex items-center justify-between max-sm:flex-col max-sm:gap-2">
      <span class="text-xs text-pb-text-muted">&copy; {currentYear} {siteInfo.name}. Tutti i diritti riservati.</span>
      <a
        href="/privacy-policy/"
        class="text-xs text-pb-text-muted no-underline transition-colors duration-base hover:text-pb-text-tertiary"
      >
        Privacy Policy
      </a>
    </div>
  </div>
</footer>
