---
/**
 * Footer — 4 colonne: brand, percorsi, info, contatti + bottom bar con social.
 */
import { siteInfo, courseLinks, infoLinks } from "@/data/shared";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="bg-neutral-950 border-t border-pb-border-subtle pt-16 px-8 pb-8">
  <div class="max-w-container mx-auto">
    <!-- Grid -->
    <div class="grid grid-cols-footer gap-12 mb-12 max-md:grid-cols-footer-md max-md:gap-8 max-sm:grid-cols-1">
      <!-- Brand -->
      <div>
        <a href="/" class="inline-block mb-4 no-underline" aria-label="Pugilistica Brianza — Home">
          <img
            src="/brand/logo.png"
            alt="Pugilistica Brianza"
            width="500"
            height="318"
            class="h-20 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-sm text-pb-text-muted leading-normal max-w-[280px] mb-5">
          ASD di pugilato a {siteInfo.city}. Ambiente familiare, coach qualificati, prova gratuita.
        </p>
        <SocialLinks size="md" />
      </div>

      <!-- Percorsi -->
      <div>
        <div class="text-xxs font-semibold tracking-widest uppercase text-pb-text-faint mb-4">
          Percorsi
        </div>
        {courseLinks.map((link) => (
          <a
            href={link.href}
            class="block text-sm text-pb-text-tertiary py-[5px] no-underline transition-colors duration-base hover:text-pb-text-primary"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Info -->
      <div>
        <div class="text-xxs font-semibold tracking-widest uppercase text-pb-text-faint mb-4">
          Info
        </div>
        {infoLinks.map((link) => (
          <a
            href={link.href}
            class="block text-sm text-pb-text-tertiary py-[5px] no-underline transition-colors duration-base hover:text-pb-text-primary"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Contatti -->
      <div>
        <div class="text-xxs font-semibold tracking-widest uppercase text-pb-text-faint mb-4">
          Contatti
        </div>
        <span class="block text-sm text-pb-text-tertiary py-[5px]">{siteInfo.address}</span>
        <span class="block text-sm text-pb-text-tertiary py-[5px]">{siteInfo.city} ({siteInfo.province})</span>
        <span class="block text-sm text-pb-text-tertiary py-[5px]">Lun – Sab</span>
      </div>
    </div>

    <!-- Bottom -->
    <div class="border-t border-pb-border-default pt-6 flex items-center justify-between max-sm:flex-col max-sm:gap-2">
      <span class="text-xs text-pb-text-faint">&copy; 2025 {siteInfo.name}. Tutti i diritti riservati.</span>
      <a
        href="/privacy-policy/"
        class="text-xs text-pb-text-faint no-underline transition-colors duration-base hover:text-pb-text-tertiary"
      >
        Privacy Policy
      </a>
    </div>
  </div>
</footer>
