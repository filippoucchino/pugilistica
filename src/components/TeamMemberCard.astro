---
/**
 * Team Member Card — card per i membri del team di Pugilistica Brianza.
 * Foto quadrata ottimizzata con `astro:assets` (WebP + width/height espliciti
 * per evitare CLS) e microdata Schema.org/Person per SEO tecnica.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  role: string;
  bio: string;
  credentials: string[];
  photo: ImageMetadata;
  photoAlt: string;
}

const { name, role, bio, credentials, photo, photoAlt } = Astro.props;
---

<article
  class="bg-surface-card border border-pb-border-default rounded-md overflow-hidden
         flex flex-col transition-colors duration-300 hover:border-pb-border-accent"
  itemscope
  itemtype="https://schema.org/Person"
>
  <!-- Foto quadrata: width/height sul tag riservano lo spazio in anticipo (no CLS) -->
  <div class="aspect-square overflow-hidden bg-neutral-900">
    <Image
      src={photo}
      alt={photoAlt}
      width={600}
      height={600}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
      itemprop="image"
    />
  </div>

  <div class="p-card-pad-lg flex-1 flex flex-col">
    <p
      class="font-display text-display-sm text-pb-text-primary mb-1"
      itemprop="name"
    >
      {name}
    </p>
    <p
      class="text-sm text-brand font-semibold tracking-wide mb-4"
      itemprop="jobTitle"
    >
      {role}
    </p>
    <p
      class="text-base text-pb-text-tertiary leading-normal mb-5"
      itemprop="description"
    >
      {bio}
    </p>

    <!-- Credenziali: elenco puntato con check rosso, bordo superiore per separare dalla bio -->
    <ul class="mt-auto space-y-2 pt-5 border-t border-pb-border-default">
      {credentials.map((c) => (
        <li class="flex items-start gap-3 text-sm text-pb-text-muted leading-normal">
          <svg
            class="w-4 h-4 stroke-brand fill-none flex-shrink-0 mt-[3px]"
            style="stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round;"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M20 6L9 17l-5-5" />
          </svg>
          <span>{c}</span>
        </li>
      ))}
    </ul>
  </div>
</article>
