---
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

<nav class="pb-toc" aria-label="Sezioni della pagina">
  <div class="pb-toc__track scrollbar-hide">
    <span class="pb-toc__label" aria-hidden="true">Menù</span>
    {items.map(({ id, label }) => (
      <a href={`#${id}`} class="pb-toc__pill" data-toc-id={id}>
        {label}
      </a>
    ))}
  </div>
  <div class="pb-toc__progress" aria-hidden="true">
    <div class="pb-toc__progress-fill"></div>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var pills = document.querySelectorAll('[data-toc-id]');
    if (!pills.length) return;

    var sections = [];
    pills.forEach(function (pill) {
      var el = document.getElementById(pill.getAttribute('data-toc-id'));
      if (el) sections.push({ el: el, pill: pill });
    });
    if (!sections.length) return;

    var progressFill = document.querySelector('.pb-toc__progress-fill');
    var tocEl = document.querySelector('.pb-toc');
    var OFFSET = 140; // fallback iniziale

    // Punto 8: calcola OFFSET dall'altezza reale del TOC sticky
    function calcOffset() {
      if (tocEl) OFFSET = tocEl.getBoundingClientRect().bottom + 10;
    }
    calcOffset();
    window.addEventListener('resize', calcOffset, { passive: true });

    var activeIdx = -1;

    function setActive(idx) {
      if (idx === activeIdx) return;
      activeIdx = idx;
      pills.forEach(function (p) { p.classList.remove('is-active'); });
      if (idx < 0 || idx >= sections.length) return;
      var activePill = sections[idx].pill;
      activePill.classList.add('is-active');
      // Porta la pillola attiva nel campo visibile della barra
      var track = activePill.parentElement;
      var pillLeft = activePill.offsetLeft;
      var pillRight = pillLeft + activePill.offsetWidth;
      var trackScrollLeft = track.scrollLeft;
      var trackVisible = track.clientWidth;
      if (pillLeft < trackScrollLeft + 8) {
        track.scrollLeft = pillLeft - 8;
      } else if (pillRight > trackScrollLeft + trackVisible - 8) {
        track.scrollLeft = pillRight - trackVisible + 8;
      }
    }

    function updateActive() {
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 50) {
        setActive(sections.length - 1);
        return;
      }
      var best = -1; // -1 = nessuna sezione ancora raggiunta (es. utente sulla hero)
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].el.getBoundingClientRect().top <= OFFSET) {
          best = i;
        }
      }
      setActive(best);
    }

    // Punto 10: progress bar — percentuale di pagina scorsa
    function updateProgress() {
      if (!progressFill) return;
      var max = document.documentElement.scrollHeight - window.innerHeight;
      var pct = max > 0 ? (window.scrollY / max) * 100 : 0;
      progressFill.style.width = Math.min(100, pct) + '%';
    }

    window.addEventListener('scroll', function () {
      updateActive();
      updateProgress();
    }, { passive: true });

    updateActive();
    updateProgress();
  });
</script>
