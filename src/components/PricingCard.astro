---
/**
 * Pricing Card — box abbonamento con prezzo, lista inclusi e CTA.
 */

interface Props {
  title: string;
  price: string;
  period?: string;
  note?: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
}

const { title, price, period = "/mese", note, features, ctaLabel, ctaHref } = Astro.props;

// Link esterni (http/https) devono aprirsi in nuova scheda per non perdere la pagina.
const isExternal = /^https?:\/\//.test(ctaHref);
---

<div class="p-card-pad-lg bg-surface-card border border-pb-border-default rounded-md">
  <!-- Riga titolo + prezzo: risparmio spazio verticale mettendoli affiancati -->
  <div class="flex items-start justify-between gap-4 mb-6">
    <p class="font-display text-display-sm text-pb-text-primary leading-tight">{title}</p>
    <div class="text-right shrink-0">
      <span class="font-display text-[clamp(28px,4vw,40px)] text-brand leading-none">
        {price}
      </span>
      <span class="text-base text-pb-text-muted block">{period}</span>
    </div>
  </div>

  {note && (
    <p class="text-xs text-pb-text-muted -mt-4 mb-6">{note}</p>
  )}

  <ul class="flex flex-col gap-3 mb-8">
    {features.map((f) => (
      <li class="flex items-start gap-2.5 text-sm text-pb-text-tertiary leading-snug">
        <svg
          class="w-4 h-4 stroke-brand fill-none flex-shrink-0 mt-0.5"
          style="stroke-width: 2;"
          viewBox="0 0 24 24"
        >
          <path d="M20 6L9 17l-5-5" />
        </svg>
        {f}
      </li>
    ))}
  </ul>

  <a
    href={ctaHref}
    class="pb-btn-primary w-full text-center block"
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener" : undefined}
  >{ctaLabel}</a>
</div>
