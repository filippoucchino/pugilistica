---
/**
 * Segment / Target card — "Per chi è" il corso.
 */

interface Props {
  title: string;
  description: string;
  linkLabel?: string;
  linkHref?: string;
}

const { title, description, linkLabel, linkHref } = Astro.props;
---

<li
  class="p-card-pad border border-pb-border-default rounded-md
         transition-all duration-base ease-default
         hover:border-pb-border-accent hover:bg-[rgba(196,30,30,0.03)]"
>
  <p class="font-display text-display-sm text-pb-text-primary mb-2">{title}</p>
  <p class="text-sm text-pb-text-tertiary leading-normal mb-3">{description}</p>
  {linkLabel && linkHref && (
    <a
      href={linkHref}
      class="text-xs font-semibold text-brand tracking-wide no-underline"
    >
      {linkLabel}
    </a>
  )}
</li>
