---
/**
 * Gallery — griglia di thumbnail quadrate con lightbox nativo.
 *
 * Su mobile (< 640px): slider orizzontale, una foto alla volta.
 *   Frecce prev/next sovrapposte + swipe nativo + contatore "1 / N".
 * Su tablet (640px–1023px): griglia 2 colonne.
 * Su desktop (≥ 1024px): griglia 4 colonne.
 *
 * src accetta sia stringhe URL sia ImageMetadata (import da src/assets/).
 * Con ImageMetadata Astro ottimizza automaticamente: WebP, width/height, qualità.
 *
 * A11y: <button> per i thumb (focus + Invio), dialog modale con focus trap,
 * aria-label sui controlli, aria-live su contatori, tastiera (← →, Esc).
 */

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryImage {
  src: ImageMetadata | string;
  alt: string;
}

interface Props {
  images?: GalleryImage[];
  /** Numero di placeholder da mostrare se nessuna immagine */
  placeholderCount?: number;
}

const { images, placeholderCount = 3 } = Astro.props as Props;
const imageList = images ?? [];
const hasImages = imageList.length > 0;
const hasMultiple = imageList.length > 1;
const items: (GalleryImage | null)[] = hasImages
  ? imageList
  : Array.from({ length: placeholderCount }, () => null);
---

<div class="pb-gallery">

  {/* — Slider wrapper: contiene la griglia e le frecce slider (posizionate relative) — */}
  <div class="pb-gallery__slider-wrapper">

    {/* Frecce slider: visibili solo su mobile, sovrapposte alla foto */}
    {hasMultiple && (
      <>
        <button
          type="button"
          class="pb-gallery__slider-nav pb-gallery__slider-nav--prev"
          aria-label="Foto precedente"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <button
          type="button"
          class="pb-gallery__slider-nav pb-gallery__slider-nav--next"
          aria-label="Foto successiva"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 6 15 12 9 18" />
          </svg>
        </button>
      </>
    )}

    {/* — Griglia thumbnail — */}
    <div class="pb-gallery__grid">
      {items.map((item, i) =>
        item ? (
          <button
            type="button"
            class="pb-gallery__thumb"
            data-index={i}
            aria-label={`Ingrandisci: ${item.alt}`}
          >
            {typeof item.src === "string" ? (
              <img
                src={item.src}
                alt={item.alt}
                class="pb-gallery__thumb-img"
                loading="lazy"
              />
            ) : (
              <Image
                src={item.src}
                alt={item.alt}
                class="pb-gallery__thumb-img"
                loading="lazy"
                quality={80}
              />
            )}
          </button>
        ) : (
          <div class="pb-gallery__placeholder">
            Foto {i + 1}
          </div>
        ),
      )}
    </div>
  </div>

  {/* — Contatore slide mobile "1 / N" — */}
  {hasMultiple && (
    <div class="pb-gallery__slider-counter" aria-live="polite">
      1 / {imageList.length}
    </div>
  )}

  {/* — Lightbox (solo se ci sono immagini reali) — */}
  {hasImages && (
    <dialog class="pb-gallery__lightbox" aria-label="Immagine ingrandita">
      <div class="pb-gallery__overlay">
        <button
          type="button"
          class="pb-gallery__close"
          aria-label="Chiudi"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>

        {hasMultiple && (
          <>
            <button
              type="button"
              class="pb-gallery__nav pb-gallery__nav--prev"
              aria-label="Immagine precedente"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </button>
            <button
              type="button"
              class="pb-gallery__nav pb-gallery__nav--next"
              aria-label="Immagine successiva"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 6 15 12 9 18" />
              </svg>
            </button>
            <span class="pb-gallery__counter" aria-live="polite"></span>
          </>
        )}

        <img class="pb-gallery__lightbox-img" src="" alt="" />
      </div>
    </dialog>
  )}
</div>

<style>
  /* ===== SLIDER WRAPPER ===== */
  .pb-gallery__slider-wrapper {
    position: relative;
  }

  /* ===== GRIGLIA (tablet e desktop) ===== */
  .pb-gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  @media (max-width: 1023px) {
    .pb-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ===== SLIDER MOBILE (< 640px) ===== */
  @media (max-width: 639px) {
    .pb-gallery__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: 0;
    }

    .pb-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    /* Ogni thumbnail occupa tutta la larghezza del contenitore */
    .pb-gallery__grid > * {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }
  }

  /* ===== FRECCE SLIDER (solo mobile) ===== */
  .pb-gallery__slider-nav {
    display: none;
  }

  @media (max-width: 639px) {
    .pb-gallery__slider-nav {
      display: flex;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(10, 10, 10, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.18);
      align-items: center;
      justify-content: center;
      color: white;
      cursor: pointer;
      transition: background 200ms;
    }

    .pb-gallery__slider-nav:hover,
    .pb-gallery__slider-nav:focus-visible {
      background: rgba(10, 10, 10, 0.9);
    }

    .pb-gallery__slider-nav--prev { left: 10px; }
    .pb-gallery__slider-nav--next { right: 10px; }
  }

  /* ===== CONTATORE MOBILE ===== */
  .pb-gallery__slider-counter {
    display: none;
  }

  @media (max-width: 639px) {
    .pb-gallery__slider-counter {
      display: block;
      text-align: center;
      margin-top: 10px;
      font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.4);
      letter-spacing: 0.05em;
    }
  }

  /* ===== THUMBNAIL ===== */
  .pb-gallery__thumb {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    padding: 0;
    background: none;
  }

  .pb-gallery__thumb:focus-visible {
    outline: 2px solid #c41e1e;
    outline-offset: 2px;
  }

  .pb-gallery__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms ease;
  }

  .pb-gallery__thumb:hover .pb-gallery__thumb-img {
    transform: scale(1.05);
  }

  /* ===== PLACEHOLDER ===== */
  .pb-gallery__placeholder {
    aspect-ratio: 1 / 1;
    background: #262626;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.25);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ===== LIGHTBOX (dialog nativo) ===== */
  .pb-gallery__lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(10, 10, 10, 0.95);
    z-index: 100;
  }

  .pb-gallery__lightbox::backdrop {
    background: transparent;
  }

  .pb-gallery__lightbox[open] {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: pb-gallery-fade-in 200ms ease-out;
  }

  @keyframes pb-gallery-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .pb-gallery__overlay {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .pb-gallery__overlay > * {
    pointer-events: auto;
  }

  .pb-gallery__lightbox-img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 4px;
    user-select: none;
  }

  .pb-gallery__close {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 10;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: background 200ms;
  }

  .pb-gallery__close:hover,
  .pb-gallery__close:focus-visible {
    background: rgba(255, 255, 255, 0.25);
  }

  .pb-gallery__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: background 200ms;
  }

  .pb-gallery__nav:hover,
  .pb-gallery__nav:focus-visible {
    background: rgba(255, 255, 255, 0.25);
  }

  .pb-gallery__nav--prev { left: 16px; }
  .pb-gallery__nav--next { right: 16px; }

  .pb-gallery__counter {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.05em;
    z-index: 10;
  }

  @media (max-width: 639px) {
    .pb-gallery__close {
      top: 10px;
      right: 10px;
      width: 40px;
      height: 40px;
    }
    .pb-gallery__nav {
      width: 40px;
      height: 40px;
    }
    .pb-gallery__nav--prev { left: 8px; }
    .pb-gallery__nav--next { right: 8px; }
    .pb-gallery__lightbox-img {
      max-width: 95vw;
      max-height: 80vh;
    }
  }
</style>

<script>
  /**
   * Gallery controller — gestisce lightbox e slider mobile per ogni istanza.
   */
  document.querySelectorAll<HTMLElement>('.pb-gallery').forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>('.pb-gallery__lightbox');
    const grid = gallery.querySelector<HTMLElement>('.pb-gallery__grid');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('.pb-gallery__thumb');
    if (!grid) return;

    // — Slider mobile —
    const sliderPrev = gallery.querySelector<HTMLButtonElement>('.pb-gallery__slider-nav--prev');
    const sliderNext = gallery.querySelector<HTMLButtonElement>('.pb-gallery__slider-nav--next');
    const sliderCounter = gallery.querySelector<HTMLElement>('.pb-gallery__slider-counter');
    let slideIndex = 0;

    function slideTo(index: number) {
      const total = thumbs.length;
      slideIndex = ((index % total) + total) % total;
      grid!.scrollTo({ left: slideIndex * grid!.offsetWidth, behavior: 'smooth' });
      if (sliderCounter) sliderCounter.textContent = `${slideIndex + 1} / ${total}`;
    }

    sliderPrev?.addEventListener('click', () => slideTo(slideIndex - 1));
    sliderNext?.addEventListener('click', () => slideTo(slideIndex + 1));

    // Sincronizza l'indice quando l'utente swipe manualmente
    let scrollTimer: ReturnType<typeof setTimeout>;
    grid.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const itemWidth = grid.offsetWidth;
        if (itemWidth === 0) return;
        slideIndex = Math.round(grid.scrollLeft / itemWidth);
        if (sliderCounter) sliderCounter.textContent = `${slideIndex + 1} / ${thumbs.length}`;
      }, 80);
    }, { passive: true });

    // — Lightbox —
    if (!dialog) return;

    const img = dialog.querySelector<HTMLImageElement>('.pb-gallery__lightbox-img');
    const closeBtn = dialog.querySelector<HTMLButtonElement>('.pb-gallery__close');
    const prevBtn = dialog.querySelector<HTMLButtonElement>('.pb-gallery__nav--prev');
    const nextBtn = dialog.querySelector<HTMLButtonElement>('.pb-gallery__nav--next');
    const counter = dialog.querySelector<HTMLElement>('.pb-gallery__counter');
    if (!img || !closeBtn) return;

    const sources: { src: string; alt: string }[] = [];
    thumbs.forEach((thumb) => {
      const thumbImg = thumb.querySelector('img');
      if (thumbImg) sources.push({ src: thumbImg.src, alt: thumbImg.alt });
    });

    let current = 0;

    function show(index: number) {
      current = ((index % sources.length) + sources.length) % sources.length;
      img!.src = sources[current].src;
      img!.alt = sources[current].alt;
      if (counter) counter.textContent = `${current + 1} / ${sources.length}`;
    }

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => {
        show(i);
        dialog!.showModal();
        document.body.style.overflow = 'hidden';
      });
    });

    closeBtn.addEventListener('click', () => dialog!.close());

    let mousedownTarget: EventTarget | null = null;
    dialog.addEventListener('mousedown', (e) => { mousedownTarget = e.target; });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog && mousedownTarget === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });

    dialog.addEventListener('keydown', (e) => {
      if (sources.length <= 1) return;
      if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
    });

    prevBtn?.addEventListener('click', () => show(current - 1));
    nextBtn?.addEventListener('click', () => show(current + 1));
  });
</script>
