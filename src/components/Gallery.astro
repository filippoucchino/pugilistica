---
/**
 * Gallery — griglia di thumbnail quadrate con lightbox nativo.
 *
 * Le immagini sono mostrate come quadrati (aspect-ratio 1:1, object-fit cover).
 * Al click, un <dialog> nativo mostra l'immagine intera (object-fit contain)
 * con navigazione prev/next, chiusura via Escape / click sfondo / pulsante X.
 *
 * Griglia responsive: 3 colonne desktop, 2 tablet, 1 mobile.
 * Se nessuna immagine è passata, mostra placeholder.
 *
 * src accetta sia stringhe URL (es. "/images/foto.jpg") sia ImageMetadata
 * (import da src/assets/). Con ImageMetadata Astro ottimizza automaticamente
 * l'immagine: conversione WebP, width/height espliciti, compressione.
 *
 * A11y: <button> per i thumb (focus + Invio), dialog modale con focus trap,
 * aria-label sui controlli, aria-live sul contatore, tastiera (← →, Esc).
 */

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryImage {
  src: ImageMetadata | string;
  alt: string;
}

interface Props {
  images?: GalleryImage[];
  /** Numero di placeholder da mostrare se nessuna immagine */
  placeholderCount?: number;
}

const { images, placeholderCount = 3 } = Astro.props;
const imageList = images ?? [];
const hasImages = imageList.length > 0;
const items: (GalleryImage | null)[] = hasImages
  ? imageList
  : Array.from({ length: placeholderCount }, () => null);
---

<div class="pb-gallery">
  {/* — Griglia thumbnail — */}
  <div class="pb-gallery__grid">
    {items.map((item, i) =>
      item ? (
        <button
          type="button"
          class="pb-gallery__thumb"
          data-index={i}
          aria-label={`Ingrandisci: ${item.alt}`}
        >
          {typeof item.src === "string" ? (
            <img
              src={item.src}
              alt={item.alt}
              class="pb-gallery__thumb-img"
              loading="lazy"
            />
          ) : (
            <Image
              src={item.src}
              alt={item.alt}
              class="pb-gallery__thumb-img"
              loading="lazy"
              quality={80}
            />
          )}
        </button>
      ) : (
        <div class="pb-gallery__placeholder">
          Foto {i + 1}
        </div>
      ),
    )}
  </div>

  {/* — Lightbox (solo se ci sono immagini reali) — */}
  {hasImages && (
    <dialog class="pb-gallery__lightbox" aria-label="Immagine ingrandita">
      <div class="pb-gallery__overlay">
        <button
          type="button"
          class="pb-gallery__close"
          aria-label="Chiudi"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>

        {imageList.length > 1 && (
          <>
            <button
              type="button"
              class="pb-gallery__nav pb-gallery__nav--prev"
              aria-label="Immagine precedente"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </button>
            <button
              type="button"
              class="pb-gallery__nav pb-gallery__nav--next"
              aria-label="Immagine successiva"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 6 15 12 9 18" />
              </svg>
            </button>
            <span class="pb-gallery__counter" aria-live="polite"></span>
          </>
        )}

        <img class="pb-gallery__lightbox-img" src="" alt="" />
      </div>
    </dialog>
  )}
</div>

<style>
  /* ===== GRIGLIA ===== */
  .pb-gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  @media (max-width: 1023px) {
    .pb-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .pb-gallery__grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin-inline: auto;
    }
  }

  /* ===== THUMBNAIL ===== */
  .pb-gallery__thumb {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    padding: 0;
    background: none;
  }

  .pb-gallery__thumb:focus-visible {
    outline: 2px solid #c41e1e;
    outline-offset: 2px;
  }

  .pb-gallery__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms ease;
  }

  .pb-gallery__thumb:hover .pb-gallery__thumb-img {
    transform: scale(1.05);
  }

  /* ===== PLACEHOLDER ===== */
  .pb-gallery__placeholder {
    aspect-ratio: 1 / 1;
    background: #262626;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.25);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ===== LIGHTBOX (dialog nativo) ===== */
  .pb-gallery__lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(10, 10, 10, 0.95);
    z-index: 100;
  }

  .pb-gallery__lightbox::backdrop {
    background: transparent;
  }

  .pb-gallery__lightbox[open] {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: pb-gallery-fade-in 200ms ease-out;
  }

  @keyframes pb-gallery-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Overlay: pointer-events none per far passare i click allo sfondo (dialog).
   * I figli interattivi (bottoni, img) li riabilitano. */
  .pb-gallery__overlay {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .pb-gallery__overlay > * {
    pointer-events: auto;
  }

  /* Immagine nel lightbox */
  .pb-gallery__lightbox-img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 4px;
    user-select: none;
  }

  /* Pulsante chiudi */
  .pb-gallery__close {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 10;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: background 200ms;
  }

  .pb-gallery__close:hover,
  .pb-gallery__close:focus-visible {
    background: rgba(255, 255, 255, 0.25);
  }

  /* Pulsanti prev / next */
  .pb-gallery__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: background 200ms;
  }

  .pb-gallery__nav:hover,
  .pb-gallery__nav:focus-visible {
    background: rgba(255, 255, 255, 0.25);
  }

  .pb-gallery__nav--prev { left: 16px; }
  .pb-gallery__nav--next { right: 16px; }

  /* Contatore "1 / 3" */
  .pb-gallery__counter {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.05em;
    z-index: 10;
  }

  /* ===== MOBILE ===== */
  @media (max-width: 639px) {
    .pb-gallery__close {
      top: 10px;
      right: 10px;
      width: 40px;
      height: 40px;
    }
    .pb-gallery__nav {
      width: 40px;
      height: 40px;
    }
    .pb-gallery__nav--prev { left: 8px; }
    .pb-gallery__nav--next { right: 8px; }
    .pb-gallery__lightbox-img {
      max-width: 95vw;
      max-height: 80vh;
    }
  }
</style>

<script>
  /**
   * Lightbox controller — inizializza ogni istanza di Gallery sulla pagina.
   * Script bundled da Astro: eseguito una sola volta, dopo il DOM ready.
   */
  document.querySelectorAll<HTMLElement>('.pb-gallery').forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>('.pb-gallery__lightbox');
    if (!dialog) return; // Gallery solo placeholder, niente lightbox

    const img = dialog.querySelector<HTMLImageElement>('.pb-gallery__lightbox-img');
    const closeBtn = dialog.querySelector<HTMLButtonElement>('.pb-gallery__close');
    const prevBtn = dialog.querySelector<HTMLButtonElement>('.pb-gallery__nav--prev');
    const nextBtn = dialog.querySelector<HTMLButtonElement>('.pb-gallery__nav--next');
    const counter = dialog.querySelector<HTMLElement>('.pb-gallery__counter');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('.pb-gallery__thumb');
    if (!img || !closeBtn) return;

    // Raccoglie src e alt dai thumbnail (già nel DOM)
    const sources: { src: string; alt: string }[] = [];
    thumbs.forEach((thumb) => {
      const thumbImg = thumb.querySelector('img');
      if (thumbImg) sources.push({ src: thumbImg.src, alt: thumbImg.alt });
    });

    let current = 0;

    function show(index: number) {
      current = ((index % sources.length) + sources.length) % sources.length;
      img!.src = sources[current].src;
      img!.alt = sources[current].alt;
      if (counter) counter.textContent = `${current + 1} / ${sources.length}`;
    }

    // Apre il lightbox sull'immagine cliccata
    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => {
        show(i);
        dialog!.showModal();
        document.body.style.overflow = 'hidden';
      });
    });

    // Chiusura: pulsante X
    closeBtn.addEventListener('click', () => dialog!.close());

    // Chiusura: click sullo sfondo (non sull'immagine o i bottoni).
    // mousedownTarget evita chiusure accidentali quando l'utente inizia
    // il click sull'immagine e rilascia sullo sfondo.
    let mousedownTarget: EventTarget | null = null;
    dialog.addEventListener('mousedown', (e) => { mousedownTarget = e.target; });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog && mousedownTarget === dialog) dialog.close();
    });

    // Ripristina lo scroll del body alla chiusura (Escape incluso)
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });

    // Navigazione con tastiera (← →)
    dialog.addEventListener('keydown', (e) => {
      if (sources.length <= 1) return;
      if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
    });

    // Navigazione con pulsanti prev / next
    prevBtn?.addEventListener('click', () => show(current - 1));
    nextBtn?.addEventListener('click', () => show(current + 1));
  });
</script>
