---
/**
 * Review Card — recensione con stelle, testo, autore e fonte.
 * Usa <figure> + <blockquote> + <cite> per semantica corretta.
 */

interface Props {
  stars?: number;
  text: string;
  author: string;
  source?: string;
}

const { stars = 5, text, author, source } = Astro.props;
---

<figure
  class="p-card-pad border border-pb-border-default rounded-md
         flex flex-col gap-4 m-0"
>
  <!-- Stelle — raggruppate in un unico elemento per gli screen reader -->
  <div
    role="img"
    aria-label={`Valutazione: ${stars} stelle su 5`}
    class="flex gap-[3px]"
  >
    {Array.from({ length: stars }).map(() => (
      <svg class="w-4 h-4 fill-brand" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    ))}
  </div>

  <!-- Testo della recensione -->
  <blockquote class="text-base text-pb-text-tertiary leading-normal italic flex-grow m-0">
    &ldquo;{text}&rdquo;
  </blockquote>

  <!-- Autore e fonte -->
  <figcaption>
    <cite class="not-italic text-sm font-semibold text-pb-text-secondary">{author}</cite>
    {source && <div class="text-xs text-pb-text-muted">{source}</div>}
  </figcaption>
</figure>
