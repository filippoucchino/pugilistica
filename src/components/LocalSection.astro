---
/**
 * Local Section — info sede + mappa Google.
 * Posizionata prima della CTA finale su tutte le pagine.
 * La mappa è gestita da MapFacade (pattern "facade" per evitare il caricamento
 * dell'iframe di Google al primo load).
 */
import MapFacade from "./MapFacade.astro";

interface Detail {
  icon: string;  // SVG inner HTML
  text: string;
}

interface ZoneInfo {
  name: string;
  description: string;
}

interface Props {
  address: string;
  addressLabel?: string;
  zones?: string[];
  zonesInfo?: ZoneInfo[];
  details?: Detail[];
  /** URL di embed Google Maps (src dell'iframe). */
  mapEmbedUrl?: string;
  /** Link "apri in Google Maps" per il fallback testuale sotto la mappa. */
  mapExternalUrl?: string;
  /** Link indicazioni stradali: apre Maps in modalità navigazione. */
  mapDirectionsUrl?: string;
  /** Immagine statica di preview usata dal facade. */
  mapPreviewSrc?: string;
  /** Etichetta usata negli aria-label/alt della mappa. */
  mapLabel?: string;
}

const {
  address,
  addressLabel = "Sede",
  zones = [],
  zonesInfo,
  details = [],
  mapEmbedUrl,
  mapExternalUrl,
  mapDirectionsUrl,
  mapPreviewSrc,
  mapLabel = "Pugilistica Brianza",
} = Astro.props;

const hasMap = Boolean(mapEmbedUrl && mapExternalUrl && mapDirectionsUrl && mapPreviewSrc);
const hasZonesInfo = zonesInfo && zonesInfo.length > 0;
const pillList = hasZonesInfo ? zonesInfo : zones.map((name) => ({ name, description: "" }));
---

<div class="grid grid-cols-local gap-12 items-start max-md:grid-cols-1">
  <!-- Info -->
  <div class="flex flex-col gap-5">
    <div class="text-base text-pb-text-secondary leading-relaxed">
      <strong class="text-pb-text-primary font-semibold block mb-1">{addressLabel}</strong>
      <span set:html={address} />
    </div>

    {pillList.length > 0 && (
      <div>
        <div class="flex gap-2 flex-wrap" id="zone-pills">
          {pillList.map((zone) => (
            hasZonesInfo ? (
              <button
                class="py-[5px] px-3.5 border border-pb-border-default rounded-full
                       text-xs text-pb-text-muted font-medium transition-colors duration-150
                       hover:border-brand hover:text-pb-text-primary
                       focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand
                       cursor-pointer"
                data-zone={zone.name}
                data-description={zone.description}
                aria-expanded="false"
                type="button"
              >
                {zone.name}
              </button>
            ) : (
              <span
                class="py-[5px] px-3.5 border border-pb-border-default rounded-full
                       text-xs text-pb-text-muted font-medium"
              >
                {zone.name}
              </span>
            )
          ))}
        </div>
        {hasZonesInfo && (
          <div
            id="zone-desc"
            aria-live="polite"
            class="overflow-hidden transition-all duration-200"
            style="max-height: 0;"
          >
            <p class="mt-3 text-sm text-pb-text-secondary leading-relaxed
                      border-l-2 border-brand pl-3" id="zone-desc-text"></p>
          </div>
        )}
      </div>
    )}

    {details.length > 0 && (
      <div class="flex flex-col gap-3">
        {details.map((detail) => (
          <div class="flex items-center gap-2.5 text-sm text-pb-text-tertiary">
            <svg
              class="w-4 h-4 stroke-brand fill-none flex-shrink-0"
              style="stroke-width: 1.5;"
              viewBox="0 0 24 24"
              set:html={detail.icon}
            />
            {detail.text}
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Map (facade pattern: iframe caricato solo al click) -->
  {hasMap ? (
    <MapFacade
      embedUrl={mapEmbedUrl!}
      externalUrl={mapExternalUrl!}
      directionsUrl={mapDirectionsUrl!}
      previewSrc={mapPreviewSrc!}
      label={mapLabel}
    />
  ) : (
    <div
      class="w-full aspect-[16/10] bg-neutral-800 rounded-lg flex items-center
             justify-center text-sm text-pb-text-faint tracking-wide
             border border-pb-border-default"
    >
      MAPPA GOOGLE
    </div>
  )}
</div>

<script is:inline>
  (function () {
    var pills = document.querySelectorAll("#zone-pills [data-zone]");
    var descBox = document.getElementById("zone-desc");
    var descText = document.getElementById("zone-desc-text");
    if (!pills.length || !descBox || !descText) return;

    var active = null;

    pills.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var isSame = active === btn;

        // Resetta tutti i bottoni
        pills.forEach(function (b) {
          b.classList.remove("border-brand", "text-pb-text-primary");
          b.setAttribute("aria-expanded", "false");
        });

        if (isSame) {
          // Chiudi
          active = null;
          descBox.style.maxHeight = "0";
        } else {
          // Apri con il testo della città selezionata
          active = btn;
          btn.classList.add("border-brand", "text-pb-text-primary");
          btn.setAttribute("aria-expanded", "true");
          descText.textContent = btn.getAttribute("data-description");
          descBox.style.maxHeight = descBox.scrollHeight + 120 + "px";
        }
      });
    });
  })();
</script>
