---
/**
 * Coach Block — card con foto, nome, ruolo, bio e tag.
 * La foto è opzionale: se presente, va passata come asset importato
 * (ES module) così Astro la ottimizza automaticamente (WebP, srcset).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  role: string;
  bio: string;
  tags: string[];
  /** Foto opzionale, importata come asset ES module (ottimizzata da Astro) */
  photo?: ImageMetadata;
  photoAlt?: string;
}

const { name, role, bio, tags, photo, photoAlt = "" } = Astro.props;
---

<div
  class="grid grid-cols-coach gap-10 items-center p-card-pad-lg
         bg-surface-card border border-pb-border-default rounded-md
         max-md:grid-cols-1"
>
  <!-- Photo -->
  {photo ? (
    <Image
      src={photo}
      alt={photoAlt}
      width={400}
      height={480}
      loading="lazy"
      decoding="async"
      class="w-[200px] h-[240px] object-cover rounded-md max-md:w-full max-md:h-[200px]"
    />
  ) : (
    <div
      class="w-[200px] h-[240px] bg-neutral-800 rounded-md flex items-center
             justify-center font-display text-[28px] text-pb-text-faint
             max-md:w-full max-md:h-[200px]"
    >
      FOTO
    </div>
  )}

  <!-- Info -->
  <div>
    <h3 class="font-display text-display-sm text-pb-text-primary mb-1">{name}</h3>
    <p class="text-sm text-brand font-semibold tracking-wide mb-4">{role}</p>
    <p class="text-base text-pb-text-tertiary leading-normal mb-5">{bio}</p>
    <div class="flex gap-2 flex-wrap">
      {tags.map((tag) => (
        <span
          class="py-[5px] px-3 border border-pb-border-default rounded-full
                 text-xxs font-semibold text-pb-text-muted tracking-wide"
        >
          {tag}
        </span>
      ))}
    </div>
  </div>
</div>
