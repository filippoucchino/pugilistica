---
/**
 * Schedule Table — tabella orari settimanali (Lun–Sab).
 * Desktop: griglia tabellare 6 colonne.
 * Mobile: vista per giorno con tab selector (Lun–Sab).
 */

import type { ScheduleRow, Activity } from "@/data/scheduleData";
import { WEEKDAYS_FULL, WEEKDAYS_SHORT } from "@/data/scheduleData";

interface Props {
  rows: ScheduleRow[];
}

const { rows } = Astro.props;

/* Trasposizione: per ogni giorno (0–5), calcola la lista ordinata di slot */
interface DaySlot {
  time: string;
  activities: readonly Activity[];
}

const daySchedule = WEEKDAYS_FULL.map((dayName, dayIdx) => {
  const slots: DaySlot[] = [];
  for (const row of rows) {
    let colIdx = 0;
    for (const cell of row.cells) {
      const span = cell.colspan ?? 1;
      if (colIdx <= dayIdx && dayIdx < colIdx + span) {
        if (cell.activities && cell.activities.length > 0) {
          slots.push({ time: row.time, activities: cell.activities });
        }
        break;
      }
      colIdx += span;
    }
  }
  return { dayName, dayShort: WEEKDAYS_SHORT[dayIdx], slots };
});
---

<!-- MOBILE: un box per giorno, governato dai tab Lun–Sab -->
<div class="pb-schedule-mobile">
  <div class="pb-schedule-mobile__tabs" role="group" aria-label="Seleziona il giorno">
    {daySchedule.map((day, i) => (
      <button
        type="button"
        class:list={["pb-schedule-mobile__tab", { "is-active": i === 0 }]}
        data-panel-idx={i}
        aria-pressed={i === 0 ? "true" : "false"}
      >
        {day.dayShort}
      </button>
    ))}
  </div>

  {daySchedule.map((day, i) => (
    <div
      class:list={["pb-schedule-mobile__panel", { "is-active": i === 0 }]}
      data-panel={i}
    >
      {day.slots.length === 0 ? (
        <div class="pb-schedule-mobile__empty">Nessun corso programmato</div>
      ) : (
        day.slots.map((slot) => (
          <div class="pb-schedule-mobile__row">
            <div class="pb-schedule-mobile__time">{slot.time}</div>
            <div class="pb-schedule-mobile__activities">
              {slot.activities.map((activity) => (
                <div
                  class="pb-schedule__slot pb-schedule-mobile__chip"
                  data-tags={activity.tags.join(" ")}
                  data-primary-tag={activity.tags[0]}
                >
                  <span class="pb-schedule__label">{activity.label}</span>
                  {activity.note && (
                    <small class="pb-schedule__note">{activity.note}</small>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      )}
    </div>
  ))}
</div>

<!-- DESKTOP: tabella Lun–Sab (nascosta su mobile) -->
<div class="pb-schedule">
  <table
    class="pb-schedule__table"
    aria-label="Orari dei corsi da lunedì a sabato"
  >
    <caption class="sr-only">
      Orari settimanali dei corsi di Pugilistica Brianza
    </caption>
    <thead>
      <tr>
        <th scope="col" class="pb-schedule__time-head">Orario</th>
        {WEEKDAYS_FULL.map((day, i) => (
          <th scope="col" abbr={WEEKDAYS_SHORT[i]}>
            <span class="hidden md:inline">{day}</span>
            <span class="md:hidden">{WEEKDAYS_SHORT[i]}</span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => {
        let dayIndex = 0;
        return (
          <tr>
            <th scope="row" class="pb-schedule__time">{row.time}</th>
            {row.cells.map((cell) => {
              const span = cell.colspan ?? 1;
              const dayStart = dayIndex;
              const dayEnd = dayIndex + span - 1;
              const dayLabel =
                span > 1
                  ? `${WEEKDAYS_SHORT[dayIndex]} – ${WEEKDAYS_SHORT[dayIndex + span - 1]}`
                  : WEEKDAYS_FULL[dayIndex];
              dayIndex += span;

              const activities = cell.activities ?? [];
              const isEmpty = activities.length === 0;
              return (
                <td
                  colspan={span === 1 ? undefined : span}
                  data-day={dayLabel}
                  data-day-start={dayStart}
                  data-day-end={dayEnd}
                  data-span={span}
                  class="pb-schedule__cell"
                >
                  <div class="pb-schedule__cell-inner">
                    {isEmpty ? (
                      <div
                        class="pb-schedule__slot pb-schedule__slot--empty"
                        data-tags="empty"
                        data-primary-tag="empty"
                      >
                        <span class="pb-schedule__empty" aria-label="Nessuna lezione">/</span>
                      </div>
                    ) : (
                      activities.map((activity) => (
                        <div
                          class="pb-schedule__slot"
                          data-tags={activity.tags.join(" ")}
                          data-primary-tag={activity.tags[0]}
                        >
                          <span class="pb-schedule__label">{activity.label}</span>
                          {activity.note && (
                            <small class="pb-schedule__note">{activity.note}</small>
                          )}
                        </div>
                      ))
                    )}
                  </div>
                </td>
              );
            })}
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<style>
  /* ================================================
     MOBILE DAY-PANEL VIEW (nascosta di default)
     ================================================ */
  .pb-schedule-mobile {
    display: none;
  }

  /* ================================================
     DESKTOP TABLE VIEW
     ================================================ */
  .pb-schedule {
    display: block;
  }

  .pb-schedule__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 6px;
    table-layout: fixed;
  }

  /* Header (giorni) */
  .pb-schedule__table thead th {
    font-family: "Bebas Neue", Impact, sans-serif;
    font-size: 18px;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    padding: 14px 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    text-align: center;
    font-weight: 400;
  }

  /* Colonna orario */
  .pb-schedule__time-head {
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif !important;
    font-size: 13px !important;
    text-transform: uppercase;
    letter-spacing: 0.15em !important;
    color: rgba(255, 255, 255, 0.55) !important;
    background: transparent !important;
    border: none !important;
    font-weight: 600 !important;
  }

  .pb-schedule__time {
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #c41e1e;
    text-align: right;
    padding: 12px 16px 12px 0;
    white-space: nowrap;
    letter-spacing: 0.02em;
    width: 130px;
  }

  .pb-schedule__cell {
    padding: 0;
    background: transparent;
    border: none;
    vertical-align: middle;
  }

  .pb-schedule__cell-inner {
    display: flex;
    align-items: stretch;
    gap: 4px;
    width: 100%;
  }

  /* Slot: pillola visiva — condivisa tra tabella desktop e chip mobile */
  .pb-schedule__slot {
    flex: 1 1 0;
    min-width: 0;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 12px 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition:
      border-color 300ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .pb-schedule__slot:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .pb-schedule__label {
    display: block;
    font-family: "Bebas Neue", Impact, sans-serif;
    font-size: 15px;
    letter-spacing: 0.04em;
    line-height: 1.2;
    color: #ffffff;
    text-transform: uppercase;
  }

  .pb-schedule__note {
    display: block;
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 2px;
    letter-spacing: 0.02em;
  }

  .pb-schedule__empty {
    color: rgba(255, 255, 255, 0.25);
    font-size: 18px;
  }

  /* Colori per tipo di corso */
  .pb-schedule__slot[data-primary-tag="open-gym"] {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .pb-schedule__slot[data-primary-tag="boxe"] {
    border-color: rgba(196, 30, 30, 0.35);
  }
  .pb-schedule__slot[data-primary-tag="boxe-agonisti"] {
    border-color: rgba(196, 30, 30, 0.5);
    background: rgba(196, 30, 30, 0.05);
  }
  .pb-schedule__slot[data-primary-tag="kids-boxe"] {
    border-color: rgba(234, 179, 8, 0.4);
  }
  .pb-schedule__slot[data-primary-tag="hyrox"] {
    border-color: rgba(59, 130, 246, 0.4);
  }
  .pb-schedule__slot[data-primary-tag="pb-hiit"] {
    border-color: rgba(168, 85, 247, 0.4);
  }
  .pb-schedule__slot[data-primary-tag="empty"] {
    background: transparent;
    border-style: dashed;
    border-color: rgba(255, 255, 255, 0.08);
  }

  /* Filtro corso: desktop attenuato, mobile nascosto (vedi @media) */
  .pb-schedule__slot.is-filtered-out {
    opacity: 0.15;
    pointer-events: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ================================================
     MOBILE (<768px): pannelli per giorno
     ================================================ */
  @media (max-width: 767px) {
    /* Mostra mobile, nascondi tabella desktop */
    .pb-schedule-mobile {
      display: block;
    }
    .pb-schedule {
      display: none;
    }

    /* Filtro corso su mobile: nascondi invece di attenuare */
    .pb-schedule__slot.is-filtered-out {
      display: none;
    }

    /* ---- Tab giorni ---- */
    .pb-schedule-mobile__tabs {
      display: flex;
      flex-wrap: nowrap;
      gap: 6px;
      padding: 6px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px 12px 0 0;
    }

    .pb-schedule-mobile__tab {
      flex: 1;
      padding: 10px 4px;
      border: 1px solid transparent;
      border-radius: 8px;
      background: transparent;
      color: rgba(255, 255, 255, 0.45);
      font-family: "Bebas Neue", Impact, sans-serif;
      font-size: 16px;
      letter-spacing: 0.06em;
      cursor: pointer;
      text-align: center;
      transition: background 200ms, border-color 200ms, color 200ms;
    }

    .pb-schedule-mobile__tab.is-active {
      background: rgba(196, 30, 30, 0.15);
      border-color: rgba(196, 30, 30, 0.5);
      color: #ffffff;
    }

    /* ---- Pannelli giorno ---- */
    .pb-schedule-mobile__panel {
      display: none;
      padding: 0 16px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-top: none;
      border-radius: 0 0 12px 12px;
    }

    .pb-schedule-mobile__panel.is-active {
      display: block;
    }

    /* ---- Riga orario + chip ---- */
    .pb-schedule-mobile__row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .pb-schedule-mobile__row:last-child {
      border-bottom: none;
    }

    /* Nascondi riga quando tutti i chip sono filtrati */
    .pb-schedule-mobile__row:not(:has(.pb-schedule__slot:not(.is-filtered-out))) {
      display: none;
    }

    .pb-schedule-mobile__time {
      font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: #c41e1e;
      white-space: nowrap;
      flex-shrink: 0;
      min-width: 115px;
      letter-spacing: 0.02em;
    }

    .pb-schedule-mobile__activities {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      flex: 1;
    }

    /* Chip: ridimensionati per la vista mobile */
    .pb-schedule-mobile__chip {
      flex: 0 1 auto;
      padding: 6px 12px;
    }

    .pb-schedule-mobile__empty {
      text-align: center;
      padding: 28px 0;
      color: rgba(255, 255, 255, 0.35);
      font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
      font-size: 14px;
    }
  }
</style>

<script>
  (function () {
    const mobileSched = document.querySelector(".pb-schedule-mobile");
    if (!mobileSched) return;

    const tabs = Array.from(
      mobileSched.querySelectorAll(".pb-schedule-mobile__tab"),
    );
    const panels = Array.from(
      mobileSched.querySelectorAll(".pb-schedule-mobile__panel"),
    );

    function showPanel(idx: number) {
      tabs.forEach((tab, i) => {
        tab.classList.toggle("is-active", i === idx);
        tab.setAttribute("aria-pressed", i === idx ? "true" : "false");
      });
      panels.forEach((panel, i) => {
        panel.classList.toggle("is-active", i === idx);
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => showPanel(i));
    });
  })();
</script>
