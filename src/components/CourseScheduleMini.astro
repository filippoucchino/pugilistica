---
/**
 * Mini tabella orari filtrata per corso.
 * Desktop: tabella Lun–Sab con solo le attività del corso.
 * Mobile: vista per giorno con tab selector (Lun–Sab).
 */

import type { ActivityTag } from "@/data/scheduleData";
import { schedule, WEEKDAYS_SHORT, WEEKDAYS_FULL } from "@/data/scheduleData";

interface Props {
  tags: ActivityTag[];
  caption: string;
}

const { tags, caption } = Astro.props as Props;

interface MiniActivity {
  label: string;
  tag: ActivityTag;
  note?: string;
}

interface MiniRow {
  time: string;
  cells: MiniActivity[][];
}

/* Costruisce le righe desktop: ogni riga ha 6 celle (una per giorno) */
const rows: MiniRow[] = [];

for (const row of schedule) {
  let dayIdx = 0;
  const cells: MiniActivity[][] = [[], [], [], [], [], []];
  let hasMatch = false;

  for (const cell of row.cells) {
    const span = cell.colspan ?? 1;
    if (cell.activities) {
      const matched: MiniActivity[] = cell.activities
        .filter((a) => a.tags.some((t) => tags.includes(t)))
        .map((a) => ({ label: a.label, tag: a.tags[0], note: a.note }));
      if (matched.length > 0) {
        hasMatch = true;
        for (let i = 0; i < span; i++) {
          cells[dayIdx + i] = matched;
        }
      }
    }
    dayIdx += span;
  }

  if (hasMatch) {
    rows.push({ time: row.time, cells });
  }
}

/* Trasposizione per la vista mobile: per ogni giorno, lista di slot con attività */
const daySchedule = WEEKDAYS_FULL.map((dayName, dayIdx) => {
  const slots = rows
    .filter((row) => row.cells[dayIdx].length > 0)
    .map((row) => ({ time: row.time, activities: row.cells[dayIdx] }));
  return { dayName, dayShort: WEEKDAYS_SHORT[dayIdx], slots };
});
---

<!-- MOBILE: un box per giorno, governato dai tab Lun–Sab -->
<div class="mini-sched-mobile">
  <div class="mini-sched-mobile__tabs" role="group" aria-label="Seleziona il giorno">
    {daySchedule.map((day, i) => (
      <button
        type="button"
        class:list={["mini-sched-mobile__tab", { "is-active": i === 0 }]}
        data-panel-idx={i}
        aria-pressed={i === 0 ? "true" : "false"}
      >
        {day.dayShort}
      </button>
    ))}
  </div>

  {daySchedule.map((day, i) => (
    <div
      class:list={["mini-sched-mobile__panel", { "is-active": i === 0 }]}
      data-panel={i}
    >
      {day.slots.length === 0 ? (
        <div class="mini-sched-mobile__empty">Nessun corso programmato</div>
      ) : (
        day.slots.map((slot) => (
          <div class="mini-sched-mobile__row">
            <div class="mini-sched-mobile__time">{slot.time}</div>
            <div class="mini-sched-mobile__activities">
              {slot.activities.map((a) => (
                <span class="mini-sched__activity" data-tag={a.tag}>
                  {a.label}
                  {a.note && <small class="mini-sched__note">{a.note}</small>}
                </span>
              ))}
            </div>
          </div>
        ))
      )}
    </div>
  ))}
</div>

<!-- DESKTOP: tabella filtrata (nascosta su mobile) -->
<div class="mini-sched">
  <table class="mini-sched__table" aria-label={caption}>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="mini-sched__th-time">Orario</th>
        {WEEKDAYS_FULL.map((day, i) => (
          <th scope="col" class="mini-sched__th-day">
            <span class="mini-sched__day-full">{day}</span>
            <span class="mini-sched__day-short">{WEEKDAYS_SHORT[i]}</span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row" class="mini-sched__time">{row.time}</th>
          {row.cells.map((acts, i) => (
            <td
              data-day={WEEKDAYS_FULL[i]}
              class:list={[
                "mini-sched__cell",
                acts.length === 0 && "mini-sched__cell--empty",
              ]}
              data-tag={acts.length > 0 ? acts[0].tag : "empty"}
            >
              {acts.length === 0 ? (
                <span class="mini-sched__dash" aria-label="Nessuna lezione">&mdash;</span>
              ) : (
                acts.map((a) => (
                  <span class="mini-sched__activity" data-tag={a.tag}>
                    {a.label}
                    {a.note && <small class="mini-sched__note">{a.note}</small>}
                  </span>
                ))
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p class="mini-sched__footer">
  <a href="/orari/" class="pb-btn-text">Vedi tutti gli orari e i corsi &rarr;</a>
</p>

<style>
  /* ===== MOBILE DAY-PANEL VIEW (nascosta di default) ===== */
  .mini-sched-mobile {
    display: none;
    margin-top: 2.5rem;
  }

  /* ===== DESKTOP TABLE VIEW ===== */
  .mini-sched {
    margin-top: 2.5rem;
  }

  .mini-sched__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 4px;
    table-layout: fixed;
  }

  .mini-sched__th-day {
    font-family: "Bebas Neue", Impact, sans-serif;
    font-size: 15px;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    padding: 10px 4px;
    text-align: center;
    font-weight: 400;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
  }

  .mini-sched__day-short {
    display: none;
  }

  .mini-sched__th-time {
    background: transparent;
    color: rgba(255, 255, 255, 0.4);
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    font-weight: 600;
    text-transform: uppercase;
    text-align: right;
    padding: 10px 10px 10px 0;
  }

  .mini-sched__time {
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #c41e1e;
    text-align: right;
    padding: 10px 10px 10px 0;
    white-space: nowrap;
    width: 100px;
  }

  .mini-sched__cell {
    text-align: center;
    padding: 10px 4px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    vertical-align: middle;
  }

  .mini-sched__cell--empty {
    background: transparent;
    border-color: transparent;
  }

  .mini-sched__cell[data-tag="boxe"]          { border-color: rgba(196, 30, 30, 0.35); }
  .mini-sched__cell[data-tag="boxe-agonisti"] { border-color: rgba(196, 30, 30, 0.5); background: rgba(196, 30, 30, 0.04); }
  .mini-sched__cell[data-tag="kids-boxe"]     { border-color: rgba(234, 179, 8, 0.35); }
  .mini-sched__cell[data-tag="hyrox"]         { border-color: rgba(59, 130, 246, 0.35); }
  .mini-sched__cell[data-tag="pb-hiit"]       { border-color: rgba(168, 85, 247, 0.35); }

  .mini-sched__activity {
    display: block;
    font-family: "Bebas Neue", Impact, sans-serif;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: #ffffff;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .mini-sched__note {
    display: block;
    font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    text-transform: none;
    letter-spacing: 0.02em;
    margin-top: 1px;
  }

  .mini-sched__dash {
    color: rgba(255, 255, 255, 0.15);
    font-size: 14px;
  }

  .mini-sched__footer {
    text-align: center;
    margin-top: 1.25rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ===== TABLET: abbrevia i nomi dei giorni ===== */
  @media (max-width: 1023px) {
    .mini-sched__day-full  { display: none; }
    .mini-sched__day-short { display: inline; }
  }

  /* ===== MOBILE (<768px): pannelli per giorno ===== */
  @media (max-width: 767px) {
    /* Mostra mobile, nascondi tabella desktop */
    .mini-sched-mobile { display: block; }
    .mini-sched        { display: none; }

    /* ---- Tab giorni ---- */
    .mini-sched-mobile__tabs {
      display: flex;
      flex-wrap: nowrap;
      gap: 6px;
      padding: 6px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px 12px 0 0;
    }

    .mini-sched-mobile__tab {
      flex: 1;
      padding: 10px 4px;
      border: 1px solid transparent;
      border-radius: 8px;
      background: transparent;
      color: rgba(255, 255, 255, 0.45);
      font-family: "Bebas Neue", Impact, sans-serif;
      font-size: 16px;
      letter-spacing: 0.06em;
      cursor: pointer;
      text-align: center;
      transition: background 200ms, border-color 200ms, color 200ms;
    }

    .mini-sched-mobile__tab.is-active {
      background: rgba(196, 30, 30, 0.15);
      border-color: rgba(196, 30, 30, 0.5);
      color: #ffffff;
    }

    /* ---- Pannelli giorno ---- */
    .mini-sched-mobile__panel {
      display: none;
      padding: 0 16px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-top: none;
      border-radius: 0 0 12px 12px;
    }

    .mini-sched-mobile__panel.is-active {
      display: block;
    }

    /* ---- Riga orario + attività ---- */
    .mini-sched-mobile__row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .mini-sched-mobile__row:last-child {
      border-bottom: none;
    }

    .mini-sched-mobile__time {
      font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: #c41e1e;
      white-space: nowrap;
      flex-shrink: 0;
      min-width: 115px;
      letter-spacing: 0.02em;
    }

    .mini-sched-mobile__activities {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      flex: 1;
    }

    /* Chip attività: riusa .mini-sched__activity con dimensioni compatte */
    .mini-sched-mobile__activities .mini-sched__activity {
      display: inline-block;
      padding: 5px 10px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.03);
      font-size: 13px;
    }

    .mini-sched-mobile__activities .mini-sched__activity[data-tag="boxe"]          { border-color: rgba(196, 30, 30, 0.4); }
    .mini-sched-mobile__activities .mini-sched__activity[data-tag="boxe-agonisti"] { border-color: rgba(196, 30, 30, 0.6); background: rgba(196, 30, 30, 0.06); }
    .mini-sched-mobile__activities .mini-sched__activity[data-tag="kids-boxe"]     { border-color: rgba(234, 179, 8, 0.4); }
    .mini-sched-mobile__activities .mini-sched__activity[data-tag="hyrox"]         { border-color: rgba(59, 130, 246, 0.4); }
    .mini-sched-mobile__activities .mini-sched__activity[data-tag="pb-hiit"]       { border-color: rgba(168, 85, 247, 0.4); }

    .mini-sched-mobile__empty {
      text-align: center;
      padding: 28px 0;
      color: rgba(255, 255, 255, 0.35);
      font-family: "Barlow", "Helvetica Neue", Arial, sans-serif;
      font-size: 14px;
    }
  }
</style>

<script>
  (function () {
    const mobileSched = document.querySelector(".mini-sched-mobile");
    if (!mobileSched) return;

    const tabs = Array.from(
      mobileSched.querySelectorAll(".mini-sched-mobile__tab"),
    );
    const panels = Array.from(
      mobileSched.querySelectorAll(".mini-sched-mobile__panel"),
    );

    function showPanel(idx: number) {
      tabs.forEach((tab, i) => {
        tab.classList.toggle("is-active", i === idx);
        tab.setAttribute("aria-pressed", i === idx ? "true" : "false");
      });
      panels.forEach((panel, i) => {
        panel.classList.toggle("is-active", i === idx);
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => showPanel(i));
    });
  })();
</script>
