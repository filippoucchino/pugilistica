---
/**
 * WhyUs Card — icona + titolo + descrizione in layout orizzontale.
 * Usata nelle sezioni "Perché scegliere [X]" delle pagine servizio.
 */

interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<li class="flex gap-4 items-start p-card-pad">
  <div
    class="w-11 h-11 border border-pb-border-accent rounded-md
           flex items-center justify-center flex-shrink-0"
  >
    <svg
      class="w-5 h-5 stroke-brand fill-none"
      style="stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;"
      viewBox="0 0 24 24"
      set:html={icon}
    />
  </div>
  <div>
    <p class="font-display text-display-sm text-pb-text-primary mb-1">{title}</p>
    <p class="text-sm text-pb-text-tertiary leading-normal">{description}</p>
  </div>
</li>
