# ============================================================
# .htaccess — Configurazione Apache per Aruba (sito statico Astro)
# Astro copia questo file in dist/ al build.
# ============================================================

# --- Routing pagine statiche Astro ---
# Astro genera cartelle con index.html (es. /pugilato/ → /pugilato/index.html).
# Queste regole servono perché Apache non fa questa risoluzione automaticamente.

RewriteEngine On

# Se il file richiesto esiste già, servilo direttamente
RewriteCond %{REQUEST_FILENAME} !-f

# Se la cartella richiesta esiste già, servila direttamente
RewriteCond %{REQUEST_FILENAME} !-d

# Riscrivi solo se il file di destinazione esiste davvero (evita loop infinito → 500)
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f

# Altrimenti cerca index.html dentro la cartella richiesta
RewriteRule ^(.*)$ /$1/index.html [L]

# --- Pagina di errore 404 personalizzata ---
ErrorDocument 404 /404.html

# --- Cache per risorse statiche ---
# ExpiresByType: il browser riusa le risorse dalla cache locale
# senza richiederle al server ad ogni visita.
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML: nessuna cache (contenuti sempre aggiornati ad ogni deploy)
  ExpiresByType text/html "access plus 0 seconds"
  # CSS e JS: Astro genera nomi con hash (es. chi-siamo.B4ETfhQf.css)
  # → se il contenuto cambia, cambia il nome file → cache lunga sicura
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Font woff2: file statici self-hosted, non cambiano
  ExpiresByType font/woff2 "access plus 1 year"
  # Immagini: cache 1 mese (sicuro anche per file senza hash come poster e favicon)
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  # Video: cache 1 mese
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  # Manifest PWA e sitemap
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# --- Header di sicurezza HTTP ---

# Impedisce al browser di interpretare un file come tipo diverso da quello dichiarato
Header set X-Content-Type-Options "nosniff"

# Impedisce ad altri siti di incorniciare le nostre pagine in un iframe (anti-clickjacking)
Header set X-Frame-Options "DENY"

# Limita le informazioni inviate ai siti esterni quando il visitatore clicca un link
Header set Referrer-Policy "strict-origin-when-cross-origin"

# Disabilita API del browser non usate (camera, microfono, geolocalizzazione, pagamenti)
Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

# Forza HTTPS: il browser ricorda di usare sempre HTTPS per 2 anni
Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

# Content Security Policy: definisce esattamente quali risorse il browser puo caricare
# - script-src: script locali + inline (Astro is:inline) + GTM + GA4 + Clarity
# - style-src: stili locali + inline (Tailwind)
# - font-src: solo locali (font self-hosted in /fonts/)
# - connect-src: Web3Forms (form), GA4 (collect endpoints), Clarity (collect endpoints)
# - frame-src: Google Maps (iframe embed) + GTM (noscript fallback iframe)
# - img-src: locali + data URI + tracking pixel (GTM, GA4, Clarity)
# - media-src: video locali (public/videos/)
# - object-src none: blocca Flash/Java
# - frame-ancestors none: rinforzo anti-iframe
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.clarity.ms; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.clarity.ms; connect-src 'self' https://api.web3forms.com https://www.google-analytics.com https://*.analytics.google.com https://*.google-analytics.com https://*.clarity.ms; frame-src https://www.google.com https://www.googletagmanager.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'"
